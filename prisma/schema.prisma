// Prisma schema — ERP Grasas y Lubricantes
// Módulos: Catálogo, Inventario (kardex), Producción (2 etapas), Comercial, Usuarios
//
// Principios:
// - La historia nunca se edita ni se borra: kardex, facturas, cobros y comisiones
//   solo se compensan con movimientos/documentos nuevos (ajustes, notas de crédito).
// - Toda regularización guarda quién/cuándo/por qué (usuarioId, usuarioNombre, motivo).
// - Campos semilla para el futuro: empresaId, moneda, pais.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ---------------------------------------------------------------------------
// CONFIGURACION DE EMPRESA (equivalente a Company Maintenance de Epicor):
// datos fiscales que aparecen en los documentos y parámetros como la tasa IGV.
// ---------------------------------------------------------------------------

model ConfiguracionEmpresa {
  id                              String    @id @default("1")
  razonSocial                     String    @default("Mi Empresa S.A.C.")
  nombreComercial                 String?
  ruc                             String?
  direccion                       String?
  direccion2                      String?
  ciudad                          String?
  distrito                        String?
  provincia                       String?
  departamento                    String?
  codigoPostal                    String?
  pais                            String    @default("Perú")
  telefono                        String?
  fax                             String?
  email                           String?
  sitioWeb                        String?
  moneda                          String    @default("PEN")
  tasaIgv                         Decimal   @default(18) // % aplicado al facturar
  // Fabricar/comercializar lubricantes en Perú exige inscripción en el
  // Registro de Hidrocarburos de OSINERGMIN (categoría OPDH — Otros
  // Productos Derivados de Hidrocarburos). Referencia informativa; no
  // bloquea ninguna operación.
  registroHidrocarburosOsinergmin String?
  registroHidrocarburosVigencia   DateTime?
  // % mensual sobre el saldo vencido. 0 = no se cobra recargo por mora
  // (default: no cambia el comportamiento hasta que el usuario lo configure).
  tasaRecargoMora                 Decimal   @default(0)
  tarifaHoraManoObra              Decimal   @default(0) // S/ por hora, usado al costear lotes y envasados
  // Aprobación por monto (0 = todo requiere aprobación siempre; un número muy
  // alto equivale a desactivar el control). Las aprueba Gerencia o un Admin.
  montoAprobacionCompras          Decimal   @default(5000)
  montoAprobacionPagos            Decimal   @default(5000)
  // Tasas para la cascada de financiamiento en Proyecciones → Finanzas
  // (mismo orden que un modelo de tesorería típico: lo más barato/disponible primero).
  tasaDescuentoCxC                Decimal   @default(9) // % (misma convención que tasaIgv: número entero, no fracción)
  tasaCreditoCortoPlazo           Decimal   @default(9)
  limiteCreditoCortoPlazo         Decimal   @default(100000)
  tasaCreditoLargoPlazo           Decimal   @default(10)
  // Facturación electrónica SUNAT vía OSE (Operador de Servicios Electrónicos).
  // "SIMULADO" = no envía nada real, solo prueba el flujo interno (estado por
  // defecto: nadie debe recibir CDR falsos por accidente antes de contratar
  // un OSE de verdad). oseToken se guarda en texto plano a propósito: es un
  // token de servicio para llamadas salientes, no una contraseña de usuario.
  oseProveedor                    String    @default("SIMULADO")
  oseToken                        String?
  // Comunicación directa a SUNAT (SEE - Del Contribuyente, oseProveedor =
  // "SUNAT_DIRECTO"): certificado digital de la empresa (.pfx/.p12 en
  // base64) + credenciales de usuario secundario SOL. Sin esto configurado,
  // el adaptador directo no puede firmar ni autenticar nada — no hay
  // fallback simulado para este proveedor (a diferencia de "SIMULADO").
  sunatCertificadoBase64          String?
  sunatCertificadoPassword        String?
  sunatUsuarioSol                 String?
  sunatClaveSol                   String?
  actualizadoEn                   DateTime  @updatedAt

  @@map("configuracion_empresa")
}

// Cuentas para el pie de página "Sírvase abonar en nuestras cuentas" de
// Factura/Nota de Crédito — una empresa real tiene varias (una por banco).
model CuentaBancariaEmpresa {
  id           String  @id @default(cuid())
  empresaId    String  @default("1")
  banco        String
  moneda       String  @default("PEN")
  numeroCuenta String
  cci          String?
  activo       Boolean @default(true)

  movimientosCaja MovimientoCaja[]
  conciliaciones  ConciliacionBancaria[]

  @@index([empresaId, numeroCuenta])
  @@map("cuentas_bancarias_empresa")
}

// ---------------------------------------------------------------------------
// USUARIOS Y SESIONES
// ---------------------------------------------------------------------------

enum RolUsuario {
  ADMIN
  ALMACEN
  PRODUCCION
  VENTAS
  GERENCIA
}

// Aprobación por monto: NO_REQUERIDA cuando el documento está por debajo del
// umbral configurado (se comporta exactamente igual que antes de este
// control); PENDIENTE bloquea el siguiente paso (recepción / pago) hasta
// que Gerencia o un Administrador la resuelva.
enum EstadoAprobacion {
  NO_REQUERIDA
  PENDIENTE
  APROBADA
  RECHAZADA
}

model Usuario {
  id                     String     @id @default(cuid())
  empresaId              String     @default("1")
  nombre                 String
  usuario                String // nombre de acceso
  passwordHash           String
  rol                    RolUsuario
  grupoSeguridadId       String?
  activo                 Boolean    @default(true)
  intentosFallidos       Int        @default(0)
  ultimoIntentoFallidoEn DateTime?
  bloqueadoHasta         DateTime?
  creadoEn               DateTime   @default(now())

  grupoSeguridad GrupoSeguridad? @relation(fields: [grupoSeguridadId], references: [id])
  sesiones       Sesion[]
  empleado       Empleado?

  @@unique([empresaId, usuario])
  @@map("usuarios")
}

model Sesion {
  id        String   @id @default(cuid())
  token     String   @unique
  usuarioId String
  expiraEn  DateTime
  creadoEn  DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@map("sesiones")
}

enum AccionAuditoriaMaestro {
  CREAR
  ACTUALIZAR
  ACTIVAR
  DESACTIVAR
  ELIMINAR
}

model AuditoriaMaestro {
  id             String                 @id @default(cuid())
  empresaId      String                 @default("1")
  entidad        String
  registroId     String
  accion         AccionAuditoriaMaestro
  valoresAntes   String?
  valoresDespues String?
  usuarioId      String
  usuarioNombre  String
  creadoEn       DateTime               @default(now())

  @@index([empresaId, entidad, registroId, creadoEn])
  @@index([usuarioId, creadoEn])
  @@map("auditoria_maestros")
}

// ---------------------------------------------------------------------------
// CATALOGO
// ---------------------------------------------------------------------------

model Categoria {
  id          String   @id @default(cuid())
  empresaId   String   @default("1")
  nombre      String
  descripcion String?
  activo      Boolean  @default(true)
  creadoEn    DateTime @default(now())

  productos Producto[]

  @@unique([empresaId, nombre])
  @@map("categorias")
}

// Segmento de negocio al que apunta comercialmente el producto (así organiza
// su catálogo la competencia del rubro, ej. Vistony: automotriz/industrial/
// minero/agrícola). No sustituye a Categoria (línea de producto interna).
enum SegmentoMercado {
  AUTOMOTRIZ
  INDUSTRIAL
  MINERO
  AGRICOLA
  MARINO
  OTRO
}

model Producto {
  id               String           @id @default(cuid())
  empresaId        String           @default("1")
  categoriaId      String
  codigo           String
  nombre           String
  descripcion      String?
  unidadMedidaBase String           @default("kg") // UM en que se produce y controla el granel
  segmentoMercado  SegmentoMercado?
  marca            String?
  gradoNlgi        String? // grasas: NLGI 000..6
  viscosidad       String? // aceites: ISO VG / SAE
  vidaUtilMeses    Int? // vida útil desde el envasado; null = no vence / no se controla
  // Enlaces a los documentos que un cliente industrial/distribuidor pide antes
  // de comprar (alojados fuera del sistema: Drive, S3, etc. — no hay
  // almacenamiento de archivos en esta app). null = no cargado todavía.
  fichaTecnicaUrl  String?
  hojaSeguridadUrl String?
  notasTecnicas    String?
  activo           Boolean          @default(true)
  creadoEn         DateTime         @default(now())
  actualizadoEn    DateTime         @updatedAt

  categoria        Categoria               @relation(fields: [categoriaId], references: [id])
  presentaciones   Presentacion[]
  formulas         Formula[]
  planesInspeccion PlanInspeccionCalidad[]

  @@unique([empresaId, codigo])
  @@map("productos")
}

model Presentacion {
  id                String   @id @default(cuid())
  empresaId         String   @default("1")
  productoId        String
  sku               String
  nombre            String
  contenidoKg       Decimal
  // Informativo para aceites/líquidos que se cotizan por volumen (litro,
  // galón) en vez de por peso — el costeo de producción sigue en kg
  // (contenidoKg), esto solo cambia cómo se muestra/imprime la presentación.
  contenidoLitros   Decimal?
  // Código de Catálogo 03 de SUNAT (NIU=unidad, KGM=kilogramo, GLL=galón,
  // LTR=litro, etc.) — usado al armar el ítem del comprobante electrónico.
  // Default NIU porque es el código genérico más seguro si no se configura.
  unidadMedidaSunat String   @default("NIU")
  precio            Decimal
  moneda            String   @default("PEN")
  stock             Decimal  @default(0)
  // Comprometido en pedidos PENDIENTE (aún no facturados). "Disponible para
  // vender" = stock - stockReservado. Se libera al facturar (pasa a ser
  // salida real de kardex) o al anular el pedido.
  stockReservado    Decimal  @default(0)
  stockMinimo       Decimal  @default(0)
  costoPromedio     Decimal  @default(0) // costo unitario promedio ponderado (se actualiza al envasar)
  codigoBarras      String? // EAN-13
  pesoBrutoKg       Decimal? // contenido + envase
  unidadesPorCaja   Int?
  zonaAlmacenId     String? // ubicación estructurada (Almacen > ZonaAlmacen)
  activo            Boolean  @default(true)
  creadoEn          DateTime @default(now())
  actualizadoEn     DateTime @updatedAt

  producto           Producto                  @relation(fields: [productoId], references: [id])
  zonaAlmacen        ZonaAlmacen?              @relation(fields: [zonaAlmacenId], references: [id])
  movimientos        MovimientoKardex[]
  saldosAlmacen      SaldoAlmacen[]
  envasados          Envasado[]
  pedidoDetalles     PedidoDetalle[]
  facturaDetalles    FacturaDetalle[]
  guiaDetalles       GuiaRemisionDetalle[]
  proyeccionDetalles ProyeccionDetalle[]
  escalonesPrecio    EscalonPrecio[]
  conteoDetalles     ConteoInventarioDetalle[]
  cotizacionDetalles CotizacionDetalle[]

  @@unique([empresaId, sku])
  @@map("presentaciones")
}

// Precio por volumen: a partir de cantidadMinima unidades en una misma línea
// de pedido, se sugiere este precio en vez del precio base de la
// Presentación. Se aplica el escalón más alto que la cantidad alcance.
model EscalonPrecio {
  id             String  @id @default(cuid())
  presentacionId String
  cantidadMinima Int
  precio         Decimal

  presentacion Presentacion @relation(fields: [presentacionId], references: [id])

  @@unique([presentacionId, cantidadMinima])
  @@map("escalones_precio")
}

model Proveedor {
  id                  String              @id @default(cuid())
  empresaId           String              @default("1")
  razonSocial         String
  ruc                 String?
  tipoDocumentoFiscal TipoDocumentoFiscal @default(RUC)
  pais                String              @default("Peru")
  telefono            String?
  email               String?
  direccion           String?
  contactoNombre      String?
  contactoTelefono    String?
  cuentaBancaria      String? // texto libre heredado; para pagos nuevos usar los campos estructurados de abajo
  // Datos bancarios estructurados — swift/iban para transferencias
  // internacionales, banco/numeroCuenta/cci para pagos domésticos en Perú.
  banco               String?
  numeroCuenta        String?
  cci                 String?
  swift               String?
  iban                String?
  condicionPagoDias   Int                 @default(0) // 0 = contado
  notas               String?
  activo              Boolean             @default(true)
  creadoEn            DateTime            @default(now())

  insumos           Insumo[]
  ordenesCompra     OrdenCompra[]
  cuentasPorPagar   CuentaPorPagar[]
  creditosProveedor CreditoProveedor[]

  @@unique([empresaId, ruc])
  @@map("proveedores")
}

enum TipoInsumo {
  MATERIA_PRIMA
  ENVASE
  ETIQUETA
}

model Insumo {
  id                 String     @id @default(cuid())
  empresaId          String     @default("1")
  proveedorId        String?
  codigo             String
  nombre             String
  tipo               TipoInsumo
  unidadMedida       String
  // Envases retornables (ej. tambor metálico de 55 gal): el cliente paga un
  // depósito y lo recupera al devolver el casco vacío. Solo aplica cuando
  // tipo = ENVASE. El control de cascos pendientes por cliente es manual por
  // ahora (no hay todavía un módulo de seguimiento automático).
  esRetornable       Boolean    @default(false)
  montoDeposito      Decimal?
  stock              Decimal    @default(0)
  stockMinimo        Decimal    @default(0)
  costoUnitario      Decimal    @default(0)
  moneda             String     @default("PEN")
  codigoProveedor    String? // código del artículo en el catálogo del proveedor
  zonaAlmacenId      String? // ubicación estructurada (Almacen > ZonaAlmacen)
  notas              String?
  requiereInspeccion Boolean    @default(false) // si true, cada recepción queda pendiente de calidad antes de sumar stock
  // Catálogo formal de sustancia peligrosa (EHS): a diferencia de Producto
  // (hojaSeguridadUrl), la SDS/MSDS del insumo se adjunta vía el DMS genérico
  // (modelo Adjunto, entidadTipo="Insumo") en vez de un campo URL suelto.
  esPeligroso        Boolean    @default(false)
  claseGhs           String? // clasificación de peligro GHS, ej. "H315, H319 - Irritante cutáneo/ocular"
  activo             Boolean    @default(true)
  creadoEn           DateTime   @default(now())
  actualizadoEn      DateTime   @updatedAt

  proveedor              Proveedor?                     @relation(fields: [proveedorId], references: [id])
  zonaAlmacen            ZonaAlmacen?                   @relation(fields: [zonaAlmacenId], references: [id])
  movimientos            MovimientoKardex[]
  saldosAlmacen          SaldoAlmacen[]
  formulaDetalles        FormulaDetalle[]
  envasadoInsumos        EnvasadoInsumo[]
  ordenCompraDetalles    OrdenCompraDetalle[]
  recepcionDetalles      RecepcionCompraDetalle[]
  conteoDetalles         ConteoInventarioDetalle[]
  movimientosCasco       MovimientoCasco[]
  repuestosMantenimiento RepuestoOrdenMantenimiento[]
  reservasProduccion     ReservaInsumoProduccion[]
  movimientosProduccion  MovimientoMaterialProduccion[]
  planesInspeccion       PlanInspeccionInsumo[]

  @@unique([empresaId, codigo])
  @@map("insumos")
}

enum TipoMovimientoCasco {
  ENTREGADO // se le entregó el envase retornable al cliente (con su depósito)
  DEVUELTO // el cliente devolvió el casco vacío
}

// Ledger manual (no se deriva automáticamente de las ventas: un envasado no
// siempre implica un casco nuevo entregado, podría ser un refill de uno que
// el cliente ya tiene). Pendiente por (cliente, insumo) = ENTREGADO − DEVUELTO.
model MovimientoCasco {
  id            String              @id @default(cuid())
  clienteId     String
  insumoId      String
  tipo          TipoMovimientoCasco
  cantidad      Int
  fecha         DateTime            @default(now())
  referencia    String? // factura/guía asociada, opcional
  usuarioId     String
  usuarioNombre String

  cliente Cliente @relation(fields: [clienteId], references: [id])
  insumo  Insumo  @relation(fields: [insumoId], references: [id])

  @@map("movimientos_casco")
}

// ---------------------------------------------------------------------------
// INVENTARIO — KARDEX (inmutable: nunca se edita ni borra, solo se compensa)
// ---------------------------------------------------------------------------

enum TipoItemKardex {
  PRESENTACION
  INSUMO
}

enum TipoMovimiento {
  ENTRADA
  SALIDA
}

enum OrigenMovimiento {
  STOCK_INICIAL
  COMPRA
  PRODUCCION // consumo de insumos por lote granel
  ENVASADO // consumo de envases/etiquetas y entrada de presentaciones
  VENTA
  ANULACION_VENTA
  REVERSO_ENTREGA
  DEVOLUCION_CLIENTE // el cliente devuelve mercadería físicamente (no es anulación ni NC)
  DEVOLUCION_PROVEEDOR // se devuelve materia prima/insumo a un proveedor (defecto, no conformidad)
  TRASLADO // movimiento entre dos almacenes: una SALIDA en el origen + una ENTRADA en el destino
  AJUSTE // regularización manual: motivo obligatorio
}

model MovimientoKardex {
  id             String           @id @default(cuid())
  empresaId      String           @default("1")
  fecha          DateTime         @default(now())
  almacenId      String
  tipoItem       TipoItemKardex
  presentacionId String?
  insumoId       String?
  tipoMovimiento TipoMovimiento
  origen         OrigenMovimiento
  cantidad       Decimal // siempre positiva; el signo lo da tipoMovimiento
  saldoAnterior  Decimal // saldo DEL ALMACÉN indicado (no el total de la empresa)
  saldoNuevo     Decimal
  motivo         String? // obligatorio cuando origen = AJUSTE
  referencia     String? // código de lote, envasado, factura, traslado, etc.
  usuarioId      String
  usuarioNombre  String
  creadoEn       DateTime         @default(now())

  almacen      Almacen       @relation(fields: [almacenId], references: [id])
  presentacion Presentacion? @relation(fields: [presentacionId], references: [id])
  insumo       Insumo?       @relation(fields: [insumoId], references: [id])

  @@index([tipoItem, presentacionId, insumoId])
  @@index([almacenId, tipoItem, presentacionId, insumoId])
  @@map("movimientos_kardex")
}

// Saldo de stock por almacén (la "verdad" granular); Presentacion.stock e
// Insumo.stock siguen existiendo como el total agregado de todos los
// almacenes, mantenido en sincronía en la misma transacción que este saldo.
model SaldoAlmacen {
  id             String         @id @default(cuid())
  almacenId      String
  tipoItem       TipoItemKardex
  presentacionId String?
  insumoId       String?
  cantidad       Decimal        @default(0)
  actualizadoEn  DateTime       @updatedAt

  almacen      Almacen       @relation(fields: [almacenId], references: [id])
  presentacion Presentacion? @relation(fields: [presentacionId], references: [id])
  insumo       Insumo?       @relation(fields: [insumoId], references: [id])

  @@unique([almacenId, tipoItem, presentacionId, insumoId])
  @@map("saldos_almacen")
}

// ---------------------------------------------------------------------------
// INVENTARIO — CONTEO CÍCLICO (proceso estructurado, en vez de ajustes sueltos)
// ---------------------------------------------------------------------------

// Un conteo cíclico se registra ya cerrado: se cuenta físicamente, se anota
// lo contado y al guardar se generan los AJUSTE de kardex necesarios para
// las líneas con diferencia. No hay estado "abierto" — es un proceso de un
// solo paso (contar → guardar → se ajusta solo).
model ConteoInventario {
  id            String   @id @default(cuid())
  empresaId     String   @default("1")
  codigo        String   @unique // CI-00001
  fecha         DateTime @default(now())
  usuarioId     String
  usuarioNombre String

  detalles ConteoInventarioDetalle[]

  @@map("conteos_inventario")
}

model ConteoInventarioDetalle {
  id              String         @id @default(cuid())
  conteoId        String
  tipoItem        TipoItemKardex
  presentacionId  String?
  insumoId        String?
  cantidadSistema Decimal // stock según el sistema al momento del conteo
  cantidadContada Decimal // lo contado físicamente
  diferencia      Decimal // cantidadContada - cantidadSistema

  conteo       ConteoInventario @relation(fields: [conteoId], references: [id])
  presentacion Presentacion?    @relation(fields: [presentacionId], references: [id])
  insumo       Insumo?          @relation(fields: [insumoId], references: [id])

  @@map("conteo_inventario_detalles")
}

// ---------------------------------------------------------------------------
// PRODUCCION — ETAPA 1: FORMULAS (versionadas) Y LOTES GRANEL
// ---------------------------------------------------------------------------

model Formula {
  id            String    @id @default(cuid())
  empresaId     String    @default("1")
  productoId    String
  version       Int
  rendimientoKg Decimal // kg de granel que produce un batch con las cantidades del detalle
  horasEstandar Decimal? // horas-hombre estándar de cocción por batch; null en versiones históricas sin base aprobada
  notas         String?
  activo        Boolean   @default(true)
  vigenteDesde  DateTime? // cuándo esta versión pasó a ser la vigente (se reasigna si se reactiva una versión anterior)
  vigenteHasta  DateTime? // cuándo dejó de ser la vigente (null si sigue vigente)
  usuarioId     String
  usuarioNombre String
  creadoEn      DateTime  @default(now())

  producto    Producto           @relation(fields: [productoId], references: [id])
  detalles    FormulaDetalle[]
  operaciones FormulaOperacion[]
  lotes       LoteGranel[]

  @@unique([productoId, version])
  @@map("formulas")
}

model FormulaDetalle {
  id        String  @id @default(cuid())
  formulaId String
  insumoId  String
  cantidad  Decimal // cantidad del insumo (en su unidad) para producir rendimientoKg

  formula Formula @relation(fields: [formulaId], references: [id])
  insumo  Insumo  @relation(fields: [insumoId], references: [id])

  @@map("formula_detalles")
}

model FormulaOperacion {
  id               String  @id @default(cuid())
  formulaId        String
  centroTrabajoId  String
  secuencia        Int
  nombre           String
  preparacionHoras Decimal @default(0)
  maquinaHoras     Decimal @default(0)
  manoObraHoras    Decimal @default(0)

  formula         Formula         @relation(fields: [formulaId], references: [id], onDelete: Cascade)
  centroTrabajo   CentroTrabajo   @relation(fields: [centroTrabajoId], references: [id])
  operacionesLote LoteOperacion[]

  @@unique([formulaId, secuencia])
  @@map("formula_operaciones")
}

enum EstadoLote {
  PLANIFICADO
  CANCELADO
  EN_PROCESO
  PENDIENTE_CALIDAD
  APROBADO
  RECHAZADO
}

enum DisposicionLoteRechazado {
  REPROCESADO
  DESECHADO
}

enum EstadoOperacionLote {
  PENDIENTE
  EN_PROCESO
  COMPLETADA
}

model LoteGranel {
  id                       String                    @id @default(cuid())
  empresaId                String                    @default("1")
  codigo                   String                    @unique // LG-00001
  formulaId                String
  // Si este lote reprocesa un lote rechazado por calidad, referencia de dónde
  // viene (trazabilidad de la no conformidad). Su costo acumulado se incorpora
  // al nuevo lote; la nueva orden consume además los insumos de su fórmula.
  loteOrigenId             String?
  kgObjetivo               Decimal
  kgProducidos             Decimal                   @default(0)
  mermaKg                  Decimal                   @default(0)
  kgDisponibles            Decimal                   @default(0) // granel aprobado aún no envasado
  costoInsumos             Decimal                   @default(0) // costo total de insumos consumidos al crear el lote
  costoReproceso           Decimal                   @default(0) // costo heredado del lote rechazado incorporado al reproceso
  horasManoObra            Decimal                   @default(0) // horas-hombre invertidas en la cocción (al finalizar)
  costoManoObra            Decimal                   @default(0) // horasManoObra * tarifa vigente al finalizar
  costoKg                  Decimal                   @default(0) // costo real total / kg producido
  costoEstandarInsumos     Decimal? // snapshot plan al liberar la orden
  costoEstandarManoObra    Decimal? // horas estándar escaladas × tarifa snapshot
  costoEstandarTotal       Decimal? // costo estándar para kg objetivo
  costoEstandarPermitido   Decimal? // estándar permitido para kg realmente producidos
  variacionInsumos         Decimal? // costo real insumos - estándar insumos
  variacionManoObra        Decimal? // costo real MO - estándar MO
  variacionRendimiento     Decimal? // estándar objetivo - estándar permitido
  variacionTotal           Decimal? // costo real - estándar permitido
  estado                   EstadoLote                @default(EN_PROCESO)
  observaciones            String?
  fechaCreacion            DateTime?
  fechaInicio              DateTime                  @default(now())
  fechaLiberacion          DateTime?
  usuarioLiberacionId      String?
  usuarioLiberacionNombre  String?
  fechaCancelacion         DateTime?
  motivoCancelacion        String?
  usuarioCancelacionId     String?
  usuarioCancelacionNombre String?
  fechaFin                 DateTime?
  usuarioId                String
  disposicionRechazo       DisposicionLoteRechazado?
  motivoDisposicion        String?
  fechaDisposicion         DateTime?
  usuarioDisposicionId     String?
  usuarioDisposicionNombre String?
  usuarioNombre            String

  formula                Formula                        @relation(fields: [formulaId], references: [id])
  loteOrigen             LoteGranel?                    @relation("Reproceso", fields: [loteOrigenId], references: [id])
  reprocesos             LoteGranel[]                   @relation("Reproceso")
  controlCalidad         ControlCalidad?
  envasados              Envasado[]
  asignacionesLoteInsumo AsignacionLoteInsumo[]
  operaciones            LoteOperacion[]
  reservasInsumo         ReservaInsumoProduccion[]
  movimientosMaterial    MovimientoMaterialProduccion[]

  @@map("lotes_granel")
}

model ReservaInsumoProduccion {
  id           String   @id @default(cuid())
  loteGranelId String
  insumoId     String
  cantidad     Decimal
  creadoEn     DateTime @default(now())

  loteGranel LoteGranel @relation(fields: [loteGranelId], references: [id], onDelete: Cascade)
  insumo     Insumo     @relation(fields: [insumoId], references: [id])

  @@unique([loteGranelId, insumoId])
  @@index([insumoId])
  @@map("reservas_insumo_produccion")
}

enum TipoMovimientoMaterialProduccion {
  CONSUMO_ADICIONAL
  DEVOLUCION
}

model MovimientoMaterialProduccion {
  id            String                           @id @default(cuid())
  loteGranelId  String
  insumoId      String
  tipo          TipoMovimientoMaterialProduccion
  cantidad      Decimal
  costoUnitario Decimal
  costoTotal    Decimal
  motivo        String
  usuarioId     String
  usuarioNombre String
  creadoEn      DateTime                         @default(now())

  loteGranel   LoteGranel                       @relation(fields: [loteGranelId], references: [id])
  insumo       Insumo                           @relation(fields: [insumoId], references: [id])
  devoluciones DevolucionAsignacionLoteInsumo[]

  @@index([loteGranelId, creadoEn])
  @@map("movimientos_material_produccion")
}

model DevolucionAsignacionLoteInsumo {
  id                     String   @id @default(cuid())
  movimientoMaterialId   String
  asignacionLoteInsumoId String
  cantidad               Decimal
  creadoEn               DateTime @default(now())

  movimiento MovimientoMaterialProduccion @relation(fields: [movimientoMaterialId], references: [id])
  asignacion AsignacionLoteInsumo         @relation(fields: [asignacionLoteInsumoId], references: [id])

  @@index([asignacionLoteInsumoId])
  @@map("devoluciones_asignacion_lote_insumo")
}

model LoteOperacion {
  id                   String              @id @default(cuid())
  loteGranelId         String
  formulaOperacionId   String?
  centroTrabajoId      String
  equipoId             String?
  secuencia            Int
  nombre               String
  preparacionPlanHoras Decimal             @default(0)
  maquinaPlanHoras     Decimal             @default(0)
  manoObraPlanHoras    Decimal             @default(0)
  preparacionRealHoras Decimal             @default(0)
  maquinaRealHoras     Decimal             @default(0)
  manoObraRealHoras    Decimal             @default(0)
  estado               EstadoOperacionLote @default(PENDIENTE)
  inicioEn             DateTime?
  finEn                DateTime?
  usuarioInicioId      String?
  usuarioInicioNombre  String?
  usuarioFinId         String?
  usuarioFinNombre     String?
  fechaPlanInicio      DateTime?
  fechaPlanFin         DateTime?

  loteGranel       LoteGranel        @relation(fields: [loteGranelId], references: [id], onDelete: Cascade)
  formulaOperacion FormulaOperacion? @relation(fields: [formulaOperacionId], references: [id], onDelete: SetNull)
  centroTrabajo    CentroTrabajo     @relation(fields: [centroTrabajoId], references: [id])
  equipo           Equipo?           @relation(fields: [equipoId], references: [id], onDelete: SetNull)

  @@unique([loteGranelId, secuencia])
  @@index([centroTrabajoId, estado])
  @@index([fechaPlanInicio, fechaPlanFin])
  @@map("lote_operaciones")
}

enum ResultadoCalidad {
  APROBADO
  RECHAZADO
}

model ControlCalidad {
  id               String           @id @default(cuid())
  loteGranelId     String           @unique
  resultado        ResultadoCalidad
  observaciones    String?
  // No conformidad (solo cuando resultado = RECHAZADO): por qué falló y qué
  // se hizo al respecto (reproceso, descarte, ajuste de fórmula, etc.).
  // causaId es el catálogo estructurado (permite reportes agregados "top 5
  // defectos"); causaRaiz queda como detalle textual libre complementario.
  causaId          String?
  causaRaiz        String?
  accionCorrectiva String?
  fecha            DateTime         @default(now())
  usuarioId        String
  usuarioNombre    String

  loteGranel               LoteGranel                       @relation(fields: [loteGranelId], references: [id])
  causa                    CausaCalidad?                    @relation(fields: [causaId], references: [id])
  planInspeccion           PlanInspeccionCalidad?           @relation(fields: [planInspeccionId], references: [id])
  resultadosCaracteristica ResultadoCaracteristicaCalidad[]
  noConformidad            NoConformidadCalidad?

  planInspeccionId String?
  planVersion      Int?

  @@map("controles_calidad")
}

enum EstadoNoConformidad {
  ABIERTA
  INVESTIGACION
  IMPLEMENTACION
  VERIFICACION
  CERRADA
}

model NoConformidadCalidad {
  id                   String              @id @default(cuid())
  empresaId            String              @default("1")
  controlCalidadId     String              @unique
  estado               EstadoNoConformidad @default(ABIERTA)
  contencionInmediata  String?
  causaRaizConfirmada  String?
  accionCorrectiva     String?
  responsableId        String?
  responsableNombre    String?
  fechaCompromiso      DateTime?
  verificacionEficacia String?
  eficaz               Boolean?
  cerradoEn            DateTime?
  creadoEn             DateTime            @default(now())
  actualizadoEn        DateTime            @updatedAt

  controlCalidad ControlCalidad               @relation(fields: [controlCalidadId], references: [id])
  eventos        EventoNoConformidadCalidad[]

  @@index([empresaId, estado, fechaCompromiso])
  @@map("no_conformidades_calidad")
}

model EventoNoConformidadCalidad {
  id              String               @id @default(cuid())
  noConformidadId String
  estadoAnterior  EstadoNoConformidad?
  estadoNuevo     EstadoNoConformidad
  comentario      String
  usuarioId       String
  usuarioNombre   String
  creadoEn        DateTime             @default(now())

  noConformidad NoConformidadCalidad @relation(fields: [noConformidadId], references: [id], onDelete: Cascade)

  @@index([noConformidadId, creadoEn])
  @@map("eventos_no_conformidad_calidad")
}

model PlanInspeccionCalidad {
  id            String    @id @default(cuid())
  empresaId     String    @default("1")
  productoId    String
  version       Int
  nombre        String
  vigenteDesde  DateTime  @default(now())
  vigenteHasta  DateTime?
  activo        Boolean   @default(true)
  usuarioId     String
  usuarioNombre String
  creadoEn      DateTime  @default(now())

  producto        Producto                    @relation(fields: [productoId], references: [id])
  caracteristicas CaracteristicaPlanCalidad[]
  controles       ControlCalidad[]

  @@unique([productoId, version])
  @@index([empresaId, activo])
  @@map("planes_inspeccion_calidad")
}

model CaracteristicaPlanCalidad {
  id             String   @id @default(cuid())
  planId         String
  secuencia      Int
  nombre         String
  unidadMedida   String
  limiteInferior Decimal?
  limiteSuperior Decimal?
  metodoEnsayo   String?
  obligatoria    Boolean  @default(true)

  plan PlanInspeccionCalidad @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, secuencia])
  @@map("caracteristicas_plan_calidad")
}

model ResultadoCaracteristicaCalidad {
  id               String   @id @default(cuid())
  controlCalidadId String
  secuencia        Int
  nombre           String
  unidadMedida     String
  limiteInferior   Decimal?
  limiteSuperior   Decimal?
  metodoEnsayo     String?
  valorMedido      Decimal
  conforme         Boolean

  controlCalidad ControlCalidad @relation(fields: [controlCalidadId], references: [id], onDelete: Cascade)

  @@unique([controlCalidadId, secuencia])
  @@map("resultados_caracteristica_calidad")
}

// Catálogo formal de causas/defectos de calidad, reutilizable entre el
// control interno de producción (ControlCalidad) y los reclamos de cliente
// (ReclamoCliente) — reemplaza el texto libre para permitir reportes
// agregados tipo "top 5 defectos".
model CausaCalidad {
  id        String   @id @default(cuid())
  empresaId String   @default("1")
  nombre    String
  activo    Boolean  @default(true)
  creadoEn  DateTime @default(now())

  controlesCalidad ControlCalidad[]
  reclamosCliente  ReclamoCliente[]

  @@unique([empresaId, nombre])
  @@map("causas_calidad")
}

enum EstadoReclamo {
  ABIERTO
  EN_PROCESO
  CERRADO
}

// Notificación de calidad del lado del cliente (RF-QM-025 a 030): a
// diferencia de ControlCalidad (no conformidad interna, antes de despachar),
// esto registra un reclamo recibido después de la venta, con seguimiento de
// estado hasta el cierre.
model ReclamoCliente {
  id               String        @id @default(cuid())
  empresaId        String        @default("1")
  numero           String        @unique // RCL-00001
  clienteId        String
  facturaId        String? // documento de origen, si aplica
  causaId          String?
  descripcion      String
  estado           EstadoReclamo @default(ABIERTO)
  accionCorrectiva String?
  fecha            DateTime      @default(now())
  fechaCierre      DateTime?
  usuarioId        String
  usuarioNombre    String
  creadoEn         DateTime      @default(now())
  actualizadoEn    DateTime      @updatedAt

  cliente Cliente       @relation(fields: [clienteId], references: [id])
  factura Factura?      @relation(fields: [facturaId], references: [id])
  causa   CausaCalidad? @relation(fields: [causaId], references: [id])

  @@map("reclamos_cliente")
}

// ---------------------------------------------------------------------------
// PRODUCCION — ETAPA 2: ENVASADO (granel + envases/etiquetas -> presentaciones)
// ---------------------------------------------------------------------------

model Envasado {
  id                  String    @id @default(cuid())
  empresaId           String    @default("1")
  codigo              String    @unique // ENV-00001
  loteGranelId        String
  presentacionId      String
  unidades            Int
  // Unidades de este lote de envasado que todavía no se asignaron a ninguna
  // venta (arranca en `unidades`, baja al facturar y sube si se anula/
  // devuelve). Permite trazar, ante un recall, qué facturas/clientes
  // recibieron un lote específico (ver AsignacionLoteVenta).
  unidadesDisponibles Int       @default(0)
  kgConsumidos        Decimal // unidades * contenidoKg de la presentación
  horasManoObra       Decimal   @default(0) // horas-hombre invertidas en el envasado
  costoManoObra       Decimal   @default(0) // horasManoObra * tarifa vigente al envasar
  costoTotal          Decimal   @default(0) // granel consumido + envases/etiquetas + mano de obra
  costoUnitario       Decimal   @default(0) // costoTotal / unidades
  fecha               DateTime  @default(now())
  // El código del envasado (ENV-00001) YA funciona como número de lote. Esta
  // fecha se calcula sola desde Producto.vidaUtilMeses al envasar (editable);
  // null si el producto no tiene vida útil configurada.
  fechaVencimiento    DateTime?
  usuarioId           String
  usuarioNombre       String

  loteGranel       LoteGranel            @relation(fields: [loteGranelId], references: [id])
  presentacion     Presentacion          @relation(fields: [presentacionId], references: [id])
  insumos          EnvasadoInsumo[]
  asignacionesLote AsignacionLoteVenta[]

  @@map("envasados")
}

enum TipoAsignacionLote {
  ASIGNADA // se vendió (facturó) esta cantidad de este lote de envasado
  LIBERADA // se liberó por anulación de factura o devolución de mercadería
}

// Ledger inmutable (mismo patrón que Comision GENERADA/REVERSION) que
// permite responder, ante un reclamo de calidad o un recall, "¿qué
// facturas/clientes recibieron unidades del lote de envasado X?". El saldo
// vigente de un PedidoDetalle en un Envasado es la suma de ASIGNADA menos
// LIBERADA.
model AsignacionLoteVenta {
  id                  String             @id @default(cuid())
  pedidoDetalleId     String
  facturaDetalleId    String?
  guiaDetalleId       String?
  devolucionDetalleId String?
  envasadoId          String
  tipo                TipoAsignacionLote @default(ASIGNADA)
  cantidad            Int // siempre positiva; el signo real lo da "tipo"
  motivo              String? // ej. "Anulación factura F001-123" (null en la asignación original)
  creadoEn            DateTime           @default(now())

  pedidoDetalle     PedidoDetalle             @relation(fields: [pedidoDetalleId], references: [id])
  facturaDetalle    FacturaDetalle?           @relation(fields: [facturaDetalleId], references: [id])
  guiaDetalle       GuiaRemisionDetalle?      @relation(fields: [guiaDetalleId], references: [id])
  devolucionDetalle DevolucionClienteDetalle? @relation(fields: [devolucionDetalleId], references: [id])
  envasado          Envasado                  @relation(fields: [envasadoId], references: [id])

  @@index([facturaDetalleId])
  @@index([guiaDetalleId])
  @@index([devolucionDetalleId])
  @@map("asignaciones_lote_venta")
}

model EnvasadoInsumo {
  id         String  @id @default(cuid())
  envasadoId String
  insumoId   String
  cantidad   Decimal

  envasado Envasado @relation(fields: [envasadoId], references: [id])
  insumo   Insumo   @relation(fields: [insumoId], references: [id])

  @@map("envasado_insumos")
}

// ---------------------------------------------------------------------------
// COMERCIAL
// ---------------------------------------------------------------------------

model Zona {
  id        String   @id @default(cuid())
  empresaId String   @default("1")
  nombre    String
  activo    Boolean  @default(true)
  creadoEn  DateTime @default(now())

  vendedores Vendedor[]
  clientes   Cliente[]

  @@unique([empresaId, nombre])
  @@map("zonas")
}

enum TipoVendedor {
  CON_BASICO
  SOLO_COMISION
}

model Vendedor {
  id           String       @id @default(cuid())
  empresaId    String       @default("1")
  nombre       String
  documento    String?
  telefono     String?
  email        String?
  tipo         TipoVendedor
  tasaComision Decimal // porcentaje individual, ej. 3.5
  zonaId       String?
  activo       Boolean      @default(true)
  creadoEn     DateTime     @default(now())

  zona              Zona?        @relation(fields: [zonaId], references: [id])
  pedidos           Pedido[]
  facturas          Factura[]
  comisiones        Comision[]
  hojasRuta         HojaRuta[]
  clientesAsignados Cliente[]    @relation("ClienteVendedor")
  cotizaciones      Cotizacion[]

  @@map("vendedores")
}

// Canal comercial del cliente: determina el tipo de descuentos/condiciones
// que aplican (un distribuidor mayorista no se maneja igual que un taller).
enum CanalCliente {
  DISTRIBUIDOR
  MAYORISTA
  TALLER
  FLOTA
  MINERA_INDUSTRIA
  MINORISTA
  OTRO
}

// Descuento por defecto según el canal del cliente (además del escalón por
// volumen de EscalonPrecio). Se aplica sobre el precio ya resuelto por
// cantidad: precioFinal = precioEscalonOBase * (1 - descuentoPct/100).
model DescuentoCanal {
  id           String       @id @default(cuid())
  canal        CanalCliente @unique
  descuentoPct Decimal      @default(0)

  @@map("descuentos_canal")
}

model Cliente {
  id                   String              @id @default(cuid())
  empresaId            String              @default("1")
  codigo               String // CLI-00001, asignado automáticamente al crear (nunca se reutiliza)
  razonSocial          String
  nombreComercial      String?
  ruc                  String?
  tipoDocumentoFiscal  TipoDocumentoFiscal @default(RUC)
  canal                CanalCliente?
  pais                 String              @default("Peru")
  departamento         String?
  provincia            String?
  distrito             String?
  direccion            String?
  telefono             String?
  email                String?
  contactoNombre       String?
  contactoTelefono     String?
  zonaId               String?
  vendedorId           String? // vendedor asignado (se preselecciona en pedidos)
  limiteCredito        Decimal             @default(0) // 0 = sin límite; se valida al facturar
  condicionPagoDefecto CondicionPago       @default(CONTADO)
  notas                String?
  activo               Boolean             @default(true)
  // Bloqueo específico de cobranza (distinto de `activo`): impide crear
  // pedidos nuevos mientras tenga facturas vencidas sin resolver, pero no
  // oculta al cliente ni afecta su historial. Se levanta manualmente desde
  // Finanzas → Cobranza una vez que regulariza su deuda.
  bloqueadoCobranza    Boolean             @default(false)
  bloqueadoCobranzaEn  DateTime?
  bloqueadoCobranzaPor String?
  creadoEn             DateTime            @default(now())

  zona             Zona?             @relation(fields: [zonaId], references: [id])
  vendedorAsignado Vendedor?         @relation("ClienteVendedor", fields: [vendedorId], references: [id])
  pedidos          Pedido[]
  facturas         Factura[]
  guias            GuiaRemision[]
  visitas          HojaRutaVisita[]
  cotizaciones     Cotizacion[]
  movimientosCasco MovimientoCasco[]
  avisosCobranza   AvisoCobranza[]
  reclamos         ReclamoCliente[]
  creditosCliente  CreditoCliente[]

  @@unique([empresaId, ruc])
  @@unique([empresaId, codigo])
  @@map("clientes")
}

enum EstadoPedido {
  PENDIENTE
  PARCIAL
  FACTURADO
  ANULADO
}

enum EstadoCotizacion {
  PENDIENTE
  ACEPTADA
  RECHAZADA
  VENCIDA
  CONVERTIDA // ya generó un Pedido
}

// Cotización: etapa opcional antes del Pedido (frecuente en ventas
// industriales/mineras donde se piden specs y precio antes de comprar). No
// toca stock ni kardex — solo al convertirla se crea un Pedido real.
model Cotizacion {
  id            String           @id @default(cuid())
  empresaId     String           @default("1")
  numero        String           @unique // COT-00001
  clienteId     String
  vendedorId    String
  fecha         DateTime         @default(now())
  validaHasta   DateTime
  estado        EstadoCotizacion @default(PENDIENTE)
  total         Decimal
  // Embudo de ventas simple (CRM-014 reducido): probabilidad de cierre
  // estimada por el vendedor, 0-100. Se fija sola a 100/0 al aceptar/rechazar;
  // mientras está PENDIENTE, el vendedor la ajusta a criterio.
  probabilidad  Int              @default(50)
  notas         String?
  pedidoId      String?          @unique // si ya se convirtió
  usuarioId     String
  usuarioNombre String

  cliente  Cliente             @relation(fields: [clienteId], references: [id])
  vendedor Vendedor            @relation(fields: [vendedorId], references: [id])
  pedido   Pedido?             @relation(fields: [pedidoId], references: [id])
  detalles CotizacionDetalle[]

  @@map("cotizaciones")
}

model CotizacionDetalle {
  id             String  @id @default(cuid())
  cotizacionId   String
  presentacionId String
  cantidad       Int
  precioUnitario Decimal
  subtotal       Decimal

  cotizacion   Cotizacion   @relation(fields: [cotizacionId], references: [id])
  presentacion Presentacion @relation(fields: [presentacionId], references: [id])

  @@map("cotizacion_detalles")
}

model Pedido {
  id                      String           @id @default(cuid())
  empresaId               String           @default("1")
  numero                  String           @unique // PED-00001
  clienteId               String
  vendedorId              String
  almacenId               String?
  fecha                   DateTime         @default(now())
  fechaEntregaSolicitada  DateTime?
  estado                  EstadoPedido     @default(PENDIENTE)
  fulfillmentVersion      Int              @default(0)
  requiereEntrega         Boolean          @default(false)
  moneda                  String           @default("PEN")
  tipoCambio              Decimal          @default(1)
  condicionPago           CondicionPago    @default(CONTADO)
  direccionEntrega        String?
  ordenCompraCliente      String?
  referenciaCliente       String?
  subtotalBruto           Decimal          @default(0)
  descuentoTotal          Decimal          @default(0)
  total                   Decimal
  tasaIgv                 Decimal          @default(0)
  igv                     Decimal          @default(0)
  totalConIgv             Decimal          @default(0)
  notas                   String?
  usuarioId               String
  usuarioNombre           String
  estadoAprobacionCredito EstadoAprobacion @default(NO_REQUERIDA)
  condicionPagoCredito    CondicionPago?
  deudaCreditoEvaluada    Decimal?
  montoCreditoEvaluado    Decimal?
  limiteCreditoEvaluado   Decimal?
  creditoSolicitadoEn     DateTime?
  creditoResueltoEn       DateTime?
  creditoResueltoPor      String?
  motivoRechazoCredito    String?

  cliente          Cliente         @relation(fields: [clienteId], references: [id])
  vendedor         Vendedor        @relation(fields: [vendedorId], references: [id])
  almacen          Almacen?        @relation(fields: [almacenId], references: [id])
  detalles         PedidoDetalle[]
  facturas         Factura[]
  guias            GuiaRemision[]
  cotizacionOrigen Cotizacion?

  @@map("pedidos")
}

model PedidoDetalle {
  id                   String  @id @default(cuid())
  pedidoId             String
  presentacionId       String
  cantidad             Int
  precioLista          Decimal @default(0)
  origenPrecio         String  @default("LEGACY")
  cantidadMinimaPrecio Int?
  descuentoPct         Decimal @default(0)
  descuentoMonto       Decimal @default(0)
  precioUnitario       Decimal
  subtotal             Decimal
  costoUnitario        Decimal @default(0) // snapshot del costo promedio al facturar (para costo de ventas)

  pedido              Pedido                @relation(fields: [pedidoId], references: [id])
  presentacion        Presentacion          @relation(fields: [presentacionId], references: [id])
  asignacionesLote    AsignacionLoteVenta[]
  notaCreditoDetalles NotaCreditoDetalle[]
  facturaDetalles     FacturaDetalle[]
  guiaDetalles        GuiaRemisionDetalle[]

  @@map("pedido_detalles")
}

enum CondicionPago {
  CONTADO
  DIAS_15
  DIAS_30
}

enum EstadoFactura {
  PENDIENTE
  PAGADA
  ANULADA
}

// La factura se emite en el portal SUNAT; aquí solo se registra su número.
model Factura {
  id                String        @id @default(cuid())
  empresaId         String        @default("1")
  numero            String        @unique // número SUNAT, ej. F001-00000123
  pedidoId          String
  clienteId         String
  vendedorId        String
  moneda            String        @default("PEN")
  tipoCambio        Decimal       @default(1)
  monedaFuncional   String        @default("PEN")
  condicionPago     CondicionPago
  fechaEmision      DateTime      @default(now())
  fechaVencimiento  DateTime
  subtotal          Decimal       @default(0) // valor de venta (base imponible)
  tasaIgv           Decimal       @default(0) // % vigente al emitir (congelado)
  igv               Decimal       @default(0)
  total             Decimal // subtotal + IGV, en moneda del documento
  saldo             Decimal
  subtotalFuncional Decimal       @default(0)
  igvFuncional      Decimal       @default(0)
  totalFuncional    Decimal       @default(0)
  saldoFuncional    Decimal       @default(0)
  estado            EstadoFactura @default(PENDIENTE)
  motivoAnulacion   String?
  anuladaEn         DateTime?
  anuladaPor        String?
  usuarioId         String
  usuarioNombre     String

  pedido              Pedido                     @relation(fields: [pedidoId], references: [id])
  cliente             Cliente                    @relation(fields: [clienteId], references: [id])
  vendedor            Vendedor                   @relation(fields: [vendedorId], references: [id])
  cobros              Cobro[]
  avisosCobranza      AvisoCobranza[]
  notasCredito        NotaCredito[]
  comisiones          Comision[]
  guias               GuiaRemision[]
  devolucionesCliente DevolucionCliente[]
  recargosMora        RecargoMora[]
  reclamos            ReclamoCliente[]
  detalles            FacturaDetalle[]
  aplicacionesCredito AplicacionCreditoCliente[]

  @@index([pedidoId])
  @@map("facturas")
}

// Snapshot inmutable de las líneas efectivamente facturadas. Separa el documento
// tributario del pedido origen y habilita facturación parcial sin reescribir historia.
model FacturaDetalle {
  id                      String  @id @default(cuid())
  facturaId               String
  pedidoDetalleId         String
  presentacionId          String
  cantidad                Int
  precioLista             Decimal @default(0)
  origenPrecio            String  @default("LEGACY")
  cantidadMinimaPrecio    Int?
  descuentoPct            Decimal @default(0)
  descuentoMonto          Decimal @default(0)
  precioUnitario          Decimal
  subtotal                Decimal
  precioUnitarioFuncional Decimal @default(0)
  subtotalFuncional       Decimal @default(0)
  costoUnitario           Decimal @default(0)

  factura            Factura                    @relation(fields: [facturaId], references: [id])
  pedidoDetalle      PedidoDetalle              @relation(fields: [pedidoDetalleId], references: [id])
  presentacion       Presentacion               @relation(fields: [presentacionId], references: [id])
  asignacionesLote   AsignacionLoteVenta[]
  entregas           FacturaDetalleEntrega[]
  devolucionDetalles DevolucionClienteDetalle[]

  @@unique([facturaId, pedidoDetalleId])
  @@index([pedidoDetalleId])
  @@index([presentacionId])
  @@map("factura_detalles")
}

// Recargo por mora sobre facturas vencidas: incrementa el saldo por cobrar
// (nunca el total original de la factura, que refleja el valor de venta
// emitido en SUNAT). Cada aplicación cubre solo los días transcurridos desde
// el último recargo (o desde el vencimiento, si es el primero) — no se
// puede duplicar el cobro de los mismos días de atraso.
model RecargoMora {
  id             String   @id @default(cuid())
  facturaId      String
  fecha          DateTime @default(now())
  diasCalculados Int
  tasaAplicada   Decimal // % mensual vigente al momento de aplicar
  monto          Decimal
  moneda         String   @default("PEN")
  tipoCambio     Decimal  @default(1)
  montoFuncional Decimal  @default(0)
  usuarioId      String
  usuarioNombre  String

  factura Factura @relation(fields: [facturaId], references: [id])

  @@map("recargos_mora")
}

// Aviso de cobranza (dunning): registro de que se avisó a un cliente sobre
// una factura vencida, en un nivel de escalamiento creciente. No envía
// correo/SMS real (este ERP no tiene esa integración) — es el registro de
// que el aviso se emitió (para imprimir/entregar) y en qué nivel, para poder
// distinguir "primera vez que se avisa" de "ya se le avisó 3 veces".
model AvisoCobranza {
  id            String   @id @default(cuid())
  empresaId     String   @default("1")
  clienteId     String
  facturaId     String
  nivel         Int // 1 = aviso amistoso, 2 = aviso formal, 3 = aviso final
  diasVencidos  Int // snapshot al momento de emitir el aviso
  fecha         DateTime @default(now())
  usuarioId     String
  usuarioNombre String

  cliente Cliente @relation(fields: [clienteId], references: [id])
  factura Factura @relation(fields: [facturaId], references: [id])

  @@map("avisos_cobranza")
}

// --- Facturación electrónica SUNAT (vía OSE) --------------------------------

enum TipoComprobanteElectronico {
  FACTURA
  NOTA_CREDITO
  GUIA_REMISION
}

enum EstadoEnvioSunat {
  PENDIENTE // aún no se intentó enviar
  ENVIADO // se envió al OSE, esperando confirmación de SUNAT
  ACEPTADO
  RECHAZADO // SUNAT rechazó el comprobante (ej. datos inválidos)
  OBSERVADO // SUNAT lo aceptó con observaciones
  ERROR // falló la llamada al OSE (red, credenciales, etc.), no es un rechazo de SUNAT
}

// Ledger de envíos a un OSE (Operador de Servicios Electrónicos: Nubefact,
// Bizlinks, etc.) para dar validez tributaria real a Factura/NotaCredito/
// GuiaRemision. Independiente del documento comercial: si un envío falla o
// queda observado, se puede reintentar sin tocar el documento original.
// "Best-effort" igual que el motor contable: si el envío falla, el documento
// comercial ya está creado y la operación no se bloquea.
model ComprobanteElectronico {
  id               String                     @id @default(cuid())
  empresaId        String                     @default("1")
  tipoDocumento    TipoComprobanteElectronico
  documentoId      String
  numeroDocumento  String // copia del numero de Factura/NotaCredito/GuiaRemision, para no resolver la relación polimórfica solo para mostrarlo
  estado           EstadoEnvioSunat           @default(PENDIENTE)
  proveedorOse     String // snapshot del proveedor usado en este envío (ConfiguracionEmpresa.oseProveedor al momento)
  codigoHash       String?
  sunatDescripcion String?
  enlacePdf        String?
  enlaceXml        String?
  enlaceCdr        String?
  intentos         Int                        @default(0)
  ultimoIntentoEn  DateTime?
  creadoEn         DateTime                   @default(now())

  @@unique([empresaId, tipoDocumento, documentoId])
  @@map("comprobantes_electronicos")
}

enum MedioPago {
  EFECTIVO
  TRANSFERENCIA
  DEPOSITO
  YAPE
  PLIN
  OTRO
}

model Cobro {
  id                   String    @id @default(cuid())
  empresaId            String    @default("1")
  facturaId            String
  fecha                DateTime  @default(now())
  monto                Decimal
  moneda               String    @default("PEN")
  tipoCambio           Decimal   @default(1)
  montoFuncional       Decimal   @default(0)
  cxcFuncionalAplicada Decimal   @default(0)
  diferenciaCambio     Decimal   @default(0)
  medioPago            MedioPago
  referencia           String?
  usuarioId            String
  usuarioNombre        String

  factura Factura @relation(fields: [facturaId], references: [id])

  @@map("cobros")
}

// Catálogo 9 de SUNAT (código de tipo de nota de crédito) — el adaptador OSE
// tiene que mandar uno de estos códigos, no un texto libre. `motivo` sigue
// siendo el sustento en palabras (ej. "ERROR DE DIGITACION"), tipoNota es
// el código que exige el XML.
enum TipoNotaCredito {
  ANULACION_OPERACION // 01
  ANULACION_ERROR_RUC // 02
  CORRECCION_DESCRIPCION // 03
  DESCUENTO_GLOBAL // 04
  DESCUENTO_ITEM // 05
  DEVOLUCION_TOTAL // 06
  DEVOLUCION_ITEM // 07
  BONIFICACION // 08
  DISMINUCION_VALOR // 09
  OTROS_CONCEPTOS // 10
}

model NotaCredito {
  id             String          @id @default(cuid())
  empresaId      String          @default("1")
  numero         String          @unique // número SUNAT de la NC
  facturaId      String
  fecha          DateTime        @default(now())
  monto          Decimal
  moneda         String          @default("PEN")
  tipoCambio     Decimal         @default(1)
  montoFuncional Decimal         @default(0)
  motivo         String
  tipoNota       TipoNotaCredito @default(OTROS_CONCEPTOS)
  usuarioId      String
  usuarioNombre  String

  factura  Factura              @relation(fields: [facturaId], references: [id])
  detalles NotaCreditoDetalle[]
  credito  CreditoCliente?

  @@map("notas_credito")
}

// Líneas reales que se están afectando (para que el comprobante electrónico
// cite el producto/cantidad real de la factura, no un texto libre como si
// fuera un ítem — bug que tenía la versión anterior de este envío).
model NotaCreditoDetalle {
  id                  String  @id @default(cuid())
  notaCreditoId       String
  pedidoDetalleId     String
  devolucionDetalleId String?
  cantidad            Decimal
  precioUnitario      Decimal
  subtotal            Decimal

  notaCredito       NotaCredito               @relation(fields: [notaCreditoId], references: [id])
  pedidoDetalle     PedidoDetalle             @relation(fields: [pedidoDetalleId], references: [id])
  devolucionDetalle DevolucionClienteDetalle? @relation(fields: [devolucionDetalleId], references: [id])

  @@index([devolucionDetalleId])
  @@map("nota_credito_detalles")
}

enum EstadoCreditoCliente {
  DISPONIBLE
  AGOTADO
}

model CreditoCliente {
  id                     String               @id @default(cuid())
  empresaId              String               @default("1")
  clienteId              String
  notaCreditoId          String               @unique
  moneda                 String               @default("PEN")
  tipoCambioOrigen       Decimal              @default(1)
  montoOriginal          Decimal
  saldo                  Decimal
  montoFuncionalOriginal Decimal              @default(0)
  saldoFuncional         Decimal              @default(0)
  estado                 EstadoCreditoCliente @default(DISPONIBLE)
  creadoEn               DateTime             @default(now())

  cliente      Cliente                    @relation(fields: [clienteId], references: [id])
  notaCredito  NotaCredito                @relation(fields: [notaCreditoId], references: [id])
  aplicaciones AplicacionCreditoCliente[]
  reembolsos   ReembolsoCliente[]

  @@index([clienteId, estado])
  @@map("creditos_cliente")
}

model AplicacionCreditoCliente {
  id                       String   @id @default(cuid())
  empresaId                String   @default("1")
  creditoId                String
  facturaId                String
  fecha                    DateTime @default(now())
  monto                    Decimal
  creditoFuncionalAplicado Decimal
  cxcFuncionalAplicada     Decimal
  diferenciaCambio         Decimal  @default(0)
  usuarioId                String
  usuarioNombre            String

  credito CreditoCliente @relation(fields: [creditoId], references: [id])
  factura Factura        @relation(fields: [facturaId], references: [id])

  @@index([creditoId])
  @@index([facturaId])
  @@map("aplicaciones_credito_cliente")
}

model ReembolsoCliente {
  id                       String           @id @default(cuid())
  empresaId                String           @default("1")
  creditoId                String
  fecha                    DateTime         @default(now())
  monto                    Decimal
  moneda                   String           @default("PEN")
  tipoCambio               Decimal          @default(1)
  montoFuncional           Decimal
  creditoFuncionalAplicado Decimal
  diferenciaCambio         Decimal          @default(0)
  medioPago                MedioPago
  referencia               String?
  estadoAprobacion         EstadoAprobacion @default(NO_REQUERIDA)
  aprobadoPor              String?
  aprobadoEn               DateTime?
  motivoRechazo            String?
  usuarioId                String
  usuarioNombre            String

  credito CreditoCliente @relation(fields: [creditoId], references: [id])

  @@index([creditoId, estadoAprobacion])
  @@map("reembolsos_cliente")
}

enum EstadoDevolucionCliente {
  PENDIENTE_INSPECCION
  CERRADA
}

enum DecisionDevolucionCliente {
  PENDIENTE
  REINGRESO_STOCK
  DESECHO
  DEVOLVER_CLIENTE
  MIXTA
}

model DevolucionCliente {
  id               String                  @id @default(cuid())
  empresaId        String                  @default("1")
  numero           String                  @unique
  facturaId        String
  almacenId        String
  fechaRecepcion   DateTime                @default(now())
  motivo           String
  estado           EstadoDevolucionCliente @default(PENDIENTE_INSPECCION)
  usuarioId        String
  usuarioNombre    String
  cerradoEn        DateTime?
  cerradoPorId     String?
  cerradoPorNombre String?
  creadoEn         DateTime                @default(now())

  factura  Factura                    @relation(fields: [facturaId], references: [id])
  almacen  Almacen                    @relation(fields: [almacenId], references: [id])
  detalles DevolucionClienteDetalle[]

  @@index([facturaId])
  @@index([almacenId, estado])
  @@map("devoluciones_cliente")
}

model DevolucionClienteDetalle {
  id                      String                    @id @default(cuid())
  devolucionId            String
  facturaDetalleId        String
  cantidad                Int
  decision                DecisionDevolucionCliente @default(PENDIENTE)
  cantidadReingreso       Int                       @default(0)
  cantidadDesecho         Int                       @default(0)
  cantidadDevolverCliente Int                       @default(0)
  cantidadAcreditable     Int                       @default(0)
  observacionCalidad      String?
  inspeccionadaEn         DateTime?
  inspeccionadaPorId      String?
  inspeccionadaPorNombre  String?

  devolucion          DevolucionCliente     @relation(fields: [devolucionId], references: [id])
  facturaDetalle      FacturaDetalle        @relation(fields: [facturaDetalleId], references: [id])
  notasCreditoDetalle NotaCreditoDetalle[]
  asignacionesLote    AsignacionLoteVenta[]

  @@unique([devolucionId, facturaDetalleId])
  @@index([facturaDetalleId])
  @@map("devolucion_cliente_detalles")
}

enum TipoComision {
  GENERADA // nace con la factura
  REVERSION // compensación por anulación o nota de crédito (monto negativo)
}

enum EstadoComision {
  PENDIENTE
  PAGADA
}

model Comision {
  id         String         @id @default(cuid())
  empresaId  String         @default("1")
  vendedorId String
  facturaId  String
  tipo       TipoComision
  tasa       Decimal
  monto      Decimal // negativo cuando tipo = REVERSION
  estado     EstadoComision @default(PENDIENTE)
  motivo     String?
  creadoEn   DateTime       @default(now())

  vendedor Vendedor @relation(fields: [vendedorId], references: [id])
  factura  Factura  @relation(fields: [facturaId], references: [id])

  @@map("comisiones")
}

// ---------------------------------------------------------------------------
// LOGISTICA — COMPRAS (órdenes de compra y recepciones)
// ---------------------------------------------------------------------------

enum EstadoOrdenCompra {
  PENDIENTE
  PARCIAL
  RECIBIDA
  ANULADA
}

model OrdenCompra {
  id              String            @id @default(cuid())
  empresaId       String            @default("1")
  numero          String            @unique // OC-00001
  proveedorId     String
  almacenId       String? // almacén/planta de destino (opcional: si no se elige, la recepción resuelve el almacén como siempre)
  fecha           DateTime          @default(now())
  estado          EstadoOrdenCompra @default(PENDIENTE)
  moneda          String            @default("PEN")
  // Tipo de cambio congelado al crear la orden (S//US$; 1 si moneda=PEN).
  // total queda en `moneda`; todo lo que necesita PEN (umbral de aprobación,
  // cuenta por pagar, asiento contable) se convierte con este valor.
  tipoCambio      Decimal           @default(1)
  total           Decimal
  notas           String?
  motivoAnulacion String?
  usuarioId       String
  usuarioNombre   String

  // Aprobación por monto: se calcula al crear la orden contra el umbral
  // vigente en Configuración → Empresa. Si queda PENDIENTE, no se puede
  // registrar recepción hasta que Gerencia/Admin la apruebe.
  estadoAprobacion EstadoAprobacion @default(NO_REQUERIDA)
  aprobadaPor      String?
  aprobadaEn       DateTime?
  motivoRechazo    String?

  // Etiqueta opcional a un proyecto/fase de obra de capital — el costo real
  // del proyecto se calcula sumando estas OC (estado != ANULADA) más
  // CostoProyecto, sin doble registro.
  proyectoId String?
  edtId      String?

  proveedor       Proveedor            @relation(fields: [proveedorId], references: [id])
  almacen         Almacen?             @relation(fields: [almacenId], references: [id])
  detalles        OrdenCompraDetalle[]
  recepciones     RecepcionCompra[]
  cuentasPorPagar CuentaPorPagar[]
  proyecto        Proyecto?            @relation(fields: [proyectoId], references: [id])
  edt             EdtProyecto?         @relation(fields: [edtId], references: [id])

  @@map("ordenes_compra")
}

model OrdenCompraDetalle {
  id                   String    @id @default(cuid())
  ordenCompraId        String
  insumoId             String
  cantidad             Decimal
  costoUnitario        Decimal
  subtotal             Decimal
  cantidadRecibida     Decimal   @default(0)
  fechaEntregaEsperada DateTime? // fecha pactada con el proveedor para esta línea

  ordenCompra OrdenCompra @relation(fields: [ordenCompraId], references: [id])
  insumo      Insumo      @relation(fields: [insumoId], references: [id])

  @@map("orden_compra_detalles")
}

model RecepcionCompra {
  id            String   @id @default(cuid())
  empresaId     String   @default("1")
  numero        String   @unique // RC-00001
  ordenCompraId String
  fecha         DateTime @default(now())
  notas         String?
  usuarioId     String
  usuarioNombre String

  ordenCompra     OrdenCompra              @relation(fields: [ordenCompraId], references: [id])
  detalles        RecepcionCompraDetalle[]
  cuentasPorPagar CuentaPorPagar[]

  @@map("recepciones_compra")
}

model RecepcionCompraDetalle {
  id                  String  @id @default(cuid())
  recepcionId         String
  insumoId            String
  cantidad            Decimal
  costoUnitario       Decimal // costo real de esta recepción (actualiza el promedio ponderado)
  // Trazabilidad de materia prima: número de lote/certificado del proveedor.
  // cantidadDisponible arranca en `cantidad` cuando el stock queda disponible
  // (de inmediato, o al aprobar inspección de calidad) y baja según se
  // consume en producción (ver AsignacionLoteInsumo) — mismo patrón que
  // Envasado.unidadesDisponibles para la venta.
  numeroLoteProveedor String?
  cantidadDisponible  Decimal @default(0)

  recepcion        RecepcionCompra        @relation(fields: [recepcionId], references: [id])
  insumo           Insumo                 @relation(fields: [insumoId], references: [id])
  inspeccion       InspeccionCompra?
  asignacionesLote AsignacionLoteInsumo[]
  devoluciones     DevolucionCompra[]

  @@map("recepcion_compra_detalles")
}

// Devolución de un insumo/materia prima a su proveedor (defecto, no
// conformidad detectada después de recibido). Reduce el stock físico, cancela
// la CxP abierta y conserva cualquier excedente como activo recuperable en el
// subledger del proveedor. El comprobante lo emite el proveedor, no XXOil.
model DevolucionCompra {
  id                       String   @id @default(cuid())
  empresaId                String   @default("1")
  recepcionCompraDetalleId String
  cantidad                 Decimal
  motivo                   String
  montoCredito             Decimal // importe en moneda de la OC para trazabilidad
  montoFuncional           Decimal  @default(0) // valor en PEN usado por CxP y contabilidad
  usuarioId                String
  usuarioNombre            String
  creadoEn                 DateTime @default(now())

  recepcionCompraDetalle RecepcionCompraDetalle @relation(fields: [recepcionCompraDetalleId], references: [id])
  credito                CreditoProveedor?

  @@map("devoluciones_compra")
}

enum EstadoCreditoProveedor {
  DISPONIBLE
  AGOTADO
}

model CreditoProveedor {
  id                     String                 @id @default(cuid())
  empresaId              String                 @default("1")
  proveedorId            String
  devolucionCompraId     String                 @unique
  montoFuncionalOriginal Decimal
  saldoFuncional         Decimal
  estado                 EstadoCreditoProveedor @default(DISPONIBLE)
  creadoEn               DateTime               @default(now())

  proveedor    Proveedor                    @relation(fields: [proveedorId], references: [id])
  devolucion   DevolucionCompra             @relation(fields: [devolucionCompraId], references: [id])
  aplicaciones AplicacionCreditoProveedor[]
  reembolsos   ReembolsoProveedor[]

  @@index([proveedorId, estado])
  @@map("creditos_proveedor")
}

model AplicacionCreditoProveedor {
  id               String   @id @default(cuid())
  empresaId        String   @default("1")
  creditoId        String
  cuentaPorPagarId String
  fecha            DateTime @default(now())
  montoFuncional   Decimal
  usuarioId        String
  usuarioNombre    String

  credito        CreditoProveedor @relation(fields: [creditoId], references: [id])
  cuentaPorPagar CuentaPorPagar   @relation(fields: [cuentaPorPagarId], references: [id])

  @@index([creditoId])
  @@index([cuentaPorPagarId])
  @@map("aplicaciones_credito_proveedor")
}

model ReembolsoProveedor {
  id             String    @id @default(cuid())
  empresaId      String    @default("1")
  creditoId      String
  fecha          DateTime  @default(now())
  montoFuncional Decimal
  medioPago      MedioPago
  referencia     String?
  usuarioId      String
  usuarioNombre  String

  credito CreditoProveedor @relation(fields: [creditoId], references: [id])

  @@index([creditoId])
  @@map("reembolsos_proveedor")
}

// Ledger de consumo (solo ida, sin reversos: un LoteGranel no se "anula")
// que permite responder, ante un problema de calidad de materia prima,
// "¿qué lotes granel consumieron el lote de proveedor X?".
model AsignacionLoteInsumo {
  id                       String   @id @default(cuid())
  loteGranelId             String
  recepcionCompraDetalleId String
  cantidad                 Decimal
  creadoEn                 DateTime @default(now())

  loteGranel                      LoteGranel                       @relation(fields: [loteGranelId], references: [id])
  recepcionCompraDetalle          RecepcionCompraDetalle           @relation(fields: [recepcionCompraDetalleId], references: [id])
  devolucionAsignacionLoteInsumos DevolucionAsignacionLoteInsumo[]

  @@map("asignaciones_lote_insumo")
}

enum ResultadoInspeccion {
  PENDIENTE
  APROBADO
  RECHAZADO
}

// Inspección de calidad al recibir insumos marcados con requiereInspeccion:
// la cantidad recibida no suma stock (ni recalcula el costo promedio) hasta
// que se aprueba aquí. Un rechazo nunca entra al kardex (devolución al
// proveedor se maneja fuera del sistema, igual que las notas de crédito).
model InspeccionCompra {
  id                       String              @id @default(cuid())
  recepcionCompraDetalleId String              @unique
  resultado                ResultadoInspeccion @default(PENDIENTE)
  observaciones            String?
  usuarioId                String?
  usuarioNombre            String?
  fecha                    DateTime?
  creadoEn                 DateTime            @default(now())
  planInspeccionId         String?
  planVersion              Int?

  recepcionDetalle RecepcionCompraDetalle     @relation(fields: [recepcionCompraDetalleId], references: [id])
  planInspeccion   PlanInspeccionInsumo?      @relation(fields: [planInspeccionId], references: [id])
  mediciones       MedicionInspeccionCompra[]

  @@map("inspecciones_compra")
}

model PlanInspeccionInsumo {
  id            String    @id @default(cuid())
  empresaId     String    @default("1")
  insumoId      String
  version       Int
  nombre        String
  activo        Boolean   @default(true)
  vigenteDesde  DateTime  @default(now())
  vigenteHasta  DateTime?
  usuarioId     String
  usuarioNombre String
  creadoEn      DateTime  @default(now())

  insumo          Insumo                     @relation(fields: [insumoId], references: [id])
  caracteristicas CaracteristicaPlanInsumo[]
  inspecciones    InspeccionCompra[]

  @@unique([insumoId, version])
  @@index([empresaId, activo])
  @@map("planes_inspeccion_insumo")
}

model CaracteristicaPlanInsumo {
  id             String   @id @default(cuid())
  planId         String
  secuencia      Int
  nombre         String
  unidadMedida   String
  limiteInferior Decimal?
  limiteSuperior Decimal?
  metodoEnsayo   String?
  obligatoria    Boolean  @default(true)

  plan PlanInspeccionInsumo @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, secuencia])
  @@map("caracteristicas_plan_insumo")
}

model MedicionInspeccionCompra {
  id                 String   @id @default(cuid())
  inspeccionCompraId String
  secuencia          Int
  nombre             String
  unidadMedida       String
  limiteInferior     Decimal?
  limiteSuperior     Decimal?
  metodoEnsayo       String?
  valorMedido        Decimal
  conforme           Boolean

  inspeccion InspeccionCompra @relation(fields: [inspeccionCompraId], references: [id], onDelete: Cascade)

  @@unique([inspeccionCompraId, secuencia])
  @@map("mediciones_inspeccion_compra")
}

// ---------------------------------------------------------------------------
// LOGISTICA — GUIAS DE REMISION (traslado de mercadería, formato SUNAT)
// ---------------------------------------------------------------------------

enum EstadoDespacho {
  PLANIFICADO
  EN_RUTA
  ENTREGADO
  ANULADO
}

// Catálogo 20 de SUNAT: determina qué otro dato es obligatorio (público
// exige el RUC del transportista; privado exige placa + DNI del conductor,
// ya existentes en el modelo).
enum ModalidadTransporte {
  PUBLICO
  PRIVADO
}

model GuiaRemision {
  id                  String              @id @default(cuid())
  empresaId           String              @default("1")
  numero              String              @unique // ej. T001-00000001
  facturaId           String?
  pedidoId            String?
  clienteId           String
  fechaTraslado       DateTime
  puntoPartida        String
  puntoLlegada        String
  // Código UBIGEO (6 dígitos) de SUNAT — obligatorio para el XML, distinto
  // de puntoPartida/puntoLlegada (que son la dirección textual impresa).
  ubigeoPartidaId     String?
  ubigeoLlegadaId     String?
  motivoTraslado      String              @default("Venta")
  // Obligatorio para SUNAT (Catálogo 3, unidad KGM) — sin este dato el XML
  // de la guía es inválido.
  pesoBrutoTotal      Decimal             @default(0)
  modalidadTransporte ModalidadTransporte @default(PRIVADO)
  transportista       String?
  // RUC de la empresa transportista — obligatorio cuando modalidadTransporte
  // = PUBLICO (transporte contratado a terceros, no flota propia).
  transportistaRuc    String?
  placaVehiculo       String?
  dniConductor        String?
  observaciones       String?
  // Vehículo de flota propia que ejecuta el despacho (opcional: un
  // transportista externo puntual no tiene Equipo que vincular). Da
  // visibilidad real de la flota — de qué vehículo salió cada guía — y
  // conecta con su historial de mantenimiento.
  equipoId            String?
  estadoDespacho      EstadoDespacho      @default(PLANIFICADO)
  fechaSalida         DateTime?
  fechaEntrega        DateTime?
  anuladaEn           DateTime?
  anuladaPorId        String?
  anuladaPorNombre    String?
  motivoAnulacion     String?
  usuarioId           String
  usuarioNombre       String
  creadoEn            DateTime            @default(now())

  factura       Factura?              @relation(fields: [facturaId], references: [id])
  pedido        Pedido?               @relation(fields: [pedidoId], references: [id])
  cliente       Cliente               @relation(fields: [clienteId], references: [id])
  equipo        Equipo?               @relation(fields: [equipoId], references: [id])
  ubigeoPartida Ubigeo?               @relation("UbigeoPartida", fields: [ubigeoPartidaId], references: [id])
  ubigeoLlegada Ubigeo?               @relation("UbigeoLlegada", fields: [ubigeoLlegadaId], references: [id])
  detalles      GuiaRemisionDetalle[]

  @@index([pedidoId])
  @@map("guias_remision")
}

// Catálogo oficial SUNAT de códigos UBIGEO (INEI/RENIEC/SUNAT no siempre
// coinciden — este modelo usa específicamente el código SUNAT, que es el
// que exige el XML de la guía). Sembrado desde prisma/data/ubigeos.json
// (fuente: CONCYTEC, derivado del Excel oficial que SUNAT publica).
model Ubigeo {
  id           String @id @default(cuid())
  codigo       String @unique // 6 dígitos
  departamento String
  provincia    String
  distrito     String

  guiasPartida GuiaRemision[] @relation("UbigeoPartida")
  guiasLlegada GuiaRemision[] @relation("UbigeoLlegada")

  @@map("ubigeos")
}

model GuiaRemisionDetalle {
  id              String  @id @default(cuid())
  guiaId          String
  presentacionId  String
  pedidoDetalleId String?
  cantidad        Int
  costoUnitario   Decimal @default(0)

  guia                GuiaRemision            @relation(fields: [guiaId], references: [id])
  presentacion        Presentacion            @relation(fields: [presentacionId], references: [id])
  pedidoDetalle       PedidoDetalle?          @relation(fields: [pedidoDetalleId], references: [id])
  facturaAsignaciones FacturaDetalleEntrega[]
  asignacionesLote    AsignacionLoteVenta[]

  @@index([pedidoDetalleId])
  @@map("guia_remision_detalles")
}

model FacturaDetalleEntrega {
  id               String @id @default(cuid())
  facturaDetalleId String
  guiaDetalleId    String
  cantidad         Int

  facturaDetalle FacturaDetalle      @relation(fields: [facturaDetalleId], references: [id])
  guiaDetalle    GuiaRemisionDetalle @relation(fields: [guiaDetalleId], references: [id])

  @@unique([facturaDetalleId, guiaDetalleId])
  @@index([guiaDetalleId])
  @@map("factura_detalle_entregas")
}

// ---------------------------------------------------------------------------
// FINANZAS — CUENTAS POR PAGAR Y CAJA
// ---------------------------------------------------------------------------

enum EstadoCuentaPorPagar {
  PENDIENTE
  PAGADA
}

model CuentaPorPagar {
  id                    String               @id @default(cuid())
  empresaId             String               @default("1")
  proveedorId           String
  ordenCompraId         String?
  recepcionCompraId     String? // recepción que originó esta CxP (para poder aplicar devoluciones)
  numeroDocumento       String // factura del proveedor, formato "serie-número" (ej. F001-123)
  // Código de Tabla 10 de SUNAT (01 Factura, 03 Boleta, 04 Liquidación de
  // compra, 91 comprobante de no domiciliado, etc.) — para el Registro de
  // Compras Electrónico (PLE). Default Factura, el caso normal en compras B2B.
  tipoComprobante       String               @default("01")
  fechaEmision          DateTime             @default(now())
  fechaVencimiento      DateTime?
  moneda                String               @default("PEN")
  total                 Decimal // siempre en PEN (moneda funcional)
  saldo                 Decimal // siempre en PEN
  // Referencia informativa cuando la compra original fue en otra moneda
  // (ej. USD): monto/moneda tal como llegó la factura del proveedor, y el
  // tipo de cambio usado para convertir total/saldo a PEN. null si ya nació
  // en PEN — no es una revaluación, solo trazabilidad.
  montoOriginal         Decimal?
  monedaOriginal        String?
  tipoCambio            Decimal?
  // % de variación entre el costo unitario registrado en la recepción y el
  // costo pactado en la orden de compra (verificación de factura en 3 vías:
  // orden↔recepción↔lo que se está por pagar). null = sin discrepancia
  // detectada o por debajo de la tolerancia (5%). No bloquea el pago — solo
  // lo señala, porque el sistema no debe ser rígido ante regularizaciones.
  discrepanciaPrecioPct Decimal?
  estado                EstadoCuentaPorPagar @default(PENDIENTE)
  usuarioId             String
  usuarioNombre         String

  proveedor           Proveedor                    @relation(fields: [proveedorId], references: [id])
  ordenCompra         OrdenCompra?                 @relation(fields: [ordenCompraId], references: [id])
  recepcionCompra     RecepcionCompra?             @relation(fields: [recepcionCompraId], references: [id])
  pagos               PagoProveedor[]
  aplicacionesCredito AplicacionCreditoProveedor[]

  @@map("cuentas_por_pagar")
}

model PagoProveedor {
  id               String    @id @default(cuid())
  empresaId        String    @default("1")
  cuentaPorPagarId String
  fecha            DateTime  @default(now())
  monto            Decimal
  medioPago        MedioPago
  referencia       String?
  usuarioId        String
  usuarioNombre    String

  // Aprobación por monto: si queda PENDIENTE, el pago se registra pero NO
  // se descuenta de caja ni del saldo de la cuenta hasta que se apruebe
  // (separa "quien pide el pago" de "quien dispone del dinero").
  estadoAprobacion EstadoAprobacion @default(NO_REQUERIDA)
  aprobadoPor      String?
  aprobadoEn       DateTime?
  motivoRechazo    String?

  cuentaPorPagar CuentaPorPagar @relation(fields: [cuentaPorPagarId], references: [id])

  @@map("pagos_proveedor")
}

enum TipoMovimientoCaja {
  INGRESO
  EGRESO
}

// Libro de caja: los cobros de facturas y pagos a proveedores generan
// movimientos automáticos; también admite movimientos manuales con concepto.
model MovimientoCaja {
  id               String             @id @default(cuid())
  empresaId        String             @default("1")
  fecha            DateTime           @default(now())
  tipo             TipoMovimientoCaja
  concepto         String
  monto            Decimal
  moneda           String             @default("PEN")
  tipoCambio       Decimal            @default(1)
  montoOriginal    Decimal?
  medioPago        MedioPago
  referencia       String? // nro de factura, OC, comisión, etc.
  usuarioId        String
  usuarioNombre    String
  cuentaBancariaId String?

  cuentaBancaria CuentaBancariaEmpresa?           @relation(fields: [cuentaBancariaId], references: [id])
  conciliaciones ConciliacionBancariaAplicacion[]

  @@index([cuentaBancariaId, fecha])
  @@map("movimientos_caja")
}

enum EstadoConciliacionBancaria {
  BORRADOR
  CERRADA
  ANULADA
}

model ConciliacionBancaria {
  id                   String                     @id @default(cuid())
  empresaId            String                     @default("1")
  cuentaBancariaId     String
  fechaDesde           DateTime
  fechaHasta           DateTime
  saldoInicialExtracto Decimal
  saldoFinalExtracto   Decimal
  estado               EstadoConciliacionBancaria @default(BORRADOR)
  cerradaEn            DateTime?
  cerradaPorId         String?
  cerradaPorNombre     String?
  anuladaEn            DateTime?
  anuladaPorId         String?
  anuladaPorNombre     String?
  motivoAnulacion      String?
  usuarioId            String
  usuarioNombre        String
  creadoEn             DateTime                   @default(now())

  cuentaBancaria CuentaBancariaEmpresa        @relation(fields: [cuentaBancariaId], references: [id])
  movimientos    MovimientoExtractoBancario[]

  @@unique([cuentaBancariaId, fechaDesde, fechaHasta])
  @@index([empresaId, estado])
  @@map("conciliaciones_bancarias")
}

model MovimientoExtractoBancario {
  id             String             @id @default(cuid())
  conciliacionId String
  fecha          DateTime
  tipo           TipoMovimientoCaja
  descripcion    String
  referencia     String?
  monto          Decimal
  huella         String
  creadoEn       DateTime           @default(now())

  conciliacion ConciliacionBancaria             @relation(fields: [conciliacionId], references: [id])
  aplicaciones ConciliacionBancariaAplicacion[]

  @@unique([conciliacionId, huella])
  @@index([conciliacionId, fecha])
  @@map("movimientos_extracto_bancario")
}

model ConciliacionBancariaAplicacion {
  id                   String   @id @default(cuid())
  movimientoExtractoId String
  movimientoCajaId     String
  monto                Decimal
  usuarioId            String
  usuarioNombre        String
  creadoEn             DateTime @default(now())

  movimientoExtracto MovimientoExtractoBancario @relation(fields: [movimientoExtractoId], references: [id])
  movimientoCaja     MovimientoCaja             @relation(fields: [movimientoCajaId], references: [id])

  @@unique([movimientoExtractoId, movimientoCajaId])
  @@index([movimientoCajaId])
  @@map("conciliaciones_bancarias_aplicaciones")
}

// ---------------------------------------------------------------------------
// COMERCIAL — HOJAS DE RUTA DE VENDEDORES
// ---------------------------------------------------------------------------

enum EstadoHojaRuta {
  PLANIFICADA
  COMPLETADA
}

model HojaRuta {
  id            String         @id @default(cuid())
  empresaId     String         @default("1")
  numero        String         @unique // HR-00001
  vendedorId    String
  fecha         DateTime
  estado        EstadoHojaRuta @default(PLANIFICADA)
  notas         String?
  usuarioId     String
  usuarioNombre String
  creadoEn      DateTime       @default(now())

  vendedor Vendedor         @relation(fields: [vendedorId], references: [id])
  visitas  HojaRutaVisita[]

  @@map("hojas_ruta")
}

model HojaRutaVisita {
  id         String  @id @default(cuid())
  hojaRutaId String
  clienteId  String
  orden      Int
  objetivo   String? // cobrar, ofrecer producto nuevo, etc.
  resultado  String? // se llena al cerrar la ruta

  hojaRuta HojaRuta @relation(fields: [hojaRutaId], references: [id])
  cliente  Cliente  @relation(fields: [clienteId], references: [id])

  @@map("hoja_ruta_visitas")
}

// ---------------------------------------------------------------------------
// SYSTEM SETUP — FASE 2 (equivalente reducido a los programas de
// configuración de sistema de Epicor: Legal Numbers, Warehouse/Warehouse
// Zone, UOM Maintenance, Security Group Maintenance, Fiscal Calendar).
// ---------------------------------------------------------------------------

// --- Numeración legal de documentos (Legal Number / Document Type) ---------

enum TipoDocumentoSerie {
  FACTURA
  NOTA_CREDITO
  GUIA_REMISION
}

// Catálogo de series SUNAT (F001, T001, FC01...). El correlativo es solo una
// sugerencia editable: el número real lo asigna SUNAT al emitir; aquí se
// transcribe. Avanza cuando se usa la serie al crear el documento.
model SerieDocumento {
  id                String             @id @default(cuid())
  empresaId         String             @default("1")
  tipoDocumento     TipoDocumentoSerie
  serie             String // ej. F001, T001, FC01
  correlativoActual Int                @default(0)
  activo            Boolean            @default(true)
  creadoEn          DateTime           @default(now())

  @@unique([empresaId, tipoDocumento, serie])
  @@map("series_documento")
}

// --- Almacenes y zonas (Warehouse / Warehouse Zone) -------------------------

model Almacen {
  id           String   @id @default(cuid())
  empresaId    String   @default("1")
  codigo       String
  nombre       String
  direccion    String?
  direccion2   String?
  ciudad       String?
  distrito     String?
  provincia    String?
  departamento String?
  codigoPostal String?
  pais         String   @default("Perú")
  encargado    String?
  activo       Boolean  @default(true)
  creadoEn     DateTime @default(now())

  zonas                ZonaAlmacen[]
  calendarioProduccion CalendarioProduccion?
  saldos               SaldoAlmacen[]
  movimientosKardex    MovimientoKardex[]
  activosFijos         ActivoFijo[]
  equipos              Equipo[]
  ordenesCompra        OrdenCompra[]
  centrosCosto         CentroCosto[]
  centrosTrabajo       CentroTrabajo[]
  empleados            Empleado[]
  pedidos              Pedido[]
  devolucionesCliente  DevolucionCliente[]

  @@unique([empresaId, codigo])
  @@map("almacenes")
}

// Calendario de producción por almacén/planta: horas laborables por día de
// semana + excepciones (feriados, mantenimiento). Reemplaza el número único
// que usaba Proyecciones para el chequeo de capacidad.
model CalendarioProduccion {
  id        String @id @default(cuid())
  almacenId String @unique

  horasLunes     Decimal @default(8)
  horasMartes    Decimal @default(8)
  horasMiercoles Decimal @default(8)
  horasJueves    Decimal @default(8)
  horasViernes   Decimal @default(8)
  horasSabado    Decimal @default(0)
  horasDomingo   Decimal @default(0)

  almacen          Almacen          @relation(fields: [almacenId], references: [id], onDelete: Cascade)
  diasNoLaborables DiaNoLaborable[]

  @@map("calendarios_produccion")
}

model DiaNoLaborable {
  id           String   @id @default(cuid())
  calendarioId String
  fecha        DateTime
  motivo       String? // "Feriado nacional", "Mantenimiento", etc.

  calendario CalendarioProduccion @relation(fields: [calendarioId], references: [id], onDelete: Cascade)

  @@unique([calendarioId, fecha])
  @@map("dias_no_laborables")
}

model ZonaAlmacen {
  id        String  @id @default(cuid())
  almacenId String
  codigo    String // ej. A-01, RACK-2
  nombre    String?
  activo    Boolean @default(true)

  almacen        Almacen        @relation(fields: [almacenId], references: [id])
  presentaciones Presentacion[]
  insumos        Insumo[]

  @@unique([almacenId, codigo])
  @@map("zonas_almacen")
}

// --- Unidades de medida (UOM Class / UOM Maintenance) -----------------------

model ClaseUnidadMedida {
  id        String   @id @default(cuid())
  empresaId String   @default("1")
  codigo    String // ej. PESO, VOLUMEN, CANTIDAD
  nombre    String
  activo    Boolean  @default(true)
  creadoEn  DateTime @default(now())

  unidades UnidadMedida[]

  @@unique([empresaId, codigo])
  @@map("clases_unidad_medida")
}

model UnidadMedida {
  id      String  @id @default(cuid())
  claseId String
  codigo  String // ej. kg, litro, galon, unidad
  nombre  String // ej. Kilogramo
  activo  Boolean @default(true)

  clase ClaseUnidadMedida @relation(fields: [claseId], references: [id])

  @@unique([claseId, codigo])
  @@map("unidades_medida")
}

// --- Grupos de seguridad (Security Group Maintenance) -----------------------
//
// Aplicado de verdad: puedeRealizar() (src/lib/permisos.ts) consulta estos
// permisos y su resultado SÍ bloquea crear/editar/aprobar en las acciones de
// cada módulo — no es solo referencia. Los 4 roles existentes (RolUsuario) se
// muestran como grupos predefinidos no editables porque el acceso base a cada
// pantalla sigue viniendo de requerirRol(); un grupo personalizado asignado a
// un usuario solo puede RESTRINGIR una acción dentro de lo que su rol ya
// permite, nunca ampliarla.

model GrupoSeguridad {
  id            String   @id @default(cuid())
  empresaId     String   @default("1")
  codigo        String
  nombre        String
  esPredefinido Boolean  @default(false)
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now())

  permisos PermisoGrupo[]
  usuarios Usuario[]

  @@unique([empresaId, codigo])
  @@map("grupos_seguridad")
}

model PermisoGrupo {
  id           String  @id @default(cuid())
  grupoId      String
  modulo       String // ventas | materiales | produccion | finanzas | rrhh | configuracion
  puedeVer     Boolean @default(true)
  puedeCrear   Boolean @default(false)
  puedeEditar  Boolean @default(false)
  // Segregación de funciones: separado de editar porque aprobar/rechazar
  // (órdenes de compra, pagos, vacaciones) es una autoridad distinta a la de
  // quien crea o edita el registro.
  puedeAprobar Boolean @default(true)

  grupo GrupoSeguridad @relation(fields: [grupoId], references: [id])

  @@unique([grupoId, modulo])
  @@map("permisos_grupo")
}

// --- Calendario fiscal (Fiscal Calendar) ------------------------------------

enum EstadoPeriodoFiscal {
  ABIERTO
  CERRADO
}

model PeriodoFiscal {
  id         String              @id @default(cuid())
  empresaId  String              @default("1")
  anio       Int
  mes        Int // 1-12
  estado     EstadoPeriodoFiscal @default(ABIERTO)
  cerradoEn  DateTime?
  cerradoPor String?

  @@unique([empresaId, anio, mes])
  @@map("periodos_fiscales")
}

// ---------------------------------------------------------------------------
// CONTABILIDAD — FASE 3 (equivalente reducido al General Ledger de Epicor:
// Chart of Accounts, Books, Journal Entry, GL Controls).
//
// Principio: los asientos son inmutables — nunca se editan ni borran; una
// corrección se hace con un asiento de reverso (mismo patrón del kardex).
// ---------------------------------------------------------------------------

enum TipoCuenta {
  ACTIVO
  PASIVO
  PATRIMONIO
  INGRESO
  GASTO
}

model PlanCuentas {
  id        String   @id @default(cuid())
  empresaId String   @default("1")
  codigo    String // ej. PCGE (Plan Contable General Empresarial)
  nombre    String
  esMaestro Boolean  @default(false)
  creadoEn  DateTime @default(now())

  cuentas CuentaContable[]

  @@unique([empresaId, codigo])
  @@map("planes_cuentas")
}

model CuentaContable {
  id            String     @id @default(cuid())
  planCuentasId String
  codigo        String // ej. 1041, 1212, 7011 (estilo PCGE)
  nombre        String
  tipo          TipoCuenta
  activo        Boolean    @default(true)
  creadoEn      DateTime   @default(now())

  planCuentas PlanCuentas       @relation(fields: [planCuentasId], references: [id])
  detalles    AsientoDetalle[]
  controles   ControlContable[]

  @@unique([planCuentasId, codigo])
  @@map("cuentas_contables")
}

model Libro {
  id        String   @id @default(cuid())
  empresaId String   @default("1")
  codigo    String // ej. DIARIO
  nombre    String
  moneda    String   @default("PEN")
  creadoEn  DateTime @default(now())

  asientos AsientoContable[]

  @@unique([empresaId, codigo])
  @@map("libros")
}

enum OrigenAsiento {
  MANUAL
  VENTA
  SALIDA_MERCANCIA
  DEVOLUCION_CLIENTE
  COBRO
  NOTA_CREDITO
  APLICACION_CREDITO_CLIENTE
  REEMBOLSO_CLIENTE
  ANULACION_VENTA
  RECARGO_MORA
  COMPRA
  PAGO_PROVEEDOR
  DEPRECIACION
  MANTENIMIENTO
  VENTA_ACTIVO_FIJO
  REVERSO
  DEVOLUCION_COMPRA
  APLICACION_CREDITO_PROVEEDOR
  REEMBOLSO_PROVEEDOR
  PLANILLA
  GRATIFICACION
  CTS
  LIQUIDACION
  ORDEN_INTERNA
  RECLASIFICACION_COSTO
  INICIO_PRODUCCION
  MANO_OBRA_PRODUCCION
  ENVASADO_PRODUCCION
  DESECHO_PRODUCCION
}

model AsientoContable {
  id            String        @id @default(cuid())
  empresaId     String        @default("1")
  libroId       String
  numero        String        @unique // AS-00001
  fecha         DateTime      @default(now())
  anio          Int // período fiscal al que pertenece
  mes           Int
  origen        OrigenAsiento @default(MANUAL)
  glosa         String // descripción del asiento
  referencia    String? // nro de factura, OC, etc.
  reversadoPor  String? // numero del asiento de reverso, si existe
  reversaA      String? // numero del asiento que este asiento reversa
  usuarioId     String
  usuarioNombre String
  creadoEn      DateTime      @default(now())

  libro    Libro            @relation(fields: [libroId], references: [id])
  detalles AsientoDetalle[]

  @@index([anio, mes])
  @@map("asientos_contables")
}

model AsientoDetalle {
  id            String  @id @default(cuid())
  asientoId     String
  cuentaId      String
  centroCostoId String? // dimensión de centro de costo (opcional; ver CentroCostoControl)
  glosa         String?
  debe          Decimal @default(0)
  haber         Decimal @default(0)

  asiento     AsientoContable @relation(fields: [asientoId], references: [id])
  cuenta      CuentaContable  @relation(fields: [cuentaId], references: [id])
  centroCosto CentroCosto?    @relation(fields: [centroCostoId], references: [id])

  @@index([cuentaId])
  @@index([centroCostoId])
  @@map("asiento_detalles")
}

// Mapa transacción → cuenta contable (GL Controls de Epicor). Cada clave la
// usa la contabilización automática; si falta, la transacción operativa se
// registra igual pero sin asiento (se avisa en la pantalla de controles).
model ControlContable {
  id        String @id @default(cuid())
  empresaId String @default("1")
  clave     String // CUENTAS_POR_COBRAR, VENTAS, IGV_POR_PAGAR, COSTO_VENTAS,
  //                  INVENTARIO_PT, INVENTARIO_INSUMOS, CAJA_BANCOS,
  //                  CUENTAS_POR_PAGAR, DEVOLUCIONES
  cuentaId  String

  cuenta CuentaContable @relation(fields: [cuentaId], references: [id])

  @@unique([empresaId, clave])
  @@map("controles_contables")
}

// ---------------------------------------------------------------------------
// FINANZAS — CENTROS DE COSTO (contabilidad de gestión, estilo SAP CO)
//
// Independiente del plan de cuentas: el plan de cuentas dice QUÉ es el gasto
// (naturaleza — depreciación, mantenimiento, sueldos); el centro de costo
// dice DÓNDE se originó (planta, ventas, administración). Un mismo gasto
// puede repartirse entre varios centros mediante una regla de prorrateo.
// ---------------------------------------------------------------------------

enum TipoCentroCosto {
  PRODUCCION
  VENTAS
  ADMINISTRACION
  LOGISTICA
  OTRO
}

model CentroCosto {
  id        String          @id @default(cuid())
  empresaId String          @default("1")
  codigo    String // CC-PLANTA, CC-VENTAS
  nombre    String
  tipo      TipoCentroCosto
  almacenId String? // opcional: si el centro corresponde a una planta/almacén físico
  activo    Boolean         @default(true)
  creadoEn  DateTime        @default(now())

  almacen              Almacen?                      @relation(fields: [almacenId], references: [id])
  presupuestos         PresupuestoCentroCosto[]
  asientos             AsientoDetalle[]
  controles            CentroCostoControl[]
  reglaLineas          ReglaAsignacionCostoDetalle[]
  equipos              Equipo[]
  activosFijos         ActivoFijo[]
  ordenesMantenimiento OrdenMantenimiento[]
  empleados            Empleado[]
  planesMantenimiento  PlanMantenimiento[]
  ordenesInternas      OrdenInterna[]
  proyectos            Proyecto[]
  centrosTrabajo       CentroTrabajo[]

  @@unique([empresaId, codigo])
  @@map("centros_costo")
}

// Presupuesto mensual por centro, para el reporte de variación (presupuesto
// vs. real). Cargado a mano por Gerencia/Finanzas al planificar el período.
model PresupuestoCentroCosto {
  id                 String   @id @default(cuid())
  centroCostoId      String
  anio               Int
  mes                Int
  montoPresupuestado Decimal
  usuarioId          String
  usuarioNombre      String
  creadoEn           DateTime @default(now())

  centroCosto CentroCosto @relation(fields: [centroCostoId], references: [id])

  @@unique([centroCostoId, anio, mes])
  @@map("presupuestos_centro_costo")
}

enum EstadoOrdenInterna {
  ABIERTA
  LIQUIDADA
  ANULADA
}

// Objeto de costeo genérico y temporal (equivalente reducido a la Orden
// Interna de SAP CO-OM-OPA): junta costos de fuentes heterogéneas para un
// propósito puntual (una campaña, un evento, un proyecto corto) que no
// justifica un centro de costo permanente. Al liquidar, el total acumulado
// se contabiliza de una vez contra el centro de costo de destino.
model OrdenInterna {
  id               String             @id @default(cuid())
  empresaId        String             @default("1")
  codigo           String             @unique // OI-00001
  descripcion      String
  // Destino sugerido al crear; se confirma (o cambia) recién al liquidar.
  centroCostoId    String?
  presupuesto      Decimal? // tope informativo, no bloqueante
  totalAcumulado   Decimal            @default(0)
  estado           EstadoOrdenInterna @default(ABIERTA)
  fechaInicio      DateTime           @default(now())
  fechaLiquidacion DateTime?
  usuarioId        String
  usuarioNombre    String
  creadoEn         DateTime           @default(now())

  centroCosto CentroCosto?        @relation(fields: [centroCostoId], references: [id])
  costos      OrdenInternaCosto[]

  @@map("ordenes_internas")
}

model OrdenInternaCosto {
  id             String   @id @default(cuid())
  ordenInternaId String
  concepto       String
  monto          Decimal
  fecha          DateTime @default(now())
  usuarioId      String
  usuarioNombre  String

  ordenInterna OrdenInterna @relation(fields: [ordenInternaId], references: [id])

  @@map("orden_interna_costos")
}

// Prorrateo automático: cuando una clave de control (ej. GASTO_DEPRECIACION)
// no corresponde a un solo centro sino que se reparte entre varios (ej. la
// depreciación de una mezcladora que sirve a Planta y a Logística), esta
// regla define el % que le toca a cada uno. Los porcentajes de sus líneas
// deben sumar 100 (se valida al guardar, no en la base).
model ReglaAsignacionCosto {
  id       String   @id @default(cuid())
  nombre   String // "Depreciación prorrateada Planta/Logística"
  activo   Boolean  @default(true)
  creadoEn DateTime @default(now())

  lineas    ReglaAsignacionCostoDetalle[]
  controles CentroCostoControl[]

  @@map("reglas_asignacion_costo")
}

model ReglaAsignacionCostoDetalle {
  id            String  @id @default(cuid())
  reglaId       String
  centroCostoId String
  porcentaje    Decimal // 0-100

  regla       ReglaAsignacionCosto @relation(fields: [reglaId], references: [id], onDelete: Cascade)
  centroCosto CentroCosto          @relation(fields: [centroCostoId], references: [id])

  @@unique([reglaId, centroCostoId])
  @@map("reglas_asignacion_costo_detalles")
}

// Qué centro (o regla de prorrateo) le corresponde a cada clave de control
// contable. Exactamente uno de los dos debe estar definido, nunca ambos —
// se valida en el server action, no en la base. Si una clave no tiene
// entrada acá, el asiento se postea igual pero sin centro de costo
// (best-effort, como el resto del motor contable).
model CentroCostoControl {
  id            String  @id @default(cuid())
  empresaId     String  @default("1")
  clave         String // mismo universo que ControlContable.clave
  centroCostoId String?
  reglaId       String?

  centroCosto CentroCosto?          @relation(fields: [centroCostoId], references: [id])
  regla       ReglaAsignacionCosto? @relation(fields: [reglaId], references: [id])

  @@unique([empresaId, clave])
  @@map("centro_costo_controles")
}

// ---------------------------------------------------------------------------
// FINANZAS — ACTIVOS FIJOS Y DEPRECIACIÓN (línea recta, la más simple y la
// que exige la SUNAT como método por defecto salvo pedido expreso de otro).
// ---------------------------------------------------------------------------

enum CategoriaActivoFijo {
  MAQUINARIA
  VEHICULO
  EQUIPO_OFICINA
  INMUEBLE
  OTRO
}

model ActivoFijo {
  id                    String              @id @default(cuid())
  empresaId             String              @default("1")
  codigo                String // AF-00001
  nombre                String
  categoria             CategoriaActivoFijo
  almacenId             String?
  fechaAdquisicion      DateTime
  costoAdquisicion      Decimal
  valorResidual         Decimal             @default(0)
  vidaUtilAnios         Int
  // Se actualiza con cada DepreciacionActivo (nunca se edita a mano — mismo
  // principio que el kardex: la historia se compensa, no se sobrescribe).
  depreciacionAcumulada Decimal             @default(0)
  activo                Boolean             @default(true) // false = dado de baja
  fechaBaja             DateTime?
  motivoBaja            String?
  precioVenta           Decimal? // si se vendió el activo (no un castigo puro): precio de venta pactado
  notas                 String?
  centroCostoId         String?
  usuarioId             String
  usuarioNombre         String
  creadoEn              DateTime            @default(now())

  // Si el activo se generó capitalizando un Proyecto (obra de capital), queda
  // enlazado acá — solo trazabilidad, no participa en el cálculo de depreciación.
  proyectoId String?

  almacen        Almacen?             @relation(fields: [almacenId], references: [id])
  depreciaciones DepreciacionActivo[]
  equipo         Equipo?
  centroCosto    CentroCosto?         @relation(fields: [centroCostoId], references: [id])
  proyecto       Proyecto?            @relation(fields: [proyectoId], references: [id])

  @@unique([empresaId, codigo])
  @@map("activos_fijos")
}

// Ledger inmutable de cargos de depreciación mensual — nunca se edita ni se
// borra; @@unique evita cargar el mismo mes dos veces para el mismo activo.
model DepreciacionActivo {
  id           String   @id @default(cuid())
  activoFijoId String
  anio         Int
  mes          Int
  monto        Decimal
  creadoEn     DateTime @default(now())

  activoFijo ActivoFijo @relation(fields: [activoFijoId], references: [id])

  @@unique([activoFijoId, anio, mes])
  @@map("depreciaciones_activo")
}

// ---------------------------------------------------------------------------
// PROYECTOS DE INVERSIÓN / OBRAS DE CAPITAL (PS reducido, ver
// docs/gobernanza/05-disparadores-fase3-diferida.md). Gestión de WBS +
// red de actividades con ruta crítica para obras de capital propio
// (ampliación de planta, nueva línea) — no para proyectos de cliente.
// Solo precedencia Fin-a-Inicio, sin nivelación de capacidad, sin
// calendario de días hábiles: alcance deliberado para 1-3 proyectos a la vez.
// ---------------------------------------------------------------------------

enum EstadoProyecto {
  PLANIFICADO
  EN_PROGRESO
  CERRADO
  CANCELADO
}

model Proyecto {
  id               String         @id @default(cuid())
  empresaId        String         @default("1")
  codigo           String         @unique // PRY-00001
  nombre           String
  descripcion      String?
  // Solo una etiqueta informativa de qué área/sponsor lo pidió — el costo
  // real NO se postea contra este centro (es WIP que capitaliza en un
  // ActivoFijo, no un gasto de período). Ver CostoProyecto.
  centroCostoId    String?
  presupuestoTotal Decimal
  estado           EstadoProyecto @default(PLANIFICADO)
  fechaInicioPlan  DateTime
  fechaFinPlan     DateTime
  fechaInicioReal  DateTime?
  fechaFinReal     DateTime?
  responsableId    String?
  usuarioId        String
  usuarioNombre    String
  creadoEn         DateTime       @default(now())

  centroCosto   CentroCosto?    @relation(fields: [centroCostoId], references: [id])
  responsable   Empleado?       @relation(fields: [responsableId], references: [id])
  edts          EdtProyecto[]
  costos        CostoProyecto[]
  ordenesCompra OrdenCompra[]
  activosFijos  ActivoFijo[]

  @@map("proyectos")
}

// Nodo de la WBS (fase/subfase). Auto-relación para el árbol multinivel;
// el código jerárquico ("1", "1.1") se calcula en el server action contando
// hermanos, no es un correlativo global.
model EdtProyecto {
  id          String   @id @default(cuid())
  proyectoId  String
  parentId    String?
  codigo      String
  nombre      String
  presupuesto Decimal? // tope informativo, no bloqueante — igual que OrdenInterna.presupuesto
  orden       Int      @default(0)

  proyecto      Proyecto            @relation(fields: [proyectoId], references: [id])
  parent        EdtProyecto?        @relation("EdtJerarquia", fields: [parentId], references: [id])
  hijos         EdtProyecto[]       @relation("EdtJerarquia")
  actividades   ActividadProyecto[]
  costos        CostoProyecto[]
  ordenesCompra OrdenCompra[]

  @@map("edt_proyecto")
}

// Nodo de la red de actividades. Los 4 campos de ruta crítica
// (fechaInicioPlan/fechaFinPlan/esCritica/holguraDias) son calculados por
// recalcularRutaCritica() en src/lib/proyectos.ts — nunca se editan a mano.
model ActividadProyecto {
  id              String         @id @default(cuid())
  edtId           String
  codigo          String
  nombre          String
  duracionDias    Int
  estado          EstadoProyecto @default(PLANIFICADO)
  responsableId   String?
  equipoId        String?
  fechaInicioPlan DateTime?
  fechaFinPlan    DateTime?
  esCritica       Boolean        @default(false)
  holguraDias     Int            @default(0)

  edt          EdtProyecto            @relation(fields: [edtId], references: [id])
  responsable  Empleado?              @relation(fields: [responsableId], references: [id])
  equipo       Equipo?                @relation(fields: [equipoId], references: [id])
  predecesoras PrecedenciaActividad[] @relation("Sucesora")
  sucesoras    PrecedenciaActividad[] @relation("Predecesora")

  @@map("actividades_proyecto")
}

// Arista del grafo (Fin-a-Inicio únicamente). Se valida que no forme ciclo
// en el server action antes de insertar (DFS), no en la base.
model PrecedenciaActividad {
  id                     String @id @default(cuid())
  actividadPredecesoraId String
  actividadSucesoraId    String

  predecesora ActividadProyecto @relation("Predecesora", fields: [actividadPredecesoraId], references: [id])
  sucesora    ActividadProyecto @relation("Sucesora", fields: [actividadSucesoraId], references: [id])

  @@unique([actividadPredecesoraId, actividadSucesoraId])
  @@map("precedencias_actividad")
}

// Ledger de costos reales — mismo patrón que OrdenInternaCosto. El costo
// real del proyecto/fase se calcula sumando estas filas más las OrdenCompra
// etiquetadas (estado != ANULADA); no hay doble registro.
model CostoProyecto {
  id            String   @id @default(cuid())
  proyectoId    String
  edtId         String?
  concepto      String
  monto         Decimal
  fecha         DateTime @default(now())
  usuarioId     String
  usuarioNombre String

  proyecto Proyecto     @relation(fields: [proyectoId], references: [id])
  edt      EdtProyecto? @relation(fields: [edtId], references: [id])

  @@map("costos_proyecto")
}

// --- Mantenimiento de planta -------------------------------------------------

enum TipoCentroTrabajo {
  MEZCLA
  ENVASADO
  CALIDAD
  MANTENIMIENTO
  OTRO
}

model CentroTrabajo {
  id                String            @id @default(cuid())
  empresaId         String            @default("1")
  codigo            String
  nombre            String
  tipo              TipoCentroTrabajo
  almacenId         String
  centroCostoId     String?
  capacidadHorasDia Decimal
  eficienciaPct     Decimal           @default(100)
  activo            Boolean           @default(true)
  creadoEn          DateTime          @default(now())

  almacen            Almacen            @relation(fields: [almacenId], references: [id])
  centroCosto        CentroCosto?       @relation(fields: [centroCostoId], references: [id])
  equipos            Equipo[]
  operacionesFormula FormulaOperacion[]
  operacionesLote    LoteOperacion[]

  @@unique([empresaId, codigo])
  @@map("centros_trabajo")
}

// El equipo es el activo físico que se mantiene; activoFijoId es opcional y lo
// enlaza con su registro contable/depreciación cuando corresponde (no todo
// equipo mantenible está capitalizado, ej. equipos menores ya depreciados).
model Equipo {
  id              String   @id @default(cuid())
  empresaId       String   @default("1")
  codigo          String // EQ-00001
  nombre          String
  almacenId       String
  activoFijoId    String?  @unique
  centroCostoId   String?
  centroTrabajoId String?
  activo          Boolean  @default(true)
  notas           String?
  // Contador de uso (horómetro/odómetro) para mantenimiento preventivo por
  // contador (ej. "cada 5,000 km" o "cada 250 horas de motor"). Se actualiza
  // manualmente — no hay telemetría real conectada. unidadContador queda null
  // en equipos que solo usan planes por tiempo.
  contadorActual  Decimal  @default(0)
  unidadContador  String? // "km", "horas", etc.
  creadoEn        DateTime @default(now())

  almacen              Almacen                 @relation(fields: [almacenId], references: [id])
  activoFijo           ActivoFijo?             @relation(fields: [activoFijoId], references: [id])
  centroCosto          CentroCosto?            @relation(fields: [centroCostoId], references: [id])
  centroTrabajo        CentroTrabajo?          @relation(fields: [centroTrabajoId], references: [id])
  ordenesMantenimiento OrdenMantenimiento[]
  guiasRemision        GuiaRemision[]
  planesMantenimiento  PlanMantenimiento[]
  actividadesProyecto  ActividadProyecto[]
  operacionesLote      LoteOperacion[]
  avisosMantenimiento  AvisoMantenimiento[]
  lecturasContador     LecturaContadorEquipo[]

  @@unique([empresaId, codigo])
  @@map("equipos")
}

enum FuenteLecturaContador {
  ALTA_EQUIPO
  MANUAL
  CIERRE_MANTENIMIENTO
}

model LecturaContadorEquipo {
  id            String                @id @default(cuid())
  equipoId      String
  valor         Decimal
  fuente        FuenteLecturaContador
  observacion   String?
  usuarioId     String
  usuarioNombre String
  creadoEn      DateTime              @default(now())

  equipo Equipo @relation(fields: [equipoId], references: [id])

  @@index([equipoId, creadoEn])
  @@map("lecturas_contador_equipo")
}

enum TipoMantenimiento {
  PREVENTIVO
  CORRECTIVO
}

enum EstadoOrdenMantenimiento {
  PROGRAMADA
  EN_PROCESO
  COMPLETADA
  CANCELADA
}

enum CausaFallaMantenimiento {
  MECANICA
  ELECTRICA
  INSTRUMENTACION
  LUBRICACION
  OPERACION
  OTRO
}

// Al programarse (estado PROGRAMADA) bloquea los días de la ventana en el
// CalendarioProduccion del almacén del equipo (DiaNoLaborable), para que
// Proyecciones refleje la parada de capacidad. Al cancelarse, libera esos días.
model OrdenMantenimiento {
  id                   String                   @id @default(cuid())
  codigo               String                   @unique // OM-00001
  equipoId             String
  tipo                 TipoMantenimiento
  estado               EstadoOrdenMantenimiento @default(PROGRAMADA)
  descripcion          String
  fechaProgramada      DateTime
  duracionDias         Int                      @default(1)
  fechaInicio          DateTime?
  fechaFin             DateTime?
  costoManoObra        Decimal                  @default(0)
  costoRepuestos       Decimal                  @default(0)
  observaciones        String?
  modoFalla            String?
  causaFalla           CausaFallaMantenimiento?
  tiempoParadaHoras    Decimal?
  tecnicoResponsable   String?
  // Por defecto el del equipo, pero se puede anular al programar la orden
  // (ej. una reparación que en realidad corresponde a otra área).
  centroCostoId        String?
  // Si esta orden nació de un plan preventivo (generación automática), queda
  // enlazada acá — al completarla se actualiza el ciclo del plan.
  planMantenimientoId  String?
  avisoMantenimientoId String?                  @unique
  usuarioId            String
  usuarioNombre        String
  creadoEn             DateTime                 @default(now())

  equipo             Equipo                       @relation(fields: [equipoId], references: [id])
  centroCosto        CentroCosto?                 @relation(fields: [centroCostoId], references: [id])
  planMantenimiento  PlanMantenimiento?           @relation(fields: [planMantenimientoId], references: [id])
  repuestos          RepuestoOrdenMantenimiento[]
  avisoMantenimiento AvisoMantenimiento?          @relation(fields: [avisoMantenimientoId], references: [id])

  @@map("ordenes_mantenimiento")
}

enum PrioridadAvisoMantenimiento {
  BAJA
  MEDIA
  ALTA
  EMERGENCIA
}

enum EstadoAvisoMantenimiento {
  ABIERTO
  CONVERTIDO
  DESCARTADO
}

model AvisoMantenimiento {
  id             String                      @id @default(cuid())
  empresaId      String                      @default("1")
  equipoId       String
  prioridad      PrioridadAvisoMantenimiento @default(MEDIA)
  estado         EstadoAvisoMantenimiento    @default(ABIERTO)
  titulo         String
  sintoma        String
  equipoDetenido Boolean                     @default(false)
  fechaDeteccion DateTime                    @default(now())
  usuarioId      String
  usuarioNombre  String
  creadoEn       DateTime                    @default(now())
  descartadoEn   DateTime?
  motivoDescarte String?

  equipo Equipo              @relation(fields: [equipoId], references: [id])
  orden  OrdenMantenimiento?

  @@index([empresaId, estado, prioridad])
  @@map("avisos_mantenimiento")
}

enum TipoPlanMantenimiento {
  POR_TIEMPO
  POR_CONTADOR
}

// Plan de mantenimiento preventivo: genera OrdenMantenimiento automáticamente
// (tarea programada, ver src/lib/tareasProgramadas.ts) cuando se cumple el
// ciclo por calendario o por contador de uso. El ciclo se reinicia recién
// cuando la orden generada se COMPLETA (no cuando se genera), para reflejar
// la fecha/contador real de ejecución, no la de programación.
model PlanMantenimiento {
  id                      String                @id @default(cuid())
  empresaId               String                @default("1")
  equipoId                String
  nombre                  String // ej. "Cambio de aceite de motor"
  tipo                    TipoPlanMantenimiento
  frecuenciaDias          Int? // solo POR_TIEMPO
  frecuenciaContador      Decimal? // solo POR_CONTADOR (ej. cada 5000 km)
  ultimaEjecucionFecha    DateTime? // null = nunca ejecutado, se usa creadoEn como base
  ultimaEjecucionContador Decimal? // null = nunca ejecutado, se usa 0 como base
  centroCostoId           String? // opcional, si no usa el del equipo
  activo                  Boolean               @default(true)
  usuarioId               String
  usuarioNombre           String
  creadoEn                DateTime              @default(now())

  equipo      Equipo               @relation(fields: [equipoId], references: [id])
  centroCosto CentroCosto?         @relation(fields: [centroCostoId], references: [id])
  ordenes     OrdenMantenimiento[]

  @@map("planes_mantenimiento")
}

// Repuestos consumidos por una orden, con costo unitario "congelado" al
// momento del consumo (igual que EnvasadoInsumo con la fórmula): si el costo
// promedio del insumo cambia después, el histórico de esta orden no se altera.
// Al crearse, descuenta stock real vía registrarMovimiento (origen AJUSTE),
// así el costoRepuestos de la orden queda como la suma de estas líneas.
model RepuestoOrdenMantenimiento {
  id                   String   @id @default(cuid())
  ordenMantenimientoId String
  insumoId             String
  cantidad             Decimal
  costoUnitario        Decimal
  creadoEn             DateTime @default(now())

  orden  OrdenMantenimiento @relation(fields: [ordenMantenimientoId], references: [id])
  insumo Insumo             @relation(fields: [insumoId], references: [id])

  @@map("repuestos_orden_mantenimiento")
}

// ---------------------------------------------------------------------------
// PROYECCIONES — Marketing / Operaciones / Finanzas por trimestre.
// Metodología estilo Business Management Game / S&OP (SAP IBP, Epicor IP&O):
// estacionalidad calculada de la propia historia de ventas + supuestos
// cualitativos que ingresa el usuario (crecimiento esperado, factor de
// competencia) + un factor macro de referencia (BCRP, best-effort).
// ---------------------------------------------------------------------------
model Proyeccion {
  id            String @id @default(cuid())
  empresaId     String @default("1")
  anio          Int
  trimestre     Int // 1-4
  anioBase      Int // trimestre de referencia (normalmente el anterior)
  trimestreBase Int

  // Supuestos de Marketing (cualitativos, igual que en el modelo BML)
  crecimientoMercadoPct Decimal @default(0) // %
  factorCompetenciaPct  Decimal @default(0) // % (+/-)
  presupuestoPublicidad Decimal @default(0)

  // Supuestos de Finanzas
  cajaMinimaDeseada     Decimal  @default(0)
  metaUtilidadOperativa Decimal? // meta del trimestre, para el simulador de precios

  // Factor macro de referencia (BCRP), tomado al momento de crear/actualizar
  macroPbiManufacturaVar Decimal? // variación % interanual
  macroInflacionVar      Decimal? // variación % interanual
  macroTipoCambio        Decimal? // S/ por US$, promedio del período
  macroActualizadoEn     DateTime?

  usuarioId     String
  usuarioNombre String
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  detalles ProyeccionDetalle[]

  @@unique([empresaId, anio, trimestre])
  @@map("proyecciones")
}

model ProyeccionDetalle {
  id             String @id @default(cuid())
  proyeccionId   String
  presentacionId String

  ventasBase           Decimal @default(0) // unidades vendidas en el trimestre base
  indiceEstacionalidad Decimal @default(1) // trimestre objetivo ÷ trimestre base, de la historia
  ajusteCualitativoPct Decimal @default(0) // % adicional a criterio del usuario
  demandaProyectada    Decimal @default(0) // unidades resultantes

  // Simulador de precios: hipótesis de "a qué precio necesito vender", no el
  // precio real del maestro (Presentacion.precio no se toca desde acá).
  precioSimulado      Decimal? // si es null, el simulador parte del precio actual
  precioCompetidorRef Decimal? // precio de referencia del competidor, ingresado a criterio

  proyeccion   Proyeccion   @relation(fields: [proyeccionId], references: [id], onDelete: Cascade)
  presentacion Presentacion @relation(fields: [presentacionId], references: [id])

  @@unique([proyeccionId, presentacionId])
  @@map("proyeccion_detalles")
}

// ---------------------------------------------------------------------------
// Multi-moneda: solo para operaciones puntuales en USD (compras a proveedores
// que cotizan en dólares). El PEN sigue siendo la moneda funcional — todo lo
// que impacta el libro diario, el costeo de inventario y los reportes se
// convierte a PEN con el tipo de cambio vigente al momento de la operación
// (nunca se revalúa después: mismo principio de "congelar" que el costo
// promedio o el kardex).
// ---------------------------------------------------------------------------

// Caché best-effort del tipo de cambio (BCRP) por día — ver src/lib/tipoCambio.ts.
model TipoCambio {
  id       String   @id @default(cuid())
  fecha    DateTime @unique // solo la fecha (medianoche), un valor por día
  valor    Decimal // soles por 1 dólar (S/ / US$)
  fuente   String   @default("BCRP")
  creadoEn DateTime @default(now())

  @@map("tipos_cambio")
}

// ---------------------------------------------------------------------------
// RRHH básico: ficha de personal + vacaciones. Deliberadamente NO incluye
// cálculo de planilla/nómina (AFP/ONP/EsSalud/gratificaciones/CTS) — eso
// requiere expertise legal-tributaria específica y queda fuera de alcance,
// igual que SuccessFactors/Ariba en el resto del sistema.
// ---------------------------------------------------------------------------

enum TipoContrato {
  PLAZO_FIJO
  PLAZO_INDETERMINADO
  LOCACION_SERVICIOS
}

enum EstadoEmpleado {
  ACTIVO
  CESADO
}

enum TipoDocumentoIdentidad {
  DNI
  PASAPORTE
  CARNET_EXTRANJERIA
  OTRO
}

enum SistemaPension {
  ONP
  AFP
}

enum Afp {
  INTEGRA
  PRIMA
  HABITAT
  PROFUTURO
}

model Empleado {
  id                     String                 @id @default(cuid())
  empresaId              String                 @default("1")
  codigo                 String // EMP-00001
  nombres                String
  apellidos              String
  tipoDocumentoIdentidad TipoDocumentoIdentidad @default(DNI)
  dni                    String?
  nacionalidad           String                 @default("Peruana")
  fechaNacimiento        DateTime?
  fechaIngreso           DateTime
  fechaCese              DateTime?
  motivoCese             String?
  cargo                  String
  area                   String
  tipoContrato           TipoContrato
  sueldoBasico           Decimal                @default(0)
  telefono               String?
  correo                 String?
  // Datos bancarios estructurados — para el pago de haberes cuando exista
  // planilla real, o para transferencias a personal remoto/extranjero.
  banco                  String?
  numeroCuenta           String?
  cci                    String?
  swift                  String?
  iban                   String?
  almacenId              String? // planta/local donde trabaja (opcional)
  centroCostoId          String? // para que su costo pese en el centro correcto
  usuarioId              String?                @unique // cuenta de acceso al ERP, si tiene (opcional, 1 a 1)
  estado                 EstadoEmpleado         @default(ACTIVO)
  // Datos para el cálculo de planilla (item HCM). Sin sistemaPension definido,
  // el empleado queda excluido de la corrida de planilla con una advertencia
  // visible — nunca se asume ONP/AFP por defecto en un cálculo con dinero real.
  sistemaPension         SistemaPension?
  afp                    Afp? // solo si sistemaPension = AFP
  asignacionFamiliar     Boolean                @default(false) // tiene hijo(s) menor(es) o que estudian hasta 24 años
  notas                  String?
  creadoEn               DateTime               @default(now())

  almacen                Almacen?                   @relation(fields: [almacenId], references: [id])
  centroCosto            CentroCosto?               @relation(fields: [centroCostoId], references: [id])
  usuario                Usuario?                   @relation(fields: [usuarioId], references: [id])
  vacaciones             SolicitudVacaciones[]
  planillaDetalles       PlanillaDetalle[]
  liquidacion            LiquidacionDesvinculacion?
  proyectosResponsable   Proyecto[]
  actividadesResponsable ActividadProyecto[]
  turnoTrabajo           TurnoTrabajo?              @relation(fields: [turnoTrabajoId], references: [id])
  asistencias            RegistroAsistencia[]
  cambiosSalariales      CambioSalarial[]
  turnoTrabajoId         String?

  @@unique([empresaId, codigo])
  @@unique([empresaId, dni])
  @@map("empleados")
}

enum EstadoCambioSalarial {
  PENDIENTE
  APROBADO
  RECHAZADO
}

model CambioSalarial {
  id                String               @id @default(cuid())
  empleadoId        String
  sueldoAnterior    Decimal
  sueldoNuevo       Decimal
  vigenteDesde      DateTime
  motivo            String
  estado            EstadoCambioSalarial @default(PENDIENTE)
  usuarioId         String
  usuarioNombre     String
  resueltoEn        DateTime?
  resueltoPorId     String?
  resueltoPorNombre String?
  motivoRechazo     String?
  creadoEn          DateTime             @default(now())

  empleado Empleado @relation(fields: [empleadoId], references: [id])

  @@index([empleadoId, vigenteDesde])
  @@map("cambios_salariales")
}

model TurnoTrabajo {
  id               String   @id @default(cuid())
  empresaId        String   @default("1")
  codigo           String
  nombre           String
  inicioMinuto     Int
  finMinuto        Int
  refrigerioMinuto Int      @default(60)
  toleranciaMinuto Int      @default(0)
  activo           Boolean  @default(true)
  creadoEn         DateTime @default(now())

  empleados Empleado[]

  @@unique([empresaId, codigo])
  @@map("turnos_trabajo")
}

enum EstadoRegistroAsistencia {
  BORRADOR
  APROBADO
}

model RegistroAsistencia {
  id                  String                   @id @default(cuid())
  empresaId           String                   @default("1")
  empleadoId          String
  fecha               DateTime
  entrada             DateTime?
  salida              DateTime?
  minutosTrabajados   Int                      @default(0)
  minutosTardanza     Int                      @default(0)
  minutosSobretiempo  Int                      @default(0)
  ausenciaJustificada Boolean                  @default(false)
  observacion         String?
  estado              EstadoRegistroAsistencia @default(BORRADOR)
  usuarioId           String
  usuarioNombre       String
  aprobadoEn          DateTime?
  aprobadoPorId       String?
  aprobadoPorNombre   String?
  creadoEn            DateTime                 @default(now())

  empleado Empleado @relation(fields: [empleadoId], references: [id])

  @@unique([empleadoId, fecha])
  @@index([empresaId, fecha, estado])
  @@map("registros_asistencia")
}

enum EstadoSolicitudVacaciones {
  PENDIENTE
  APROBADA
  RECHAZADA
}

// Ledger inmutable de solicitudes — el saldo disponible se calcula al vuelo
// (30 días/año según ley peruana, proporcional al tiempo trabajado, menos lo
// ya APROBADA) en vez de guardarse, mismo principio que el resto del sistema.
model SolicitudVacaciones {
  id              String                    @id @default(cuid())
  empleadoId      String
  fechaInicio     DateTime
  fechaFin        DateTime
  diasSolicitados Int
  estado          EstadoSolicitudVacaciones @default(PENDIENTE)
  motivoRechazo   String?
  aprobadaPor     String?
  aprobadaEn      DateTime?
  usuarioId       String
  usuarioNombre   String
  creadoEn        DateTime                  @default(now())

  empleado Empleado @relation(fields: [empleadoId], references: [id])

  @@map("solicitudes_vacaciones")
}

// ---------------------------------------------------------------------------
// PLANILLA (HCM — Fase 1: cálculo mensual). Parámetros legales versionados
// por fecha de vigencia (mismo principio que TipoCambio/tasaIgv-al-emitir):
// un cambio de norma no debe alterar el cálculo de un período ya cerrado.
// Gratificación/CTS/liquidación de desvinculación quedan para una iteración
// siguiente sobre esta misma base — ver docs/gobernanza/04-hcm-*.md.
// ---------------------------------------------------------------------------

model ParametroPlanilla {
  id            String   @id @default(cuid())
  empresaId     String   @default("1")
  rmv           Decimal // remuneración mínima vital vigente
  uit           Decimal // unidad impositiva tributaria vigente
  tasaEsSalud   Decimal  @default(9) // % aporte patronal
  tasaOnp       Decimal  @default(13) // % descuento al trabajador afiliado a ONP
  vigenteDesde  DateTime
  usuarioId     String
  usuarioNombre String
  creadoEn      DateTime @default(now())

  @@map("parametros_planilla")
}

enum EstadoPoliticaTiempo {
  BORRADOR
  APROBADA
  RETIRADA
}

model PoliticaTiempoTrabajo {
  id                     String               @id @default(cuid())
  empresaId              String               @default("1")
  vigenteDesde           DateTime
  horasJornadaDiaria     Decimal              @default(8)
  primerasHorasRecargo   Decimal              @default(2)
  recargoPrimerTramo     Decimal              @default(25)
  recargoSegundoTramo    Decimal              @default(35)
  aplicarPagoSobretiempo Boolean              @default(false)
  estado                 EstadoPoliticaTiempo @default(BORRADOR)
  usuarioId              String
  usuarioNombre          String
  aprobadoEn             DateTime?
  aprobadoPorId          String?
  aprobadoPorNombre      String?
  creadoEn               DateTime             @default(now())

  @@unique([empresaId, vigenteDesde])
  @@index([empresaId, estado, vigenteDesde])
  @@map("politicas_tiempo_trabajo")
}

enum TipoComisionAfp {
  FLUJO
  MIXTA
}

model TasaAfp {
  id                    String          @id @default(cuid())
  afp                   Afp
  tipoComision          TipoComisionAfp @default(FLUJO)
  tasaAporteObligatorio Decimal         @default(10) // % al fondo propio del trabajador
  tasaComision          Decimal // % de la AFP
  primaSeguro           Decimal // % prima de seguro
  vigenteDesde          DateTime
  creadoEn              DateTime        @default(now())

  @@unique([afp, tipoComision, vigenteDesde])
  @@map("tasas_afp")
}

enum TipoPeriodoPlanilla {
  MENSUAL
  GRATIFICACION_JULIO
  GRATIFICACION_DICIEMBRE
  CTS_MAYO
  CTS_NOVIEMBRE
}

enum EstadoPeriodoPlanilla {
  ABIERTO
  CERRADO
}

model PlanillaPeriodo {
  id            String                @id @default(cuid())
  empresaId     String                @default("1")
  anio          Int
  mes           Int
  tipo          TipoPeriodoPlanilla   @default(MENSUAL)
  estado        EstadoPeriodoPlanilla @default(ABIERTO)
  usuarioId     String
  usuarioNombre String
  creadoEn      DateTime              @default(now())
  cerradoEn     DateTime?

  detalles PlanillaDetalle[]

  @@unique([empresaId, anio, mes, tipo])
  @@map("planilla_periodos")
}

model PlanillaDetalle {
  id                         String   @id @default(cuid())
  planillaPeriodoId          String
  empleadoId                 String
  sueldoBasico               Decimal
  asignacionFamiliar         Decimal  @default(0)
  remuneracionComputable     Decimal // sueldoBasico + asignacionFamiliar
  // Desglose del descuento de pensión (ONP o AFP: aporte + comisión + prima).
  descuentoPension           Decimal  @default(0)
  detallePension             String? // texto legible del desglose, para la boleta
  essaludPatronal            Decimal  @default(0) // gasto del empleador, no se descuenta al trabajador
  retencion5ta               Decimal  @default(0) // método simplificado — ver docs/gobernanza/04-hcm-*.md
  diasAsistenciaAprobada     Int      @default(0)
  diasAusenciaJustificada    Int      @default(0)
  minutosTardanza            Int      @default(0)
  minutosSobretiempo         Int      @default(0)
  importeSobretiempo         Decimal  @default(0)
  politicaTiempoTrabajoId    String?
  // Solo gratificación/CTS: meses computados en el período y bono Ley 30334
  // (gratificación). Gratificación y CTS están inafectas a ONP/AFP/EsSalud/5ta
  // categoría (hasta 2 UIT en el caso de renta) — no usan descuentoPension ni
  // essaludPatronal.
  mesesComputados            Decimal?
  bonificacionExtraordinaria Decimal  @default(0)
  neto                       Decimal
  asientoNumero              String?
  creadoEn                   DateTime @default(now())

  planillaPeriodo PlanillaPeriodo @relation(fields: [planillaPeriodoId], references: [id])
  empleado        Empleado        @relation(fields: [empleadoId], references: [id])

  @@unique([planillaPeriodoId, empleadoId])
  @@map("planilla_detalles")
}

// Finiquito al cesar un empleado: CTS truncada (desde el último depósito) +
// gratificación truncada (desde el inicio del semestre en curso) + bono Ley
// 30334 + vacaciones truncadas y no gozadas (saldoVacaciones ya es un cálculo
// continuo, cubre ambos). Un registro por cese — se genera junto con
// darDeBajaEmpleado.
model LiquidacionDesvinculacion {
  id                         String   @id @default(cuid())
  empleadoId                 String   @unique
  fechaCese                  DateTime
  ctsTruncada                Decimal
  gratificacionTruncada      Decimal
  bonificacionExtraordinaria Decimal
  diasVacacionesPendientes   Decimal
  montoVacaciones            Decimal
  total                      Decimal
  asientoNumero              String?
  usuarioId                  String
  usuarioNombre              String
  creadoEn                   DateTime @default(now())

  empleado Empleado @relation(fields: [empleadoId], references: [id])

  @@map("liquidaciones_desvinculacion")
}

// ---------------------------------------------------------------------------
// Adjuntos de archivos (DMS reducido): asociación genérica por
// entidadTipo/entidadId en vez de una tabla de unión por cada modelo — así un
// mismo componente (PanelAdjuntos) sirve para Empleado, ActivoFijo, Equipo,
// OrdenCompra, etc. sin migraciones nuevas cada vez que se agrega a un módulo
// más. El archivo físico vive en disco (ver src/lib/adjuntos.ts), no en la BD.
// ---------------------------------------------------------------------------
model Adjunto {
  id             String   @id @default(cuid())
  empresaId      String   @default("1")
  entidadTipo    String // "Empleado", "ActivoFijo", "Equipo", "OrdenCompra", etc.
  entidadId      String
  nombreArchivo  String // nombre físico en disco (con prefijo único)
  nombreOriginal String // nombre tal como lo subió el usuario
  mimeType       String
  tamanioBytes   Int
  usuarioId      String
  usuarioNombre  String
  creadoEn       DateTime @default(now())

  @@index([entidadTipo, entidadId])
  @@map("adjuntos")
}

// ---------------------------------------------------------------------------
// Tareas programadas (equivalente reducido a System Agent): trabajos que
// corren solos dentro del proceso del servidor (ver server.ts +
// src/lib/tareasProgramadas.ts), no disparados por un usuario. Cada tarea
// revisa internamente si ya hizo lo que tenía que hacer antes de actuar
// (depreciación por el período, recargo por la fecha del último aplicado,
// tipo de cambio por el caché diario) — correrla de más no duplica nada; esta
// tabla es solo la bitácora de ejecuciones, no una cola ni un candado.
// ---------------------------------------------------------------------------
enum ClaveTareaProgramada {
  DEPRECIACION_MENSUAL
  RECARGO_MORA
  TIPO_CAMBIO_DIARIO
  MANTENIMIENTO_PREVENTIVO
}

model TareaProgramada {
  id          String               @id @default(cuid())
  clave       ClaveTareaProgramada
  ejecutadoEn DateTime             @default(now())
  exitoso     Boolean
  resumen     String

  @@index([clave, ejecutadoEn])
  @@map("tareas_programadas")
}

// ---------------------------------------------------------------------------
// Datos maestros para operación internacional: Cliente/Proveedor pueden ser
// de cualquier país (no solo Perú), con su propio formato de identificación
// fiscal, más de una dirección (facturación ≠ envío) y más de un contacto —
// Direccion/Contacto son genéricos (entidadTipo/entidadId, mismo patrón que
// Adjunto) para no repetir el modelo por cada entidad que los necesite.
// ---------------------------------------------------------------------------

enum TipoDocumentoFiscal {
  RUC // Perú
  RUT // Chile
  NIT // Colombia
  RFC // México
  EIN // Estados Unidos
  VAT // Unión Europea / genérico
  CI // Cédula de identidad (persona natural, algunos países)
  OTRO
}

enum TipoDireccion {
  FACTURACION
  ENVIO
  OTRA
}

model Direccion {
  id           String        @id @default(cuid())
  entidadTipo  String // "Cliente", "Proveedor", "Empleado"
  entidadId    String
  tipo         TipoDireccion @default(OTRA)
  pais         String
  departamento String?
  provincia    String?
  distrito     String?
  direccion    String
  codigoPostal String?
  esPrincipal  Boolean       @default(false)
  creadoEn     DateTime      @default(now())

  @@index([entidadTipo, entidadId])
  @@map("direcciones")
}

model Contacto {
  id          String   @id @default(cuid())
  entidadTipo String // "Cliente", "Proveedor"
  entidadId   String
  nombre      String
  cargo       String?
  telefono    String?
  email       String?
  esPrincipal Boolean  @default(false)
  creadoEn    DateTime @default(now())

  @@index([entidadTipo, entidadId])
  @@map("contactos")
}

// ---------------------------------------------------------------------------
// Multi-empresa (fundación): permite registrar más de una compañía real (ej.
// una subsidiaria en otro país), con una "compañía activa" por sesión (ver
// src/lib/empresas.ts). FASE 1 — alcance honesto: Cliente y Proveedor ya
// filtran de verdad por empresaId. El resto de módulos (Insumo, Pedido,
// Factura, Orden de Compra, Asientos, ConfiguracionEmpresa/tasas fiscales...)
// TODAVÍA opera solo contra la compañía "1" por defecto — extender el filtro
// real a todo el grafo transaccional es una fase 2 separada y más grande, no
// hecha ahora para no arriesgar mezclar datos financieros de compañías
// distintas sin poder probarlo.
// ---------------------------------------------------------------------------
model Empresa {
  id              String   @id @default(cuid())
  razonSocial     String
  ruc             String?
  pais            String   @default("Peru")
  monedaFuncional String   @default("PEN")
  // La compañía "1" (creada por asegurarEmpresaPrincipal()) es la que ya
  // tenían todos los registros existentes antes de este cambio — no se puede
  // desactivar porque toda la data histórica cuelga de ella.
  esPrincipal     Boolean  @default(false)
  activa          Boolean  @default(true)
  creadoEn        DateTime @default(now())

  @@map("empresas")
}
