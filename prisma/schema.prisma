}

// Líneas reales que se están afectando (para que el comprobante electrónico
// cite el producto/cantidad real de la factura, no un texto libre como si
// fuera un ítem — bug que tenía la versión anterior de este envío).
model NotaCreditoDetalle {
  id                  String  @id @default(cuid())
  notaCreditoId       String
  pedidoDetalleId     String
  devolucionDetalleId String?
  cantidad            Decimal
  precioUnitario      Decimal
