// Prisma schema — ERP Grasas y Lubricantes
// Módulos: Catálogo, Inventario (kardex), Producción (2 etapas), Comercial, Usuarios
//
// Principios:
// - La historia nunca se edita ni se borra: kardex, facturas, cobros y comisiones
//   solo se compensan con movimientos/documentos nuevos (ajustes, notas de crédito).
// - Toda regularización guarda quién/cuándo/por qué (usuarioId, usuarioNombre, motivo).
// - Campos semilla para el futuro: empresaId, moneda, pais.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ---------------------------------------------------------------------------
// CONFIGURACION DE EMPRESA (equivalente a Company Maintenance de Epicor):
// datos fiscales que aparecen en los documentos y parámetros como la tasa IGV.
// ---------------------------------------------------------------------------

// Quien puede resolver una solicitud de un empleado, mas alla del permiso.
// SIN_JERARQUIA deja el comportamiento historico: basta el permiso y no ser
// el propio solicitante. Las otras dos exigen relacion de mando, SIEMPRE con
// respaldo de RR. HH.: si nadie de la cadena del solicitante tiene cuenta
// activa, cualquiera con el permiso puede resolver. Sin ese respaldo, un
// organigrama incompleto dejaria solicitudes sin nadie que las apruebe.
enum AlcanceAprobacionJerarquia {
  SIN_JERARQUIA
  JEFE_DIRECTO
  CADENA_MANDO
}

// Transacción operativa que no llegó a generar su asiento contable.
//
// `postearAsiento()` es best-effort a propósito: si falta un control contable,
// el período está cerrado o el presupuesto se excede, la operación comercial NO
// se revierte — el documento ya existe y revertirlo sería peor. El problema era
// que ese fallo no dejaba rastro: la transacción quedaba sin asiento en
// silencio y nadie se enteraba hasta cuadrar libros.
//
// La incidencia la escribe el propio `postearAsiento()`, no el llamador: son 83
// puntos de llamada y pedirle a cada uno que atienda el valor de retorno es
// justamente cómo se perdía el aviso.
//
// Se escribe dentro de la misma transacción que la operación: si la operación
// se revierte, la incidencia desaparece con ella, que es lo correcto.
model IncidenciaContable {
  id            String        @id @default(cuid())
  empresaId     String        @default("1")
  empresa       Empresa       @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  origen        OrigenAsiento
  glosa         String
  referencia    String?
  motivo        String
  fecha         DateTime      @default(now())
  usuarioId     String
  usuarioNombre String

  // Se resuelve cuando el contador ya hizo el asiento a mano o configuró lo
  // que faltaba. No se borra: el rastro de que hubo un hueco queda.
  resueltoEn        DateTime?
  resueltoPorId     String?
  resueltoPorNombre String?
  notaResolucion    String?

  @@index([empresaId, resueltoEn, fecha])
  @@map("incidencias_contables")
}

// Fila única que sirve de cerrojo para la numeración correlativa. No guarda
// ningún dato de negocio: existe solo para que `reservarCorrelativo()` tome un
// bloqueo de escritura antes de leer el último número.
//
// Antes el cerrojo se tomaba sobre la fila de ConfiguracionEmpresa, lo que
// ataba un mecanismo de concurrencia a un maestro de negocio: al pasar esa
// configuración a una fila por compañía, el cerrojo se rompió. Con tabla
// propia el cerrojo es deliberadamente global —la numeración se serializa
// entre todas las compañías— y no depende de qué filas de negocio existan.
model CerrojoCorrelativo {
  id            String   @id @default("1")
  actualizadoEn DateTime @default(now())

  @@map("cerrojo_correlativo")
}

model ConfiguracionEmpresa {
  // Una fila por compañía. El id dejó de ser la constante "1": la fila
  // histórica la conserva (es la de la compañía principal) y las nuevas
  // reciben un cuid. La clave real de lectura es empresaId, única.
  id                              String                     @id @default(cuid())
  empresaId                       String                     @unique @default("1")
  empresa                         Empresa                    @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  razonSocial                     String                     @default("Mi Empresa S.A.C.")
  nombreComercial                 String?
  ruc                             String?
  direccion                       String?
  direccion2                      String?
  ciudad                          String?
  // Dirección fiscal del emisor: es la que va impresa en los documentos y la
  // que viaja en el XML de facturación electrónica, donde SUNAT espera el
  // código de ubigeo de 6 dígitos y no el nombre del distrito.
  //
  // El texto libre se conserva igual que en Cliente y Almacen: guarda lo que
  // se escribió antes del catálogo y es el respaldo de lo que no empareje.
  distrito                        String?
  provincia                       String?
  departamento                    String?
  ubigeoId                        String?
  ubigeo                          Ubigeo?                    @relation(fields: [ubigeoId], references: [id])
  codigoPostal                    String?
  pais                            String                     @default("Perú")
  telefono                        String?
  fax                             String?
  email                           String?
  sitioWeb                        String?
  moneda                          String                     @default("PEN")
  tasaIgv                         Decimal                    @default(18) // % aplicado al facturar
  // Datos de la entidad legal que la razón social y el RUC no cubren.
  // Aparecen en documentos formales (contratos, cartas, poderes); son
  // **referencia informativa** y no gobiernan ningún cálculo ni bloquean
  // ninguna operación — igual criterio que el registro de OSINERGMIN de abajo.
  //
  // El régimen tributario NO cambia la tasa de IGV ni ningún cómputo: el
  // sistema no infiere obligaciones a partir de él. Es el dato que el contador
  // necesita ver junto al resto de la ficha de la sociedad.
  representanteLegal              String?
  representanteLegalDocumento     String?
  regimenTributario               RegimenTributario?
  // Fabricar/comercializar lubricantes en Perú exige inscripción en el
  // Registro de Hidrocarburos de OSINERGMIN (categoría OPDH — Otros
  // Productos Derivados de Hidrocarburos). Referencia informativa; no
  // bloquea ninguna operación.
  registroHidrocarburosOsinergmin String?
  registroHidrocarburosVigencia   DateTime?
  // % mensual sobre el saldo vencido. 0 = no se cobra recargo por mora
  // (default: no cambia el comportamiento hasta que el usuario lo configure).
  tasaRecargoMora                 Decimal                    @default(0)
  tarifaHoraManoObra              Decimal                    @default(0) // S/ por hora, usado al costear lotes y envasados
  // Aprobación por monto (0 = todo requiere aprobación siempre; un número muy
  // alto equivale a desactivar el control). Las aprueba Gerencia o un Admin.
  montoAprobacionCompras          Decimal                    @default(5000)
  montoAprobacionPagos            Decimal                    @default(5000)
  // Un aumento del límite de crédito de un cliente necesita aprobación cuando
  // el límite RESULTANTE supera este monto. La exposición es el límite que
  // queda, no cuánto subió: un cliente con 200 000 de límite son 200 000 de
  // riesgo venga de donde venga.
  //
  // null = el control está apagado y el límite se edita directo, que es como
  // venía funcionando. Ponerle un número lo enciende; es una decisión de
  // política de crédito y el sistema no elige una por su cuenta.
  montoAprobacionCredito          Decimal?
  // Tasas para la cascada de financiamiento en Proyecciones → Finanzas
  // (mismo orden que un modelo de tesorería típico: lo más barato/disponible primero).
  tasaDescuentoCxC                Decimal                    @default(9) // % (misma convención que tasaIgv: número entero, no fracción)
  tasaCreditoCortoPlazo           Decimal                    @default(9)
  limiteCreditoCortoPlazo         Decimal                    @default(100000)
  tasaCreditoLargoPlazo           Decimal                    @default(10)
  // Facturación electrónica SUNAT vía OSE (Operador de Servicios Electrónicos).
  // "SIMULADO" = no envía nada real, solo prueba el flujo interno (estado por
  // defecto: nadie debe recibir CDR falsos por accidente antes de contratar
  // un OSE de verdad). oseToken se guarda en texto plano a propósito: es un
  // token de servicio para llamadas salientes, no una contraseña de usuario.
  oseProveedor                    String                     @default("SIMULADO")
  oseToken                        String?
  // Comunicación directa a SUNAT (SEE - Del Contribuyente, oseProveedor =
  // "SUNAT_DIRECTO"): certificado digital de la empresa (.pfx/.p12 en
  // base64) + credenciales de usuario secundario SOL. Sin esto configurado,
  // el adaptador directo no puede firmar ni autenticar nada — no hay
  // fallback simulado para este proveedor (a diferencia de "SIMULADO").
  sunatCertificadoBase64          String?
  sunatCertificadoPassword        String?
  sunatUsuarioSol                 String?
  sunatClaveSol                   String?
  alcanceAprobacionJerarquia      AlcanceAprobacionJerarquia @default(CADENA_MANDO)
  actualizadoEn                   DateTime                   @updatedAt

  @@map("configuracion_empresa")
}

// Cuentas para el pie de página "Sírvase abonar en nuestras cuentas" de
// Factura/Nota de Crédito — una empresa real tiene varias (una por banco).
model CuentaBancariaEmpresa {
  id           String  @id @default(cuid())
  empresaId    String  @default("1")
  empresa      Empresa @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  banco        String
  moneda       String  @default("PEN")
  numeroCuenta String
  cci          String?
  activo       Boolean @default(true)

  movimientosCaja MovimientoCaja[]
  conciliaciones  ConciliacionBancaria[]

  @@index([empresaId, numeroCuenta])
  @@map("cuentas_bancarias_empresa")
}

// ---------------------------------------------------------------------------
// USUARIOS Y SESIONES
// ---------------------------------------------------------------------------

enum RolUsuario {
  ADMIN
  ALMACEN
  PRODUCCION
  VENTAS
  GERENCIA
}

// Aprobación por monto: NO_REQUERIDA cuando el documento está por debajo del
// umbral configurado (se comporta exactamente igual que antes de este
// control); PENDIENTE bloquea el siguiente paso (recepción / pago) hasta
// que Gerencia o un Administrador la resuelva.
enum EstadoAprobacion {
  NO_REQUERIDA
  PENDIENTE
  APROBADA
  RECHAZADA
}

enum EstadoPasoAprobacion {
  PENDIENTE
  APROBADO
  RECHAZADO
}

model Usuario {
  id                     String     @id @default(cuid())
  empresaId              String     @default("1")
  empresa                Empresa    @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  nombre                 String
  usuario                String // nombre de acceso
  passwordHash           String
  rol                    RolUsuario
  grupoSeguridadId       String?
  activo                 Boolean    @default(true)
  intentosFallidos       Int        @default(0)
  ultimoIntentoFallidoEn DateTime?
  bloqueadoHasta         DateTime?
  creadoEn               DateTime   @default(now())

  grupoSeguridad GrupoSeguridad? @relation(fields: [grupoSeguridadId], references: [id])
  sesiones       Sesion[]
  empleado       Empleado?

  @@unique([empresaId, usuario])
  @@map("usuarios")
}

model Sesion {
  id        String   @id @default(cuid())
  token     String   @unique
  usuarioId String
  expiraEn  DateTime
  creadoEn  DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@map("sesiones")
}

enum AccionAuditoriaMaestro {
  CREAR
  ACTUALIZAR
  ACTIVAR
  DESACTIVAR
  ELIMINAR
}

model AuditoriaMaestro {
  id             String                 @id @default(cuid())
  empresaId      String                 @default("1")
  empresa        Empresa                @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  entidad        String
  registroId     String
  accion         AccionAuditoriaMaestro
  valoresAntes   String?
  valoresDespues String?
  usuarioId      String
  usuarioNombre  String
  creadoEn       DateTime               @default(now())

  @@index([empresaId, entidad, registroId, creadoEn])
  @@index([usuarioId, creadoEn])
  @@map("auditoria_maestros")
}

// ---------------------------------------------------------------------------
// CATALOGO
// ---------------------------------------------------------------------------

model Categoria {
  id          String   @id @default(cuid())
  empresaId   String   @default("1")
  empresa     Empresa  @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  nombre      String
  descripcion String?
  activo      Boolean  @default(true)
  creadoEn    DateTime @default(now())

  productos Producto[]

  @@unique([empresaId, nombre])
  @@map("categorias")
}

// Segmento de negocio al que apunta comercialmente el producto (así organiza
// su catálogo la competencia del rubro, ej. Vistony: automotriz/industrial/
// minero/agrícola). No sustituye a Categoria (línea de producto interna).
enum SegmentoMercado {
  AUTOMOTRIZ
  INDUSTRIAL
  MINERO
  AGRICOLA
  MARINO
  OTRO
}

model Producto {
  id               String           @id @default(cuid())
  empresaId        String           @default("1")
  empresa          Empresa          @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  categoriaId      String
  codigo           String
  nombre           String
  descripcion      String?
  unidadMedidaBase String           @default("kg") // UM en que se produce y controla el granel
  segmentoMercado  SegmentoMercado?
  marca            String?
  gradoNlgi        String? // grasas: NLGI 000..6
  viscosidad       String? // aceites: ISO VG / SAE
  vidaUtilMeses    Int? // vida útil desde el envasado; null = no vence / no se controla
  // Enlaces a los documentos que un cliente industrial/distribuidor pide antes
  // de comprar (alojados fuera del sistema: Drive, S3, etc. — no hay
  // almacenamiento de archivos en esta app). null = no cargado todavía.
  fichaTecnicaUrl  String?
  hojaSeguridadUrl String?
  notasTecnicas    String?
  activo           Boolean          @default(true)
  creadoEn         DateTime         @default(now())
  actualizadoEn    DateTime         @updatedAt

  categoria        Categoria               @relation(fields: [categoriaId], references: [id])
  presentaciones   Presentacion[]
  formulas         Formula[]
  planesInspeccion PlanInspeccionCalidad[]

  @@unique([empresaId, codigo])
  @@map("productos")
}

model Presentacion {
  id                String   @id @default(cuid())
  empresaId         String   @default("1")
  empresa           Empresa  @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  productoId        String
  sku               String
  nombre            String
  contenidoKg       Decimal
  // Informativo para aceites/líquidos que se cotizan por volumen (litro,
  // galón) en vez de por peso — el costeo de producción sigue en kg
  // (contenidoKg), esto solo cambia cómo se muestra/imprime la presentación.
  contenidoLitros   Decimal?
  // Código de Catálogo 03 de SUNAT (NIU=unidad, KGM=kilogramo, GLL=galón,
  // LTR=litro, etc.) — usado al armar el ítem del comprobante electrónico.
  // Default NIU porque es el código genérico más seguro si no se configura.
  unidadMedidaSunat String   @default("NIU")
  precio            Decimal
  moneda            String   @default("PEN")
  stock             Decimal  @default(0)
  // Comprometido en pedidos PENDIENTE (aún no facturados). "Disponible para
  // vender" = stock - stockReservado. Se libera al facturar (pasa a ser
  // salida real de kardex) o al anular el pedido.
  stockReservado    Decimal  @default(0)
  stockMinimo       Decimal  @default(0)
  costoPromedio     Decimal  @default(0) // costo unitario promedio ponderado (se actualiza al envasar)
  codigoBarras      String? // EAN-13
  pesoBrutoKg       Decimal? // contenido + envase
  unidadesPorCaja   Int?
  zonaAlmacenId     String? // ubicación estructurada (Almacen > ZonaAlmacen)
  activo            Boolean  @default(true)
  creadoEn          DateTime @default(now())
  actualizadoEn     DateTime @updatedAt

  producto           Producto                  @relation(fields: [productoId], references: [id])
  zonaAlmacen        ZonaAlmacen?              @relation(fields: [zonaAlmacenId], references: [id])
  movimientos        MovimientoKardex[]
  saldosAlmacen      SaldoAlmacen[]
  envasados          Envasado[]
  pedidoDetalles     PedidoDetalle[]
  facturaDetalles    FacturaDetalle[]
  guiaDetalles       GuiaRemisionDetalle[]
  proyeccionDetalles ProyeccionDetalle[]
  escalonesPrecio    EscalonPrecio[]
  conteoDetalles     ConteoInventarioDetalle[]
  cotizacionDetalles CotizacionDetalle[]
  saldoZonas         SaldoZona[]

  @@unique([empresaId, sku])
  @@map("presentaciones")
}

// Precio por volumen: a partir de cantidadMinima unidades en una misma línea
// de pedido, se sugiere este precio en vez del precio base de la
// Presentación. Se aplica el escalón más alto que la cantidad alcance.
model EscalonPrecio {
  id             String  @id @default(cuid())
  presentacionId String
  cantidadMinima Int
  precio         Decimal

  presentacion Presentacion @relation(fields: [presentacionId], references: [id])

  @@unique([presentacionId, cantidadMinima])
  @@map("escalones_precio")
}

// Historial de las condiciones comerciales pactadas con un proveedor, con
// vigencias. Responde "qué plazo regía cuando se recibió esta factura" y
// "por qué cambió", que el campo mutable del maestro no puede contestar.
//
// Los rangos son semiabiertos [vigenteDesde, vigenteHasta): abrir una versión
// nueva cierra la anterior en la misma fecha, sin restar días ni dejar huecos.
// La versión vigente es la única con vigenteHasta en null.
model CondicionComercialProveedor {
  id                String    @id @default(cuid())
  proveedorId       String
  condicionPagoDias Int       @default(0) // 0 = contado
  vigenteDesde      DateTime
  vigenteHasta      DateTime? // null = vigente
  // Obligatorio a propósito: el ítem del diccionario pedía poder trazar POR QUÉ
  // cambió una condición, y una fecha sin motivo no lo contesta.
  motivo            String
  usuarioId         String
  usuarioNombre     String
  creadoEn          DateTime  @default(now())

  proveedor Proveedor @relation(fields: [proveedorId], references: [id], onDelete: Cascade)

  @@index([proveedorId, vigenteDesde])
  @@map("condiciones_comerciales_proveedor")
}

model Proveedor {
  id                  String              @id @default(cuid())
  empresaId           String              @default("1")
  empresa             Empresa             @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  razonSocial         String
  ruc                 String?
  tipoDocumentoFiscal TipoDocumentoFiscal @default(RUC)
  pais                String              @default("Peru")
  telefono            String?
  email               String?
  direccion           String?
  ubigeoId            String?
  contactoNombre      String?
  contactoTelefono    String?
  cuentaBancaria      String? // texto libre heredado; para pagos nuevos usar los campos estructurados de abajo
  // Datos bancarios estructurados — swift/iban para transferencias
  // internacionales, banco/numeroCuenta/cci para pagos domésticos en Perú.
  banco               String?
  numeroCuenta        String?
  cci                 String?
  swift               String?
  iban                String?
  condicionPagoDias   Int                 @default(0) // 0 = contado
  notas               String?
  activo              Boolean             @default(true)
  creadoEn            DateTime            @default(now())

  ubigeo                 Ubigeo?                       @relation(fields: [ubigeoId], references: [id])
  insumos                Insumo[]
  ordenesCompra          OrdenCompra[]
  cuentasPorPagar        CuentaPorPagar[]
  creditosProveedor      CreditoProveedor[]
  ofertasRfq             OfertaRfq[]
  acuerdosSuministro     AcuerdoSuministro[]
  condicionesComerciales CondicionComercialProveedor[]

  @@unique([empresaId, ruc])
  @@map("proveedores")
}

enum TipoInsumo {
  MATERIA_PRIMA
  ENVASE
  ETIQUETA
}

model Insumo {
  id                   String     @id @default(cuid())
  empresaId            String     @default("1")
  empresa              Empresa    @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  proveedorId          String?
  codigo               String
  nombre               String
  tipo                 TipoInsumo
  unidadMedida         String
  // Envases retornables (ej. tambor metálico de 55 gal): el cliente paga un
  // depósito y lo recupera al devolver el casco vacío. Solo aplica cuando
  // tipo = ENVASE. El control de cascos pendientes por cliente es manual por
  // ahora (no hay todavía un módulo de seguimiento automático).
  esRetornable         Boolean    @default(false)
  montoDeposito        Decimal?
  stock                Decimal    @default(0)
  stockMinimo          Decimal    @default(0)
  costoUnitario        Decimal    @default(0)
  plazoEntregaDias     Int        @default(0)
  cantidadMinimaCompra Decimal    @default(0)
  multiploCompra       Decimal    @default(0)
  moneda               String     @default("PEN")
  codigoProveedor      String? // código del artículo en el catálogo del proveedor
  zonaAlmacenId        String? // ubicación estructurada (Almacen > ZonaAlmacen)
  notas                String?
  requiereInspeccion   Boolean    @default(false) // si true, cada recepción queda pendiente de calidad antes de sumar stock
  // Catálogo formal de sustancia peligrosa (EHS): a diferencia de Producto
  // (hojaSeguridadUrl), la SDS/MSDS del insumo se adjunta vía el DMS genérico
  // (modelo Adjunto, entidadTipo="Insumo") en vez de un campo URL suelto.
  esPeligroso          Boolean    @default(false)
  claseGhs             String? // clasificación de peligro GHS, ej. "H315, H319 - Irritante cutáneo/ocular"
  activo               Boolean    @default(true)
  creadoEn             DateTime   @default(now())
  actualizadoEn        DateTime   @updatedAt

  proveedor              Proveedor?                     @relation(fields: [proveedorId], references: [id])
  zonaAlmacen            ZonaAlmacen?                   @relation(fields: [zonaAlmacenId], references: [id])
  movimientos            MovimientoKardex[]
  saldosAlmacen          SaldoAlmacen[]
  formulaDetalles        FormulaDetalle[]
  envasadoInsumos        EnvasadoInsumo[]
  ordenCompraDetalles    OrdenCompraDetalle[]
  recepcionDetalles      RecepcionCompraDetalle[]
  conteoDetalles         ConteoInventarioDetalle[]
  movimientosCasco       MovimientoCasco[]
  repuestosMantenimiento RepuestoOrdenMantenimiento[]
  repuestosPlanificados  RepuestoPlanMantenimiento[]
  reservasProduccion     ReservaInsumoProduccion[]
  movimientosProduccion  MovimientoMaterialProduccion[]
  planesInspeccion       PlanInspeccionInsumo[]
  lineasRfq              RfqCompraLinea[]
  lineasAcuerdo          AcuerdoSuministroLinea[]
  saldoZonas             SaldoZona[]

  @@unique([empresaId, codigo])
  @@map("insumos")
}

enum TipoMovimientoCasco {
  ENTREGADO // se le entregó el envase retornable al cliente (con su depósito)
  DEVUELTO // el cliente devolvió el casco vacío
}

// Ledger manual (no se deriva automáticamente de las ventas: un envasado no
// siempre implica un casco nuevo entregado, podría ser un refill de uno que
// el cliente ya tiene). Pendiente por (cliente, insumo) = ENTREGADO − DEVUELTO.
model MovimientoCasco {
  id            String              @id @default(cuid())
  empresaId     String              @default("1")
  empresa       Empresa             @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  clienteId     String
  insumoId      String
  tipo          TipoMovimientoCasco
  cantidad      Int
  fecha         DateTime            @default(now())
  referencia    String? // factura/guía asociada, opcional
  usuarioId     String
  usuarioNombre String

  cliente Cliente @relation(fields: [clienteId], references: [id])
  insumo  Insumo  @relation(fields: [insumoId], references: [id])

  @@index([empresaId, clienteId, insumoId])
  @@map("movimientos_casco")
}

// ---------------------------------------------------------------------------
// INVENTARIO — KARDEX (inmutable: nunca se edita ni borra, solo se compensa)
// ---------------------------------------------------------------------------

enum TipoItemKardex {
  PRESENTACION
  INSUMO
}

enum TipoMovimiento {
  ENTRADA
  SALIDA
}

enum OrigenMovimiento {
  STOCK_INICIAL
  COMPRA
  PRODUCCION // consumo de insumos por lote granel
  ENVASADO // consumo de envases/etiquetas y entrada de presentaciones
  VENTA
  ANULACION_VENTA
  REVERSO_ENTREGA
  DEVOLUCION_CLIENTE // el cliente devuelve mercadería físicamente (no es anulación ni NC)
  DEVOLUCION_PROVEEDOR // se devuelve materia prima/insumo a un proveedor (defecto, no conformidad)
  TRASLADO // movimiento entre dos almacenes: una SALIDA en el origen + una ENTRADA en el destino
  AJUSTE // regularización manual: motivo obligatorio
}

model MovimientoKardex {
  id             String           @id @default(cuid())
  empresaId      String           @default("1")
  empresa        Empresa          @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  fecha          DateTime         @default(now())
  almacenId      String
  tipoItem       TipoItemKardex
  presentacionId String?
  insumoId       String?
  tipoMovimiento TipoMovimiento
  origen         OrigenMovimiento
  cantidad       Decimal // siempre positiva; el signo lo da tipoMovimiento
  saldoAnterior  Decimal // saldo DEL ALMACÉN indicado (no el total de la empresa)
  saldoNuevo     Decimal
  costoUnitario  Decimal          @default(0) // costo promedio vigente tras el movimiento; congela la valorización histórica
  motivo         String? // obligatorio cuando origen = AJUSTE
  referencia     String? // código de lote, envasado, factura, traslado, etc.
  usuarioId      String
  usuarioNombre  String
  creadoEn       DateTime         @default(now())

  almacen      Almacen       @relation(fields: [almacenId], references: [id])
  presentacion Presentacion? @relation(fields: [presentacionId], references: [id])
  insumo       Insumo?       @relation(fields: [insumoId], references: [id])

  @@index([tipoItem, presentacionId, insumoId])
  @@index([almacenId, tipoItem, presentacionId, insumoId])
  @@map("movimientos_kardex")
}

// Saldo de stock por almacén (la "verdad" granular); Presentacion.stock e
// Insumo.stock siguen existiendo como el total agregado de todos los
// almacenes, mantenido en sincronía en la misma transacción que este saldo.
// Partición real del stock dentro de un almacén. SaldoAlmacen dice cuánto hay
// en el almacén; SaldoZona dice en qué zonas está repartido.
//
// Es una capa ADITIVA sobre SaldoAlmacen, no un reemplazo: el kardex sigue
// moviendo el saldo del almacén sin conocer zonas, y repartir por zona es una
// operación aparte que nunca altera el total. Lo que no se asignó a ninguna
// zona se deriva como "sin zona": saldoAlmacen - suma(saldoZona).
model SaldoZona {
  id             String         @id @default(cuid())
  zonaAlmacenId  String
  tipoItem       TipoItemKardex
  // Copia NO nuleable del id del item (presentacion o insumo). Existe solo
  // para que el indice unico funcione de verdad: en SQLite dos NULL se
  // consideran distintos, asi que una clave compuesta con columnas nuleables
  // -como la de SaldoAlmacen- no impide filas duplicadas. Con SaldoZona
  // duplicada la cantidad de la zona se contaria dos veces.
  itemId         String
  presentacionId String?
  insumoId       String?
  cantidad       Decimal        @default(0)
  actualizadoEn  DateTime       @updatedAt

  zona         ZonaAlmacen   @relation(fields: [zonaAlmacenId], references: [id], onDelete: Restrict)
  presentacion Presentacion? @relation(fields: [presentacionId], references: [id])
  insumo       Insumo?       @relation(fields: [insumoId], references: [id])

  @@unique([zonaAlmacenId, itemId])
  @@index([presentacionId])
  @@index([insumoId])
  @@map("saldos_zona")
}

model SaldoAlmacen {
  id             String         @id @default(cuid())
  almacenId      String
  tipoItem       TipoItemKardex
  presentacionId String?
  insumoId       String?
  cantidad       Decimal        @default(0)
  actualizadoEn  DateTime       @updatedAt

  almacen      Almacen       @relation(fields: [almacenId], references: [id])
  presentacion Presentacion? @relation(fields: [presentacionId], references: [id])
  insumo       Insumo?       @relation(fields: [insumoId], references: [id])

  @@unique([almacenId, tipoItem, presentacionId, insumoId])
  @@map("saldos_almacen")
}

// ---------------------------------------------------------------------------
// INVENTARIO — CONTEO CÍCLICO (proceso estructurado, en vez de ajustes sueltos)
// ---------------------------------------------------------------------------

// Un conteo cíclico se registra ya cerrado: se cuenta físicamente, se anota
// lo contado y al guardar se generan los AJUSTE de kardex necesarios para
// las líneas con diferencia. No hay estado "abierto" — es un proceso de un
// solo paso (contar → guardar → se ajusta solo).
model ConteoInventario {
  id            String   @id @default(cuid())
  empresaId     String   @default("1")
  empresa       Empresa  @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  codigo        String // CI-00001
  fecha         DateTime @default(now())
  usuarioId     String
  usuarioNombre String

  detalles ConteoInventarioDetalle[]

  @@unique([empresaId, codigo])
  @@map("conteos_inventario")
}

model ConteoInventarioDetalle {
  id              String         @id @default(cuid())
  conteoId        String
  tipoItem        TipoItemKardex
  presentacionId  String?
  insumoId        String?
  cantidadSistema Decimal // stock según el sistema al momento del conteo
  cantidadContada Decimal // lo contado físicamente
  diferencia      Decimal // cantidadContada - cantidadSistema

  conteo       ConteoInventario @relation(fields: [conteoId], references: [id])
  presentacion Presentacion?    @relation(fields: [presentacionId], references: [id])
  insumo       Insumo?          @relation(fields: [insumoId], references: [id])

  @@map("conteo_inventario_detalles")
}

// ---------------------------------------------------------------------------
// PRODUCCION — ETAPA 1: FORMULAS (versionadas) Y LOTES GRANEL
// ---------------------------------------------------------------------------

model Formula {
  id            String    @id @default(cuid())
  empresaId     String    @default("1")
  empresa       Empresa   @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  productoId    String
  version       Int
  rendimientoKg Decimal // kg de granel que produce un batch con las cantidades del detalle
  horasEstandar Decimal? // horas-hombre estándar de cocción por batch; null en versiones históricas sin base aprobada
  notas         String?
  activo        Boolean   @default(true)
  vigenteDesde  DateTime? // cuándo esta versión pasó a ser la vigente (se reasigna si se reactiva una versión anterior)
  vigenteHasta  DateTime? // cuándo dejó de ser la vigente (null si sigue vigente)
  usuarioId     String
  usuarioNombre String
  creadoEn      DateTime  @default(now())

  producto    Producto           @relation(fields: [productoId], references: [id])
  detalles    FormulaDetalle[]
  operaciones FormulaOperacion[]
  lotes       LoteGranel[]

  @@unique([productoId, version])
  @@map("formulas")
}

model FormulaDetalle {
  id        String  @id @default(cuid())
  formulaId String
  insumoId  String
  cantidad  Decimal // cantidad del insumo (en su unidad) para producir rendimientoKg

  formula Formula @relation(fields: [formulaId], references: [id])
  insumo  Insumo  @relation(fields: [insumoId], references: [id])

  @@map("formula_detalles")
}

model FormulaOperacion {
  id               String  @id @default(cuid())
  formulaId        String
  centroTrabajoId  String
  secuencia        Int
  nombre           String
  preparacionHoras Decimal @default(0)
  maquinaHoras     Decimal @default(0)
  manoObraHoras    Decimal @default(0)

  formula         Formula         @relation(fields: [formulaId], references: [id], onDelete: Cascade)
  centroTrabajo   CentroTrabajo   @relation(fields: [centroTrabajoId], references: [id])
  operacionesLote LoteOperacion[]

  @@unique([formulaId, secuencia])
  @@map("formula_operaciones")
}

enum EstadoLote {
  PLANIFICADO
  CANCELADO
  EN_PROCESO
  PENDIENTE_CALIDAD
  APROBADO
  RECHAZADO
}

enum DisposicionLoteRechazado {
  REPROCESADO
  DESECHADO
}

enum EstadoOperacionLote {
  PENDIENTE
  EN_PROCESO
  COMPLETADA
}

model LoteGranel {
  id                       String                    @id @default(cuid())
  empresaId                String                    @default("1")
  empresa                  Empresa                   @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  codigo                   String // LG-00001
  formulaId                String
  // Si este lote reprocesa un lote rechazado por calidad, referencia de dónde
  // viene (trazabilidad de la no conformidad). Su costo acumulado se incorpora
  // al nuevo lote; la nueva orden consume además los insumos de su fórmula.
  loteOrigenId             String?
  kgObjetivo               Decimal
  kgProducidos             Decimal                   @default(0)
  mermaKg                  Decimal                   @default(0)
  kgDisponibles            Decimal                   @default(0) // granel aprobado aún no envasado
  costoInsumos             Decimal                   @default(0) // costo total de insumos consumidos al crear el lote
  costoReproceso           Decimal                   @default(0) // costo heredado del lote rechazado incorporado al reproceso
  horasManoObra            Decimal                   @default(0) // horas-hombre invertidas en la cocción (al finalizar)
  costoManoObra            Decimal                   @default(0) // horasManoObra * tarifa vigente al finalizar
  costoKg                  Decimal                   @default(0) // costo real total / kg producido
  costoEstandarInsumos     Decimal? // snapshot plan al liberar la orden
  costoEstandarManoObra    Decimal? // horas estándar escaladas × tarifa snapshot
  costoEstandarTotal       Decimal? // costo estándar para kg objetivo
  costoEstandarPermitido   Decimal? // estándar permitido para kg realmente producidos
  variacionInsumos         Decimal? // costo real insumos - estándar insumos
  variacionManoObra        Decimal? // costo real MO - estándar MO
  variacionRendimiento     Decimal? // estándar objetivo - estándar permitido
  variacionTotal           Decimal? // costo real - estándar permitido
  estado                   EstadoLote                @default(EN_PROCESO)
  observaciones            String?
  fechaCreacion            DateTime?
  fechaInicio              DateTime                  @default(now())
  fechaLiberacion          DateTime?
  usuarioLiberacionId      String?
  usuarioLiberacionNombre  String?
  fechaCancelacion         DateTime?
  motivoCancelacion        String?
  usuarioCancelacionId     String?
  usuarioCancelacionNombre String?
  fechaFin                 DateTime?
  usuarioId                String
  disposicionRechazo       DisposicionLoteRechazado?
  motivoDisposicion        String?
  fechaDisposicion         DateTime?
  usuarioDisposicionId     String?
  usuarioDisposicionNombre String?
  usuarioNombre            String

  formula                Formula                        @relation(fields: [formulaId], references: [id])
  loteOrigen             LoteGranel?                    @relation("Reproceso", fields: [loteOrigenId], references: [id])
  reprocesos             LoteGranel[]                   @relation("Reproceso")
  controlCalidad         ControlCalidad?
  envasados              Envasado[]
  asignacionesLoteInsumo AsignacionLoteInsumo[]
  operaciones            LoteOperacion[]
  reservasInsumo         ReservaInsumoProduccion[]
  movimientosMaterial    MovimientoMaterialProduccion[]

  @@unique([empresaId, codigo])
  @@map("lotes_granel")
}

model ReservaInsumoProduccion {
  id           String   @id @default(cuid())
  loteGranelId String
  insumoId     String
  cantidad     Decimal
  creadoEn     DateTime @default(now())

  loteGranel LoteGranel @relation(fields: [loteGranelId], references: [id], onDelete: Cascade)
  insumo     Insumo     @relation(fields: [insumoId], references: [id])

  @@unique([loteGranelId, insumoId])
  @@index([insumoId])
  @@map("reservas_insumo_produccion")
}

enum TipoMovimientoMaterialProduccion {
  CONSUMO_ADICIONAL
  DEVOLUCION
}

model MovimientoMaterialProduccion {
  id            String                           @id @default(cuid())
  loteGranelId  String
  insumoId      String
  tipo          TipoMovimientoMaterialProduccion
  cantidad      Decimal
  costoUnitario Decimal
  costoTotal    Decimal
  motivo        String
  usuarioId     String
  usuarioNombre String
  creadoEn      DateTime                         @default(now())

  loteGranel   LoteGranel                       @relation(fields: [loteGranelId], references: [id])
  insumo       Insumo                           @relation(fields: [insumoId], references: [id])
  devoluciones DevolucionAsignacionLoteInsumo[]

  @@index([loteGranelId, creadoEn])
  @@map("movimientos_material_produccion")
}

model DevolucionAsignacionLoteInsumo {
  id                     String   @id @default(cuid())
  movimientoMaterialId   String
  asignacionLoteInsumoId String
  cantidad               Decimal
  creadoEn               DateTime @default(now())

  movimiento MovimientoMaterialProduccion @relation(fields: [movimientoMaterialId], references: [id])
  asignacion AsignacionLoteInsumo         @relation(fields: [asignacionLoteInsumoId], references: [id])

  @@index([asignacionLoteInsumoId])
  @@map("devoluciones_asignacion_lote_insumo")
}

model LoteOperacion {
  id                   String              @id @default(cuid())
  loteGranelId         String
  formulaOperacionId   String?
  centroTrabajoId      String
  equipoId             String?
  secuencia            Int
  nombre               String
  preparacionPlanHoras Decimal             @default(0)
  maquinaPlanHoras     Decimal             @default(0)
  manoObraPlanHoras    Decimal             @default(0)
  preparacionRealHoras Decimal             @default(0)
  maquinaRealHoras     Decimal             @default(0)
  manoObraRealHoras    Decimal             @default(0)
  estado               EstadoOperacionLote @default(PENDIENTE)
  inicioEn             DateTime?
  finEn                DateTime?
  usuarioInicioId      String?
  usuarioInicioNombre  String?
  usuarioFinId         String?
  usuarioFinNombre     String?
  fechaPlanInicio      DateTime?
  fechaPlanFin         DateTime?

  loteGranel       LoteGranel        @relation(fields: [loteGranelId], references: [id], onDelete: Cascade)
  formulaOperacion FormulaOperacion? @relation(fields: [formulaOperacionId], references: [id], onDelete: SetNull)
  centroTrabajo    CentroTrabajo     @relation(fields: [centroTrabajoId], references: [id])
  equipo           Equipo?           @relation(fields: [equipoId], references: [id], onDelete: SetNull)

  @@unique([loteGranelId, secuencia])
  @@index([centroTrabajoId, estado])
  @@index([fechaPlanInicio, fechaPlanFin])
  @@map("lote_operaciones")
}

enum ResultadoCalidad {
  APROBADO
  RECHAZADO
}

model ControlCalidad {
  id               String           @id @default(cuid())
  loteGranelId     String           @unique
  resultado        ResultadoCalidad
  observaciones    String?
  // No conformidad (solo cuando resultado = RECHAZADO): por qué falló y qué
  // se hizo al respecto (reproceso, descarte, ajuste de fórmula, etc.).
  // causaId es el catálogo estructurado (permite reportes agregados "top 5
  // defectos"); causaRaiz queda como detalle textual libre complementario.
  causaId          String?
  causaRaiz        String?
  accionCorrectiva String?
  fecha            DateTime         @default(now())
  usuarioId        String
  usuarioNombre    String

  loteGranel               LoteGranel                       @relation(fields: [loteGranelId], references: [id])
  causa                    CausaCalidad?                    @relation(fields: [causaId], references: [id])
  planInspeccion           PlanInspeccionCalidad?           @relation(fields: [planInspeccionId], references: [id])
  resultadosCaracteristica ResultadoCaracteristicaCalidad[]
  noConformidad            NoConformidadCalidad?

  planInspeccionId String?
  planVersion      Int?

  @@map("controles_calidad")
}

enum EstadoNoConformidad {
  ABIERTA
  INVESTIGACION
  IMPLEMENTACION
  VERIFICACION
  CERRADA
}

model NoConformidadCalidad {
  id                   String              @id @default(cuid())
  empresaId            String              @default("1")
  empresa              Empresa             @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  controlCalidadId     String              @unique
  estado               EstadoNoConformidad @default(ABIERTA)
  contencionInmediata  String?
  causaRaizConfirmada  String?
  accionCorrectiva     String?
  responsableId        String?
  responsableNombre    String?
  fechaCompromiso      DateTime?
  verificacionEficacia String?
  eficaz               Boolean?
  cerradoEn            DateTime?
  creadoEn             DateTime            @default(now())
  actualizadoEn        DateTime            @updatedAt

  controlCalidad ControlCalidad               @relation(fields: [controlCalidadId], references: [id])
  eventos        EventoNoConformidadCalidad[]

  @@index([empresaId, estado, fechaCompromiso])
  @@map("no_conformidades_calidad")
}

model EventoNoConformidadCalidad {
  id              String               @id @default(cuid())
  noConformidadId String
  estadoAnterior  EstadoNoConformidad?
  estadoNuevo     EstadoNoConformidad
  comentario      String
  usuarioId       String
  usuarioNombre   String
  creadoEn        DateTime             @default(now())

  noConformidad NoConformidadCalidad @relation(fields: [noConformidadId], references: [id], onDelete: Cascade)

  @@index([noConformidadId, creadoEn])
  @@map("eventos_no_conformidad_calidad")
}

model PlanInspeccionCalidad {
  id            String    @id @default(cuid())
  empresaId     String    @default("1")
  empresa       Empresa   @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  productoId    String
  version       Int
  nombre        String
  vigenteDesde  DateTime  @default(now())
  vigenteHasta  DateTime?
  activo        Boolean   @default(true)
  usuarioId     String
  usuarioNombre String
  creadoEn      DateTime  @default(now())

  producto        Producto                    @relation(fields: [productoId], references: [id])
  caracteristicas CaracteristicaPlanCalidad[]
  controles       ControlCalidad[]

  @@unique([productoId, version])
  @@index([empresaId, activo])
  @@map("planes_inspeccion_calidad")
}

model CaracteristicaPlanCalidad {
  id             String   @id @default(cuid())
  planId         String
  secuencia      Int
  nombre         String
  unidadMedida   String
  limiteInferior Decimal?
  limiteSuperior Decimal?
  metodoEnsayo   String?
  obligatoria    Boolean  @default(true)

  plan PlanInspeccionCalidad @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, secuencia])
  @@map("caracteristicas_plan_calidad")
}

model ResultadoCaracteristicaCalidad {
  id               String   @id @default(cuid())
  controlCalidadId String
  secuencia        Int
  nombre           String
  unidadMedida     String
  limiteInferior   Decimal?
  limiteSuperior   Decimal?
  metodoEnsayo     String?
  valorMedido      Decimal
  conforme         Boolean

  controlCalidad ControlCalidad @relation(fields: [controlCalidadId], references: [id], onDelete: Cascade)

  @@unique([controlCalidadId, secuencia])
  @@map("resultados_caracteristica_calidad")
}

// Catálogo formal de causas/defectos de calidad, reutilizable entre el
// control interno de producción (ControlCalidad) y los reclamos de cliente
// (ReclamoCliente) — reemplaza el texto libre para permitir reportes
// agregados tipo "top 5 defectos".
model CausaCalidad {
  id        String   @id @default(cuid())
  empresaId String   @default("1")
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  nombre    String
  activo    Boolean  @default(true)
  creadoEn  DateTime @default(now())

  controlesCalidad ControlCalidad[]
  reclamosCliente  ReclamoCliente[]

  @@unique([empresaId, nombre])
  @@map("causas_calidad")
}

enum EstadoReclamo {
  ABIERTO
  EN_PROCESO
  CERRADO
}

// Notificación de calidad del lado del cliente (RF-QM-025 a 030): a
// diferencia de ControlCalidad (no conformidad interna, antes de despachar),
// esto registra un reclamo recibido después de la venta, con seguimiento de
// estado hasta el cierre.
model ReclamoCliente {
  id               String        @id @default(cuid())
  empresaId        String        @default("1")
  empresa          Empresa       @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  numero           String // RCL-00001
  clienteId        String
  facturaId        String? // documento de origen, si aplica
  causaId          String?
  descripcion      String
  estado           EstadoReclamo @default(ABIERTO)
  accionCorrectiva String?
  fecha            DateTime      @default(now())
  fechaCierre      DateTime?
  usuarioId        String
  usuarioNombre    String
  creadoEn         DateTime      @default(now())
  actualizadoEn    DateTime      @updatedAt

  cliente Cliente       @relation(fields: [clienteId], references: [id])
  factura Factura?      @relation(fields: [facturaId], references: [id])
  causa   CausaCalidad? @relation(fields: [causaId], references: [id])

  @@unique([empresaId, numero])
  @@map("reclamos_cliente")
}

// ---------------------------------------------------------------------------
// PRODUCCION — ETAPA 2: ENVASADO (granel + envases/etiquetas -> presentaciones)
// ---------------------------------------------------------------------------

model Envasado {
  id                  String    @id @default(cuid())
  empresaId           String    @default("1")
  empresa             Empresa   @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  codigo              String // ENV-00001
  loteGranelId        String
  presentacionId      String
  unidades            Int
  // Unidades de este lote de envasado que todavía no se asignaron a ninguna
  // venta (arranca en `unidades`, baja al facturar y sube si se anula/
  // devuelve). Permite trazar, ante un recall, qué facturas/clientes
  // recibieron un lote específico (ver AsignacionLoteVenta).
  unidadesDisponibles Int       @default(0)
  kgConsumidos        Decimal // unidades * contenidoKg de la presentación
  horasManoObra       Decimal   @default(0) // horas-hombre invertidas en el envasado
  costoManoObra       Decimal   @default(0) // horasManoObra * tarifa vigente al envasar
  costoTotal          Decimal   @default(0) // granel consumido + envases/etiquetas + mano de obra
  costoUnitario       Decimal   @default(0) // costoTotal / unidades
  fecha               DateTime  @default(now())
  // El código del envasado (ENV-00001) YA funciona como número de lote. Esta
  // fecha se calcula sola desde Producto.vidaUtilMeses al envasar (editable);
  // null si el producto no tiene vida útil configurada.
  fechaVencimiento    DateTime?
  usuarioId           String
  usuarioNombre       String

  loteGranel       LoteGranel            @relation(fields: [loteGranelId], references: [id])
  presentacion     Presentacion          @relation(fields: [presentacionId], references: [id])
  insumos          EnvasadoInsumo[]
  asignacionesLote AsignacionLoteVenta[]

  @@unique([empresaId, codigo])
  @@map("envasados")
}

enum TipoAsignacionLote {
  ASIGNADA // se vendió (facturó) esta cantidad de este lote de envasado
  LIBERADA // se liberó por anulación de factura o devolución de mercadería
}

// Ledger inmutable (mismo patrón que Comision GENERADA/REVERSION) que
// permite responder, ante un reclamo de calidad o un recall, "¿qué
// facturas/clientes recibieron unidades del lote de envasado X?". El saldo
// vigente de un PedidoDetalle en un Envasado es la suma de ASIGNADA menos
// LIBERADA.
model AsignacionLoteVenta {
  id                  String             @id @default(cuid())
  pedidoDetalleId     String
  facturaDetalleId    String?
  guiaDetalleId       String?
  devolucionDetalleId String?
  envasadoId          String
  tipo                TipoAsignacionLote @default(ASIGNADA)
  cantidad            Int // siempre positiva; el signo real lo da "tipo"
  motivo              String? // ej. "Anulación factura F001-123" (null en la asignación original)
  creadoEn            DateTime           @default(now())

  pedidoDetalle     PedidoDetalle             @relation(fields: [pedidoDetalleId], references: [id])
  facturaDetalle    FacturaDetalle?           @relation(fields: [facturaDetalleId], references: [id])
  guiaDetalle       GuiaRemisionDetalle?      @relation(fields: [guiaDetalleId], references: [id])
  devolucionDetalle DevolucionClienteDetalle? @relation(fields: [devolucionDetalleId], references: [id])
  envasado          Envasado                  @relation(fields: [envasadoId], references: [id])

  @@index([facturaDetalleId])
  @@index([guiaDetalleId])
  @@index([devolucionDetalleId])
  @@map("asignaciones_lote_venta")
}

model EnvasadoInsumo {
  id         String  @id @default(cuid())
  envasadoId String
  insumoId   String
  cantidad   Decimal

  envasado Envasado @relation(fields: [envasadoId], references: [id])
  insumo   Insumo   @relation(fields: [insumoId], references: [id])

  @@map("envasado_insumos")
}

// ---------------------------------------------------------------------------
// COMERCIAL
// ---------------------------------------------------------------------------

model Zona {
  id        String   @id @default(cuid())
  empresaId String   @default("1")
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  nombre    String
  activo    Boolean  @default(true)
  creadoEn  DateTime @default(now())

  vendedores Vendedor[]
  clientes   Cliente[]

  @@unique([empresaId, nombre])
  @@map("zonas")
}

enum TipoVendedor {
  CON_BASICO
  SOLO_COMISION
}

model Vendedor {
  id           String       @id @default(cuid())
  empresaId    String       @default("1")
  empresa      Empresa      @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  nombre       String
  documento    String?
  telefono     String?
  email        String?
  tipo         TipoVendedor
  tasaComision Decimal // porcentaje individual, ej. 3.5
  zonaId       String?
  activo       Boolean      @default(true)
  creadoEn     DateTime     @default(now())

  zona              Zona?        @relation(fields: [zonaId], references: [id])
  pedidos           Pedido[]
  facturas          Factura[]
  comisiones        Comision[]
  hojasRuta         HojaRuta[]
  clientesAsignados Cliente[]    @relation("ClienteVendedor")
  cotizaciones      Cotizacion[]

  @@map("vendedores")
}

// Canal comercial del cliente: determina el tipo de descuentos/condiciones
// que aplican (un distribuidor mayorista no se maneja igual que un taller).
enum CanalCliente {
  DISTRIBUIDOR
  MAYORISTA
  TALLER
  FLOTA
  MINERA_INDUSTRIA
  MINORISTA
  OTRO
}

// Descuento por defecto según el canal del cliente (además del escalón por
// volumen de EscalonPrecio). Se aplica sobre el precio ya resuelto por
// cantidad: precioFinal = precioEscalonOBase * (1 - descuentoPct/100).
model DescuentoCanal {
  id           String       @id @default(cuid())
  empresaId    String       @default("1")
  empresa      Empresa      @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  canal        CanalCliente
  descuentoPct Decimal      @default(0)

  @@unique([empresaId, canal])
  @@map("descuentos_canal")
}

// Solicitud de cambio del límite de crédito de un cliente.
//
// Un aumento del límite es exposición financiera nueva, y hasta ahora se
// aplicaba con solo tener permiso de edición (quedaba auditado, pero ya
// aplicado). Con el control activo, **el límite no cambia hasta que alguien lo
// aprueba**: aplicar primero y aprobar después vaciaría el control.
//
// Solo los AUMENTOS pasan por aquí. Bajar un límite reduce la exposición y no
// necesita permiso de nadie — pedirlo solo lograría que nadie los baje.
model SolicitudCambioCredito {
  id                  String           @id @default(cuid())
  empresaId           String           @default("1")
  empresa             Empresa          @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  clienteId           String
  limiteAnterior      Decimal
  limiteSolicitado    Decimal
  // Obligatorio: quien aprueba necesita saber por qué se pide, y el histórico
  // sin motivo no sirve para revisar una cartera después.
  motivo              String
  estado              EstadoAprobacion @default(PENDIENTE)
  solicitadoPorId     String
  solicitadoPorNombre String
  solicitadoEn        DateTime         @default(now())
  resueltoPorId       String?
  resueltoPorNombre   String?
  resueltoEn          DateTime?
  motivoResolucion    String?

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([empresaId, estado, solicitadoEn])
  @@map("solicitudes_cambio_credito")
}

model Cliente {
  id                   String              @id @default(cuid())
  empresaId            String              @default("1")
  empresa              Empresa             @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  codigo               String // CLI-00001, asignado automáticamente al crear (nunca se reutiliza)
  razonSocial          String
  nombreComercial      String?
  ruc                  String?
  tipoDocumentoFiscal  TipoDocumentoFiscal @default(RUC)
  canal                CanalCliente?
  pais                 String              @default("Peru")
  // Texto libre heredado. Se conserva: tiene datos que no matchean ningún
  // ubigeo (direcciones en el extranjero, escrituras no oficiales) y es lo
  // que el usuario escribió. Para datos nuevos manda ubigeoId.
  departamento         String?
  provincia            String?
  distrito             String?
  ubigeoId             String?
  direccion            String?
  telefono             String?
  email                String?
  contactoNombre       String?
  contactoTelefono     String?
  zonaId               String?
  vendedorId           String? // vendedor asignado (se preselecciona en pedidos)
  limiteCredito        Decimal             @default(0) // 0 = sin límite; se valida al facturar
  condicionPagoDefecto CondicionPago       @default(CONTADO)
  notas                String?
  activo               Boolean             @default(true)
  // Bloqueo específico de cobranza (distinto de `activo`): impide crear
  // pedidos nuevos mientras tenga facturas vencidas sin resolver, pero no
  // oculta al cliente ni afecta su historial. Se levanta manualmente desde
  // Finanzas → Cobranza una vez que regulariza su deuda.
  bloqueadoCobranza    Boolean             @default(false)
  bloqueadoCobranzaEn  DateTime?
  bloqueadoCobranzaPor String?
  creadoEn             DateTime            @default(now())

  ubigeo             Ubigeo?                  @relation(fields: [ubigeoId], references: [id])
  solicitudesCredito SolicitudCambioCredito[]
  zona               Zona?                    @relation(fields: [zonaId], references: [id])
  vendedorAsignado   Vendedor?                @relation("ClienteVendedor", fields: [vendedorId], references: [id])
  pedidos            Pedido[]
  facturas           Factura[]
  guias              GuiaRemision[]
  visitas            HojaRutaVisita[]
  cotizaciones       Cotizacion[]
  movimientosCasco   MovimientoCasco[]
  avisosCobranza     AvisoCobranza[]
  reclamos           ReclamoCliente[]
  creditosCliente    CreditoCliente[]

  @@unique([empresaId, ruc])
  @@unique([empresaId, codigo])
  @@map("clientes")
}

enum EstadoPedido {
  PENDIENTE
  PARCIAL
  FACTURADO
  ANULADO
}

enum EstadoCotizacion {
  PENDIENTE
  ACEPTADA
  RECHAZADA
  VENCIDA
  CONVERTIDA // ya generó un Pedido
}

// Cotización: etapa opcional antes del Pedido (frecuente en ventas
// industriales/mineras donde se piden specs y precio antes de comprar). No
// toca stock ni kardex — solo al convertirla se crea un Pedido real.
model Cotizacion {
  id            String           @id @default(cuid())
  empresaId     String           @default("1")
  empresa       Empresa          @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  numero        String // COT-00001
  clienteId     String
  vendedorId    String
  fecha         DateTime         @default(now())
  validaHasta   DateTime
  estado        EstadoCotizacion @default(PENDIENTE)
  total         Decimal
  // Embudo de ventas simple (CRM-014 reducido): probabilidad de cierre
  // estimada por el vendedor, 0-100. Se fija sola a 100/0 al aceptar/rechazar;
  // mientras está PENDIENTE, el vendedor la ajusta a criterio.
  probabilidad  Int              @default(50)
  notas         String?
  pedidoId      String?          @unique // si ya se convirtió
  usuarioId     String
  usuarioNombre String

  cliente  Cliente             @relation(fields: [clienteId], references: [id])
  vendedor Vendedor            @relation(fields: [vendedorId], references: [id])
  pedido   Pedido?             @relation(fields: [pedidoId], references: [id])
  detalles CotizacionDetalle[]

  @@unique([empresaId, numero])
  @@map("cotizaciones")
}

model CotizacionDetalle {
  id             String  @id @default(cuid())
  cotizacionId   String
  presentacionId String
  cantidad       Int
  precioUnitario Decimal
  subtotal       Decimal

  cotizacion   Cotizacion   @relation(fields: [cotizacionId], references: [id])
  presentacion Presentacion @relation(fields: [presentacionId], references: [id])

  @@map("cotizacion_detalles")
}

model Pedido {
  id                      String           @id @default(cuid())
  empresaId               String           @default("1")
  empresa                 Empresa          @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  numero                  String // PED-00001
  clienteId               String
  vendedorId              String
  almacenId               String?
  fecha                   DateTime         @default(now())
  fechaEntregaSolicitada  DateTime?
  estado                  EstadoPedido     @default(PENDIENTE)
  fulfillmentVersion      Int              @default(0)
  requiereEntrega         Boolean          @default(false)
  moneda                  String           @default("PEN")
  tipoCambio              Decimal          @default(1)
  condicionPago           CondicionPago    @default(CONTADO)
  direccionEntrega        String?
  ordenCompraCliente      String?
  referenciaCliente       String?
  subtotalBruto           Decimal          @default(0)
  descuentoTotal          Decimal          @default(0)
  total                   Decimal
  tasaIgv                 Decimal          @default(0)
  igv                     Decimal          @default(0)
  totalConIgv             Decimal          @default(0)
  notas                   String?
  usuarioId               String
  usuarioNombre           String
  estadoAprobacionCredito EstadoAprobacion @default(NO_REQUERIDA)
  condicionPagoCredito    CondicionPago?
  deudaCreditoEvaluada    Decimal?
  montoCreditoEvaluado    Decimal?
  limiteCreditoEvaluado   Decimal?
  creditoSolicitadoEn     DateTime?
  creditoResueltoEn       DateTime?
  creditoResueltoPor      String?
  motivoRechazoCredito    String?

  cliente          Cliente         @relation(fields: [clienteId], references: [id])
  vendedor         Vendedor        @relation(fields: [vendedorId], references: [id])
  almacen          Almacen?        @relation(fields: [almacenId], references: [id])
  detalles         PedidoDetalle[]
  facturas         Factura[]
  guias            GuiaRemision[]
  cotizacionOrigen Cotizacion?

  @@unique([empresaId, numero])
  @@map("pedidos")
}

model PedidoDetalle {
  id                   String  @id @default(cuid())
  pedidoId             String
  presentacionId       String
  cantidad             Int
  precioLista          Decimal @default(0)
  origenPrecio         String  @default("LEGACY")
  cantidadMinimaPrecio Int?
  descuentoPct         Decimal @default(0)
  descuentoMonto       Decimal @default(0)
  precioUnitario       Decimal
  subtotal             Decimal
  costoUnitario        Decimal @default(0) // snapshot del costo promedio al facturar (para costo de ventas)

  pedido              Pedido                @relation(fields: [pedidoId], references: [id])
  presentacion        Presentacion          @relation(fields: [presentacionId], references: [id])
  asignacionesLote    AsignacionLoteVenta[]
  notaCreditoDetalles NotaCreditoDetalle[]
  facturaDetalles     FacturaDetalle[]
  guiaDetalles        GuiaRemisionDetalle[]

  @@map("pedido_detalles")
}

enum CondicionPago {
  CONTADO
  DIAS_15
  DIAS_30
}

enum EstadoFactura {
  PENDIENTE
  PAGADA
  ANULADA
}

// La factura se emite en el portal SUNAT; aquí solo se registra su número.
// Comprobante de venta que corresponde emitir. Es el subconjunto del Catálogo
// 01 de SUNAT que este sistema emite: 01 factura y 03 boleta.
enum TipoComprobanteVenta {
  FACTURA
  BOLETA
}

model Factura {
  id                String               @id @default(cuid())
  empresaId         String               @default("1")
  empresa           Empresa              @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  numero            String // número SUNAT, ej. F001-00000123 / B001-00000123
  // Qué comprobante es esta venta. Se DERIVA del documento del comprador al
  // emitir (RUC peruano → factura; DNI o sin documento → boleta), no del canal
  // comercial ni de una elección del usuario: un minorista que es empresa con
  // RUC recibe factura igual. Ver src/lib/tipoComprobanteVenta.ts.
  //
  // Default FACTURA: todas las ventas anteriores a este campo lo eran — el
  // sistema solo emitía factura — así que el valor histórico es correcto.
  tipoComprobante   TipoComprobanteVenta @default(FACTURA)
  pedidoId          String
  clienteId         String
  vendedorId        String
  moneda            String               @default("PEN")
  tipoCambio        Decimal              @default(1)
  monedaFuncional   String               @default("PEN")
  condicionPago     CondicionPago
  fechaEmision      DateTime             @default(now())
  fechaVencimiento  DateTime
  subtotal          Decimal              @default(0) // valor de venta (base imponible)
  tasaIgv           Decimal              @default(0) // % vigente al emitir (congelado)
  igv               Decimal              @default(0)
  total             Decimal // subtotal + IGV, en moneda del documento
  saldo             Decimal
  subtotalFuncional Decimal              @default(0)
  igvFuncional      Decimal              @default(0)
  totalFuncional    Decimal              @default(0)
  saldoFuncional    Decimal              @default(0)
  estado            EstadoFactura        @default(PENDIENTE)
  motivoAnulacion   String?
  anuladaEn         DateTime?
  anuladaPor        String?
  usuarioId         String
  usuarioNombre     String

  pedido              Pedido                     @relation(fields: [pedidoId], references: [id])
  cliente             Cliente                    @relation(fields: [clienteId], references: [id])
  vendedor            Vendedor                   @relation(fields: [vendedorId], references: [id])
  cobros              Cobro[]
  avisosCobranza      AvisoCobranza[]
  notasCredito        NotaCredito[]
  notasDebito         NotaDebito[]
  comisiones          Comision[]
  guias               GuiaRemision[]
  devolucionesCliente DevolucionCliente[]
  recargosMora        RecargoMora[]
  reclamos            ReclamoCliente[]
  detalles            FacturaDetalle[]
  aplicacionesCredito AplicacionCreditoCliente[]

  @@unique([empresaId, numero])
  @@index([pedidoId])
  @@map("facturas")
}

// Snapshot inmutable de las líneas efectivamente facturadas. Separa el documento
// tributario del pedido origen y habilita facturación parcial sin reescribir historia.
model FacturaDetalle {
  id                      String  @id @default(cuid())
  facturaId               String
  pedidoDetalleId         String
  presentacionId          String
  cantidad                Int
  precioLista             Decimal @default(0)
  origenPrecio            String  @default("LEGACY")
  cantidadMinimaPrecio    Int?
  descuentoPct            Decimal @default(0)
  descuentoMonto          Decimal @default(0)
  precioUnitario          Decimal
  subtotal                Decimal
  precioUnitarioFuncional Decimal @default(0)
  subtotalFuncional       Decimal @default(0)
  costoUnitario           Decimal @default(0)

  factura            Factura                    @relation(fields: [facturaId], references: [id])
  pedidoDetalle      PedidoDetalle              @relation(fields: [pedidoDetalleId], references: [id])
  presentacion       Presentacion               @relation(fields: [presentacionId], references: [id])
  asignacionesLote   AsignacionLoteVenta[]
  entregas           FacturaDetalleEntrega[]
  devolucionDetalles DevolucionClienteDetalle[]

  @@unique([facturaId, pedidoDetalleId])
  @@index([pedidoDetalleId])
  @@index([presentacionId])
  @@map("factura_detalles")
}

// Recargo por mora sobre facturas vencidas: incrementa el saldo por cobrar
// (nunca el total original de la factura, que refleja el valor de venta
// emitido en SUNAT). Cada aplicación cubre solo los días transcurridos desde
// el último recargo (o desde el vencimiento, si es el primero) — no se
// puede duplicar el cobro de los mismos días de atraso.
model RecargoMora {
  id             String   @id @default(cuid())
  facturaId      String
  fecha          DateTime @default(now())
  diasCalculados Int
  tasaAplicada   Decimal // % mensual vigente al momento de aplicar
  monto          Decimal
  moneda         String   @default("PEN")
  tipoCambio     Decimal  @default(1)
  montoFuncional Decimal  @default(0)
  usuarioId      String
  usuarioNombre  String

  factura    Factura     @relation(fields: [facturaId], references: [id])
  notaDebito NotaDebito?

  @@map("recargos_mora")
}

// Aviso de cobranza (dunning): registro de que se avisó a un cliente sobre
// una factura vencida, en un nivel de escalamiento creciente. No envía
// correo/SMS real (este ERP no tiene esa integración) — es el registro de
// que el aviso se emitió (para imprimir/entregar) y en qué nivel, para poder
// distinguir "primera vez que se avisa" de "ya se le avisó 3 veces".
// Política de escalamiento de cobranza.
//
// La fila existe **solo si el negocio la definió**. Sin fila no hay
// escalamiento y la pantalla funciona como antes: el nivel se sugiere por
// antigüedad y lo decide una persona. Cuándo escalar es política de cobranza,
// y el sistema no elige una por su cuenta.
model PoliticaCobranza {
  id        String  @id @default(cuid())
  empresaId String  @unique
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  // Antigüedad de la factura que corresponde a cada nivel. Nacen en 15 y 30,
  // que son los umbrales que el código ya traía fijos: encender la política no
  // cambia por sí solo el nivel que se venía sugiriendo.
  diasNivel2 Int @default(15)
  diasNivel3 Int @default(30)

  // Reglas opcionales: `null` = la regla NO corre. Cada una es una decisión
  // propia, y ninguna se enciende sola por el hecho de definir la política.
  //
  // Días que un aviso puede quedarse sin respuesta antes de que toque el
  // siguiente nivel.
  diasSinRespuesta     Int?
  // Días de gracia después de la fecha de un compromiso incumplido.
  diasGraciaCompromiso Int?

  // Perseguir a un cliente por una factura que todavía se le está
  // investigando es el único desenlace que nadie quiere; por eso viene
  // activado. Es un valor por defecto, no una regla: se apaga con un clic.
  pausarEnDisputa Boolean @default(true)

  actualizadoEn        DateTime @updatedAt
  actualizadoPorId     String
  actualizadoPorNombre String

  @@map("politicas_cobranza")
}

// Qué contestó el cliente al aviso. Solo hechos que alguien registra después
// de hablar con él — el sistema no deduce ninguno por su cuenta.
enum EstadoAvisoCobranza {
  PENDIENTE // emitido, todavía sin respuesta
  COMPROMISO_PAGO // el cliente se comprometió a una fecha
  EN_DISPUTA // el cliente objeta la factura
  SIN_RESPUESTA // se le contactó y no contestó
}

model AvisoCobranza {
  id            String   @id @default(cuid())
  empresaId     String   @default("1")
  empresa       Empresa  @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  clienteId     String
  facturaId     String
  nivel         Int // 1 = aviso amistoso, 2 = aviso formal, 3 = aviso final
  diasVencidos  Int // snapshot al momento de emitir el aviso
  fecha         DateTime @default(now())
  usuarioId     String
  usuarioNombre String

  // Seguimiento del aviso. Sin esto la tabla es un log de avisos emitidos: se
  // sabe a quién se le escribió y nunca qué pasó después.
  estado              EstadoAvisoCobranza @default(PENDIENTE)
  // Obligatorio cuando el estado es COMPROMISO_PAGO, y es lo único que
  // convierte el seguimiento en proceso: un compromiso cuya fecha pasó con la
  // factura todavía impaga es un incumplimiento, y eso se DERIVA, no se guarda
  // (un estado guardado se queda viejo apenas cambia el saldo o el día).
  compromisoPagoEn    DateTime?
  detalleRespuesta    String?
  respondidoEn        DateTime?
  respondidoPorId     String?
  respondidoPorNombre String?

  cliente Cliente @relation(fields: [clienteId], references: [id])
  factura Factura @relation(fields: [facturaId], references: [id])

  @@map("avisos_cobranza")
}

// --- Facturación electrónica SUNAT (vía OSE) --------------------------------

enum TipoComprobanteElectronico {
  FACTURA
  BOLETA
  NOTA_CREDITO
  NOTA_DEBITO
  GUIA_REMISION
}

enum EstadoEnvioSunat {
  PENDIENTE // aún no se intentó enviar
  ENVIADO // se envió al OSE, esperando confirmación de SUNAT
  ACEPTADO
  RECHAZADO // SUNAT rechazó el comprobante (ej. datos inválidos)
  OBSERVADO // SUNAT lo aceptó con observaciones
  ERROR // falló la llamada al OSE (red, credenciales, etc.), no es un rechazo de SUNAT
}

// Ledger de envíos a un OSE (Operador de Servicios Electrónicos: Nubefact,
// Bizlinks, etc.) para dar validez tributaria real a Factura/NotaCredito/
// GuiaRemision. Independiente del documento comercial: si un envío falla o
// queda observado, se puede reintentar sin tocar el documento original.
// "Best-effort" igual que el motor contable: si el envío falla, el documento
// comercial ya está creado y la operación no se bloquea.
model ComprobanteElectronico {
  id               String                     @id @default(cuid())
  empresaId        String                     @default("1")
  empresa          Empresa                    @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  tipoDocumento    TipoComprobanteElectronico
  documentoId      String
  numeroDocumento  String // copia del numero de Factura/NotaCredito/GuiaRemision, para no resolver la relación polimórfica solo para mostrarlo
  estado           EstadoEnvioSunat           @default(PENDIENTE)
  proveedorOse     String // snapshot del proveedor usado en este envío (ConfiguracionEmpresa.oseProveedor al momento)
  codigoHash       String?
  sunatDescripcion String?
  enlacePdf        String?
  enlaceXml        String?
  enlaceCdr        String?
  intentos         Int                        @default(0)
  ultimoIntentoEn  DateTime?
  creadoEn         DateTime                   @default(now())

  @@unique([empresaId, tipoDocumento, documentoId])
  @@map("comprobantes_electronicos")
}

enum MedioPago {
  EFECTIVO
  TRANSFERENCIA
  DEPOSITO
  YAPE
  PLIN
  OTRO
}

model Cobro {
  id                   String    @id @default(cuid())
  empresaId            String    @default("1")
  empresa              Empresa   @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  facturaId            String
  fecha                DateTime  @default(now())
  monto                Decimal
  moneda               String    @default("PEN")
  tipoCambio           Decimal   @default(1)
  montoFuncional       Decimal   @default(0)
  cxcFuncionalAplicada Decimal   @default(0)
  diferenciaCambio     Decimal   @default(0)
  medioPago            MedioPago
  referencia           String?
  usuarioId            String
  usuarioNombre        String

  factura Factura @relation(fields: [facturaId], references: [id])

  @@map("cobros")
}

// Catálogo 9 de SUNAT (código de tipo de nota de crédito) — el adaptador OSE
// tiene que mandar uno de estos códigos, no un texto libre. `motivo` sigue
// siendo el sustento en palabras (ej. "ERROR DE DIGITACION"), tipoNota es
// el código que exige el XML.
enum TipoNotaCredito {
  ANULACION_OPERACION // 01
  ANULACION_ERROR_RUC // 02
  CORRECCION_DESCRIPCION // 03
  DESCUENTO_GLOBAL // 04
  DESCUENTO_ITEM // 05
  DEVOLUCION_TOTAL // 06
  DEVOLUCION_ITEM // 07
  BONIFICACION // 08
  DISMINUCION_VALOR // 09
  OTROS_CONCEPTOS // 10
}

// Catálogo 10 de SUNAT: tipo de nota de débito.
//
// Los tres códigos están para que el catálogo quede completo y correcto, pero
// **hoy solo se emite INTERES_MORA**, que es el único concepto que el sistema
// calcula por su cuenta (el recargo por mora sobre facturas vencidas).
//
// Emitir una nota de débito por aumento de valor o por penalidad exige decidir
// cuándo corresponde y sobre qué base — decisión del negocio que este código
// no inventa. El día que se defina, el código ya está.
enum TipoNotaDebito {
  INTERES_MORA // 01
  AUMENTO_VALOR // 02
  PENALIDAD_OTROS // 03
}

// Documento formal del recargo por mora.
//
// IMPORTANTE: la nota de débito NO vuelve a cargar nada. El recargo ya
// aumentó el saldo de la factura y ya generó su asiento cuando se aplicó
// (`aplicarRecargoAFactura`); esto es el comprobante de ese recargo, no un
// segundo cobro. Emitirla no toca saldo ni contabilidad, y una prueba lo exige.
//
// Por eso cuelga de un RecargoMora concreto y con relación 1 a 1: un recargo
// tiene a lo sumo una nota de débito, y una nota de débito documenta un
// recargo.
model NotaDebito {
  id             String         @id @default(cuid())
  empresaId      String         @default("1")
  empresa        Empresa        @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  numero         String // número SUNAT de la ND
  facturaId      String
  // Solo la nota de tipo 01 nace de un recargo por mora ya aplicado. Las de
  // tipo 02 y 03 las emite una persona y no tienen recargo detrás, así que
  // aquí va NULL. El índice único se mantiene: SQLite y PostgreSQL tratan cada
  // NULL como distinto, de modo que muchas notas pueden no tener recargo pero
  // un recargo sigue admitiendo una sola nota.
  recargoMoraId  String?        @unique
  fecha          DateTime       @default(now())
  // `monto` es el TOTAL del documento. El desglose existe porque una nota por
  // aumento de valor sí puede estar afecta a IGV; la de mora documenta un
  // recargo ya aplicado y nunca llevó.
  //
  // `afectoIgv` no tiene un valor que el sistema pueda asumir: si un concepto
  // está afecto es criterio tributario del contador, distinto para un ajuste
  // de precio que para una penalidad. Quien emite lo declara explícitamente.
  baseImponible  Decimal
  igv            Decimal        @default(0)
  afectoIgv      Boolean        @default(false)
  monto          Decimal
  moneda         String         @default("PEN")
  tipoCambio     Decimal        @default(1)
  montoFuncional Decimal        @default(0)
  motivo         String
  tipoNota       TipoNotaDebito @default(INTERES_MORA)
  usuarioId      String
  usuarioNombre  String

  factura     Factura      @relation(fields: [facturaId], references: [id])
  // Restrict y no el SET NULL que Prisma pone por defecto en una relación
  // opcional: si al borrar un recargo la nota quedara con NULL, pasaría a ser
  // indistinguible de una emitida a mano, que es justo lo contrario de lo que
  // documenta.
  recargoMora RecargoMora? @relation(fields: [recargoMoraId], references: [id], onDelete: Restrict)

  @@unique([empresaId, numero])
  @@map("notas_debito")
}

model NotaCredito {
  id             String          @id @default(cuid())
  empresaId      String          @default("1")
  empresa        Empresa         @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  numero         String // número SUNAT de la NC
  facturaId      String
  fecha          DateTime        @default(now())
  monto          Decimal
  moneda         String          @default("PEN")
  tipoCambio     Decimal         @default(1)
  montoFuncional Decimal         @default(0)
  motivo         String
  tipoNota       TipoNotaCredito @default(OTROS_CONCEPTOS)
  usuarioId      String
  usuarioNombre  String

  factura  Factura              @relation(fields: [facturaId], references: [id])
  detalles NotaCreditoDetalle[]
