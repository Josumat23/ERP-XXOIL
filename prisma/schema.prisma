  oferta   OfertaRfq      @relation(fields: [ofertaId], references: [id], onDelete: Cascade)
  rfqLinea RfqCompraLinea @relation(fields: [rfqLineaId], references: [id])

  @@unique([ofertaId, rfqLineaId])
  @@map("oferta_rfq_lineas")
}

model OrdenCompra {
  id              String            @id @default(cuid())
  empresaId       String            @default("1")
  empresa         Empresa           @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  numero          String // OC-00001
  proveedorId     String
  almacenId       String? // almacén/planta de destino (opcional: si no se elige, la recepción resuelve el almacén como siempre)
  fecha           DateTime          @default(now())
  estado          EstadoOrdenCompra @default(PENDIENTE)
  moneda          String            @default("PEN")
  // Tipo de cambio congelado al crear la orden (S//US$; 1 si moneda=PEN).
  // total queda en `moneda`; todo lo que necesita PEN (umbral de aprobación,
  // cuenta por pagar, asiento contable) se convierte con este valor.
  tipoCambio      Decimal           @default(1)
  total           Decimal
  notas           String?
  motivoAnulacion String?
  usuarioId       String
  usuarioNombre   String

  // Aprobación por monto: se calcula al crear la orden contra el umbral
  // vigente en Configuración → Empresa. Si queda PENDIENTE, no se puede
  // registrar recepción hasta que Gerencia/Admin la apruebe.
  estadoAprobacion EstadoAprobacion @default(NO_REQUERIDA)
  aprobadaPor      String?
  aprobadaEn       DateTime?
  motivoRechazo    String?

  // Etiqueta opcional a un proyecto/fase de obra de capital — el costo real
  // del proyecto se calcula sumando estas OC (estado != ANULADA) más
  // CostoProyecto, sin doble registro.
  proyectoId String?
  edtId      String?
  rfqId      String? @unique
  acuerdoId  String?

  proveedor       Proveedor              @relation(fields: [proveedorId], references: [id])
  almacen         Almacen?               @relation(fields: [almacenId], references: [id])
  detalles        OrdenCompraDetalle[]
  recepciones     RecepcionCompra[]
  cuentasPorPagar CuentaPorPagar[]
  proyecto        Proyecto?              @relation(fields: [proyectoId], references: [id])
  edt             EdtProyecto?           @relation(fields: [edtId], references: [id])
  rfq             RfqCompra?             @relation(fields: [rfqId], references: [id])
  pasosAprobacion PasoAprobacionCompra[]
  acuerdo         AcuerdoSuministro?     @relation(fields: [acuerdoId], references: [id])

  @@unique([empresaId, numero])
  @@map("ordenes_compra")
}

model NivelAprobacionCompra {
  id            String     @id @default(cuid())
  empresaId     String     @default("1")
  empresa       Empresa    @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  orden         Int
  nombre        String
  montoDesdePen Decimal
  rolAprobador  RolUsuario @default(GERENCIA)
  // Nivel acotado a una planta. null = aplica a toda la compañía. Una orden
  // recorre la union de ambos: los generales MAS los de su planta, nunca
  // menos, para que configurar una planta no pueda aflojar el control.
  almacenId     String?
  almacen       Almacen?   @relation(fields: [almacenId], references: [id])
  activo        Boolean    @default(true)
  creadoEn      DateTime   @default(now())

  // El orden es la posición en la secuencia combinada de la compañía, por eso
  // sigue siendo único aunque el nivel sea de una planta.
  @@unique([empresaId, orden])
  @@index([empresaId, almacenId, activo])
  @@map("niveles_aprobacion_compra")
}

model PasoAprobacionCompra {
  id                String               @id @default(cuid())
  ordenCompraId     String
  orden             Int
  nombre            String
  montoDesdePen     Decimal
  rolAprobador      RolUsuario
  estado            EstadoPasoAprobacion @default(PENDIENTE)
  resueltoPorId     String?
  resueltoPorNombre String?
  resueltoEn        DateTime?
  motivo            String?
  creadoEn          DateTime             @default(now())

  ordenCompra OrdenCompra @relation(fields: [ordenCompraId], references: [id], onDelete: Cascade)

  @@unique([ordenCompraId, orden])
  @@map("pasos_aprobacion_compra")
}

model OrdenCompraDetalle {
  id                   String    @id @default(cuid())
  ordenCompraId        String
  insumoId             String
  cantidad             Decimal
  costoUnitario        Decimal
  subtotal             Decimal
  cantidadRecibida     Decimal   @default(0)
  fechaEntregaEsperada DateTime? // fecha pactada con el proveedor para esta línea
  acuerdoLineaId       String?

  ordenCompra  OrdenCompra             @relation(fields: [ordenCompraId], references: [id])
  insumo       Insumo                  @relation(fields: [insumoId], references: [id])
  acuerdoLinea AcuerdoSuministroLinea? @relation(fields: [acuerdoLineaId], references: [id])

  @@map("orden_compra_detalles")
}

model RecepcionCompra {
  id            String   @id @default(cuid())
  empresaId     String   @default("1")
  empresa       Empresa  @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  numero        String // RC-00001
  ordenCompraId String
  fecha         DateTime @default(now())
  notas         String?
  usuarioId     String
  usuarioNombre String

  ordenCompra     OrdenCompra              @relation(fields: [ordenCompraId], references: [id])
  detalles        RecepcionCompraDetalle[]
  cuentasPorPagar CuentaPorPagar[]

  @@unique([empresaId, numero])
  @@map("recepciones_compra")
