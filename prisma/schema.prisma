model RecepcionCompraDetalle {
  id                  String  @id @default(cuid())
  recepcionId         String
  insumoId            String
  cantidad            Decimal
  costoUnitario       Decimal // costo real de esta recepción (actualiza el promedio ponderado)
  // Trazabilidad de materia prima: número de lote/certificado del proveedor.
  // cantidadDisponible arranca en `cantidad` cuando el stock queda disponible
  // (de inmediato, o al aprobar inspección de calidad) y baja según se
  // consume en producción (ver AsignacionLoteInsumo) — mismo patrón que
  // Envasado.unidadesDisponibles para la venta.
  numeroLoteProveedor String?
  cantidadDisponible  Decimal @default(0)

  recepcion        RecepcionCompra        @relation(fields: [recepcionId], references: [id])
  insumo           Insumo                 @relation(fields: [insumoId], references: [id])
  inspeccion       InspeccionCompra?
  asignacionesLote AsignacionLoteInsumo[]
  devoluciones     DevolucionCompra[]

  @@map("recepcion_compra_detalles")
}

// Devolución de un insumo/materia prima a su proveedor (defecto, no
// conformidad detectada después de recibido). Reduce el stock físico, cancela
// la CxP abierta y conserva cualquier excedente como activo recuperable en el
// subledger del proveedor. El comprobante lo emite el proveedor, no XXOil.
model DevolucionCompra {
  id                       String   @id @default(cuid())
  empresaId                String   @default("1")
  empresa                  Empresa  @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  recepcionCompraDetalleId String
  cantidad                 Decimal
  motivo                   String
  montoCredito             Decimal // importe en moneda de la OC para trazabilidad
  montoFuncional           Decimal  @default(0) // valor en PEN usado por CxP y contabilidad
  usuarioId                String
  usuarioNombre            String
  creadoEn                 DateTime @default(now())

  recepcionCompraDetalle RecepcionCompraDetalle @relation(fields: [recepcionCompraDetalleId], references: [id])
  credito                CreditoProveedor?

  @@map("devoluciones_compra")
}

enum EstadoCreditoProveedor {
  DISPONIBLE
  AGOTADO
}

model CreditoProveedor {
  id                     String                 @id @default(cuid())
  empresaId              String                 @default("1")
  empresa                Empresa                @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  proveedorId            String
  devolucionCompraId     String                 @unique
  montoFuncionalOriginal Decimal
  saldoFuncional         Decimal
  estado                 EstadoCreditoProveedor @default(DISPONIBLE)
  creadoEn               DateTime               @default(now())

  proveedor    Proveedor                    @relation(fields: [proveedorId], references: [id])
  devolucion   DevolucionCompra             @relation(fields: [devolucionCompraId], references: [id])
  aplicaciones AplicacionCreditoProveedor[]
  reembolsos   ReembolsoProveedor[]

  @@index([proveedorId, estado])
  @@map("creditos_proveedor")
}

model AplicacionCreditoProveedor {
  id               String   @id @default(cuid())
  empresaId        String   @default("1")
  empresa          Empresa  @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  creditoId        String
  cuentaPorPagarId String
  fecha            DateTime @default(now())
  montoFuncional   Decimal
  usuarioId        String
  usuarioNombre    String

  credito        CreditoProveedor @relation(fields: [creditoId], references: [id])
  cuentaPorPagar CuentaPorPagar   @relation(fields: [cuentaPorPagarId], references: [id])

  @@index([creditoId])
  @@index([cuentaPorPagarId])
  @@map("aplicaciones_credito_proveedor")
}

model ReembolsoProveedor {
  id             String    @id @default(cuid())
  empresaId      String    @default("1")
  empresa        Empresa   @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  creditoId      String
  fecha          DateTime  @default(now())
  montoFuncional Decimal
  medioPago      MedioPago
  referencia     String?
  usuarioId      String
  usuarioNombre  String

  credito CreditoProveedor @relation(fields: [creditoId], references: [id])

  @@index([creditoId])
  @@map("reembolsos_proveedor")
}

// Ledger de consumo (solo ida, sin reversos: un LoteGranel no se "anula")
// que permite responder, ante un problema de calidad de materia prima,
// "¿qué lotes granel consumieron el lote de proveedor X?".
model AsignacionLoteInsumo {
  id                       String   @id @default(cuid())
  loteGranelId             String
  recepcionCompraDetalleId String
  cantidad                 Decimal
  creadoEn                 DateTime @default(now())

  loteGranel                      LoteGranel                       @relation(fields: [loteGranelId], references: [id])
  recepcionCompraDetalle          RecepcionCompraDetalle           @relation(fields: [recepcionCompraDetalleId], references: [id])
  devolucionAsignacionLoteInsumos DevolucionAsignacionLoteInsumo[]

  @@map("asignaciones_lote_insumo")
}

enum ResultadoInspeccion {
  PENDIENTE
  APROBADO
  RECHAZADO
}

// Inspección de calidad al recibir insumos marcados con requiereInspeccion:
// la cantidad recibida no suma stock (ni recalcula el costo promedio) hasta
// que se aprueba aquí. Un rechazo nunca entra al kardex (devolución al
// proveedor se maneja fuera del sistema, igual que las notas de crédito).
model InspeccionCompra {
  id                       String              @id @default(cuid())
  recepcionCompraDetalleId String              @unique
  resultado                ResultadoInspeccion @default(PENDIENTE)
  observaciones            String?
  usuarioId                String?
  usuarioNombre            String?
  fecha                    DateTime?
  creadoEn                 DateTime            @default(now())
  planInspeccionId         String?
  planVersion              Int?

  recepcionDetalle RecepcionCompraDetalle     @relation(fields: [recepcionCompraDetalleId], references: [id])
  planInspeccion   PlanInspeccionInsumo?      @relation(fields: [planInspeccionId], references: [id])
  mediciones       MedicionInspeccionCompra[]

  @@map("inspecciones_compra")
}

model PlanInspeccionInsumo {
  id            String    @id @default(cuid())
  empresaId     String    @default("1")
  empresa       Empresa   @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  insumoId      String
  version       Int
  nombre        String
  activo        Boolean   @default(true)
  vigenteDesde  DateTime  @default(now())
  vigenteHasta  DateTime?
  usuarioId     String
  usuarioNombre String
  creadoEn      DateTime  @default(now())

  insumo          Insumo                     @relation(fields: [insumoId], references: [id])
  caracteristicas CaracteristicaPlanInsumo[]
  inspecciones    InspeccionCompra[]

  @@unique([insumoId, version])
  @@index([empresaId, activo])
  @@map("planes_inspeccion_insumo")
}

model CaracteristicaPlanInsumo {
  id             String   @id @default(cuid())
  planId         String
  secuencia      Int
  nombre         String
  unidadMedida   String
  limiteInferior Decimal?
  limiteSuperior Decimal?
  metodoEnsayo   String?
  obligatoria    Boolean  @default(true)

  plan PlanInspeccionInsumo @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, secuencia])
  @@map("caracteristicas_plan_insumo")
}

model MedicionInspeccionCompra {
  id                 String   @id @default(cuid())
  inspeccionCompraId String
  secuencia          Int
  nombre             String
  unidadMedida       String
  limiteInferior     Decimal?
  limiteSuperior     Decimal?
  metodoEnsayo       String?
  valorMedido        Decimal
  conforme           Boolean

  inspeccion InspeccionCompra @relation(fields: [inspeccionCompraId], references: [id], onDelete: Cascade)

  @@unique([inspeccionCompraId, secuencia])
  @@map("mediciones_inspeccion_compra")
}

// ---------------------------------------------------------------------------
// LOGISTICA — GUIAS DE REMISION (traslado de mercadería, formato SUNAT)
// ---------------------------------------------------------------------------

enum EstadoDespacho {
  PLANIFICADO
  EN_RUTA
  ENTREGADO
  ANULADO
}

// Catálogo 20 de SUNAT: determina qué otro dato es obligatorio (público
// exige el RUC del transportista; privado exige placa + DNI del conductor,
// ya existentes en el modelo).
enum ModalidadTransporte {
  PUBLICO
  PRIVADO
}

model GuiaRemision {
  id                  String              @id @default(cuid())
  empresaId           String              @default("1")
  empresa             Empresa             @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  numero              String // ej. T001-00000001
  facturaId           String?
  pedidoId            String?
  clienteId           String
  fechaTraslado       DateTime
  puntoPartida        String
  puntoLlegada        String
  // Código UBIGEO (6 dígitos) de SUNAT — obligatorio para el XML, distinto
  // de puntoPartida/puntoLlegada (que son la dirección textual impresa).
  ubigeoPartidaId     String?
  ubigeoLlegadaId     String?
  motivoTraslado      String              @default("Venta")
  // Obligatorio para SUNAT (Catálogo 3, unidad KGM) — sin este dato el XML
  // de la guía es inválido.
  pesoBrutoTotal      Decimal             @default(0)
  modalidadTransporte ModalidadTransporte @default(PRIVADO)
  transportista       String?
  // RUC de la empresa transportista — obligatorio cuando modalidadTransporte
  // = PUBLICO (transporte contratado a terceros, no flota propia).
  transportistaRuc    String?
  placaVehiculo       String?
  dniConductor        String?
  observaciones       String?
  // Vehículo de flota propia que ejecuta el despacho (opcional: un
  // transportista externo puntual no tiene Equipo que vincular). Da
  // visibilidad real de la flota — de qué vehículo salió cada guía — y
  // conecta con su historial de mantenimiento.
  equipoId            String?
  estadoDespacho      EstadoDespacho      @default(PLANIFICADO)
  fechaSalida         DateTime?
  fechaEntrega        DateTime?
  anuladaEn           DateTime?
  anuladaPorId        String?
  anuladaPorNombre    String?
  motivoAnulacion     String?
  usuarioId           String
  usuarioNombre       String
  creadoEn            DateTime            @default(now())

  factura       Factura?              @relation(fields: [facturaId], references: [id])
  pedido        Pedido?               @relation(fields: [pedidoId], references: [id])
  cliente       Cliente               @relation(fields: [clienteId], references: [id])
  equipo        Equipo?               @relation(fields: [equipoId], references: [id])
  ubigeoPartida Ubigeo?               @relation("UbigeoPartida", fields: [ubigeoPartidaId], references: [id])
  ubigeoLlegada Ubigeo?               @relation("UbigeoLlegada", fields: [ubigeoLlegadaId], references: [id])
  detalles      GuiaRemisionDetalle[]

  @@unique([empresaId, numero])
  @@index([pedidoId])
  @@map("guias_remision")
}

// Catálogo oficial SUNAT de códigos UBIGEO (INEI/RENIEC/SUNAT no siempre
// coinciden — este modelo usa específicamente el código SUNAT, que es el
// que exige el XML de la guía). Sembrado desde prisma/data/ubigeos.json
// (fuente: CONCYTEC, derivado del Excel oficial que SUNAT publica).
model Ubigeo {
  id           String @id @default(cuid())
  codigo       String @unique // 6 dígitos
  departamento String
  provincia    String
  distrito     String

  guiasPartida    GuiaRemision[]         @relation("UbigeoPartida")
  guiasLlegada    GuiaRemision[]         @relation("UbigeoLlegada")
  clientes        Cliente[]
  proveedores     Proveedor[]
  almacenes       Almacen[]
  configuraciones ConfiguracionEmpresa[]

  @@map("ubigeos")
}

model GuiaRemisionDetalle {
  id              String  @id @default(cuid())
  guiaId          String
  presentacionId  String
  pedidoDetalleId String?
  cantidad        Int
  costoUnitario   Decimal @default(0)

  guia                GuiaRemision            @relation(fields: [guiaId], references: [id])
  presentacion        Presentacion            @relation(fields: [presentacionId], references: [id])
  pedidoDetalle       PedidoDetalle?          @relation(fields: [pedidoDetalleId], references: [id])
  facturaAsignaciones FacturaDetalleEntrega[]
  asignacionesLote    AsignacionLoteVenta[]

  @@index([pedidoDetalleId])
  @@map("guia_remision_detalles")
}

model FacturaDetalleEntrega {
  id               String @id @default(cuid())
  facturaDetalleId String
  guiaDetalleId    String
  cantidad         Int

  facturaDetalle FacturaDetalle      @relation(fields: [facturaDetalleId], references: [id])
  guiaDetalle    GuiaRemisionDetalle @relation(fields: [guiaDetalleId], references: [id])

  @@unique([facturaDetalleId, guiaDetalleId])
  @@index([guiaDetalleId])
  @@map("factura_detalle_entregas")
}

// ---------------------------------------------------------------------------
// FINANZAS — CUENTAS POR PAGAR Y CAJA
// ---------------------------------------------------------------------------

enum EstadoCuentaPorPagar {
  PENDIENTE
  PAGADA
}

enum EstadoVerificacionFacturaProveedor {
  COINCIDE
  BLOQUEADA
  APROBADA_EXCEPCION
}

model CuentaPorPagar {
  id                            String                             @id @default(cuid())
  empresaId                     String                             @default("1")
  empresa                       Empresa                            @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  proveedorId                   String
  ordenCompraId                 String?
  recepcionCompraId             String? // recepción que originó esta CxP (para poder aplicar devoluciones)
  numeroDocumento               String // factura del proveedor, formato "serie-número" (ej. F001-123)
  // Código de Tabla 10 de SUNAT (01 Factura, 03 Boleta, 04 Liquidación de
  // compra, 91 comprobante de no domiciliado, etc.) — para el Registro de
  // Compras Electrónico (PLE). Default Factura, el caso normal en compras B2B.
  tipoComprobante               String                             @default("01")
  fechaEmision                  DateTime                           @default(now())
  fechaVencimiento              DateTime?
  moneda                        String                             @default("PEN")
  total                         Decimal // siempre en PEN (moneda funcional)
  saldo                         Decimal // siempre en PEN
  // Referencia informativa cuando la compra original fue en otra moneda
  // (ej. USD): monto/moneda tal como llegó la factura del proveedor, y el
  // tipo de cambio usado para convertir total/saldo a PEN. null si ya nació
  // en PEN — no es una revaluación, solo trazabilidad.
  montoOriginal                 Decimal?
  monedaOriginal                String?
  tipoCambio                    Decimal?
  // % de variación entre el costo unitario registrado en la recepción y el
  // costo pactado en la orden de compra (verificación de factura en 3 vías:
  // orden↔recepción↔lo que se está por pagar). null = sin discrepancia
  // detectada o por debajo de la tolerancia (5%). No bloquea el pago — solo
  // lo señala, porque el sistema no debe ser rígido ante regularizaciones.
  discrepanciaPrecioPct         Decimal?
  estadoVerificacion            EstadoVerificacionFacturaProveedor @default(COINCIDE)
  verificacionResueltaPorId     String?
  verificacionResueltaPorNombre String?
  verificacionResueltaEn        DateTime?
  motivoExcepcion               String?
  estado                        EstadoCuentaPorPagar               @default(PENDIENTE)
  usuarioId                     String
  usuarioNombre                 String

  proveedor           Proveedor                    @relation(fields: [proveedorId], references: [id])
  ordenCompra         OrdenCompra?                 @relation(fields: [ordenCompraId], references: [id])
  recepcionCompra     RecepcionCompra?             @relation(fields: [recepcionCompraId], references: [id])
  pagos               PagoProveedor[]
  aplicacionesCredito AplicacionCreditoProveedor[]

  @@map("cuentas_por_pagar")
}

model PagoProveedor {
  id               String    @id @default(cuid())
  empresaId        String    @default("1")
  empresa          Empresa   @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  cuentaPorPagarId String
  fecha            DateTime  @default(now())
  monto            Decimal
  medioPago        MedioPago
  referencia       String?
  usuarioId        String
  usuarioNombre    String

  // Aprobación por monto: si queda PENDIENTE, el pago se registra pero NO
  // se descuenta de caja ni del saldo de la cuenta hasta que se apruebe
  // (separa "quien pide el pago" de "quien dispone del dinero").
  estadoAprobacion EstadoAprobacion @default(NO_REQUERIDA)
  aprobadoPor      String?
  aprobadoEn       DateTime?
  motivoRechazo    String?

  cuentaPorPagar CuentaPorPagar @relation(fields: [cuentaPorPagarId], references: [id])

  @@map("pagos_proveedor")
}

enum TipoMovimientoCaja {
  INGRESO
  EGRESO
}

// Libro de caja: los cobros de facturas y pagos a proveedores generan
// movimientos automáticos; también admite movimientos manuales con concepto.
model MovimientoCaja {
  id               String             @id @default(cuid())
  empresaId        String             @default("1")
  empresa          Empresa            @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  fecha            DateTime           @default(now())
  tipo             TipoMovimientoCaja
  concepto         String
  monto            Decimal
  moneda           String             @default("PEN")
  tipoCambio       Decimal            @default(1)
  montoOriginal    Decimal?
  medioPago        MedioPago
  referencia       String? // nro de factura, OC, comisión, etc.
  usuarioId        String
  usuarioNombre    String
  cuentaBancariaId String?

  cuentaBancaria CuentaBancariaEmpresa?           @relation(fields: [cuentaBancariaId], references: [id])
  conciliaciones ConciliacionBancariaAplicacion[]

  @@index([cuentaBancariaId, fecha])
  @@map("movimientos_caja")
}

enum EstadoConciliacionBancaria {
  BORRADOR
  CERRADA
  ANULADA
}

model ConciliacionBancaria {
  id                   String                     @id @default(cuid())
  empresaId            String                     @default("1")
  empresa              Empresa                    @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  cuentaBancariaId     String
  fechaDesde           DateTime
  fechaHasta           DateTime
  saldoInicialExtracto Decimal
  saldoFinalExtracto   Decimal
  estado               EstadoConciliacionBancaria @default(BORRADOR)
  cerradaEn            DateTime?
  cerradaPorId         String?
  cerradaPorNombre     String?
  anuladaEn            DateTime?
  anuladaPorId         String?
  anuladaPorNombre     String?
  motivoAnulacion      String?
  usuarioId            String
  usuarioNombre        String
  creadoEn             DateTime                   @default(now())

  cuentaBancaria CuentaBancariaEmpresa        @relation(fields: [cuentaBancariaId], references: [id])
  movimientos    MovimientoExtractoBancario[]

  @@unique([cuentaBancariaId, fechaDesde, fechaHasta])
  @@index([empresaId, estado])
  @@map("conciliaciones_bancarias")
}

model MovimientoExtractoBancario {
  id             String             @id @default(cuid())
  conciliacionId String
  fecha          DateTime
  tipo           TipoMovimientoCaja
  descripcion    String
  referencia     String?
  monto          Decimal
  huella         String
  creadoEn       DateTime           @default(now())

  conciliacion ConciliacionBancaria             @relation(fields: [conciliacionId], references: [id])
  aplicaciones ConciliacionBancariaAplicacion[]

  @@unique([conciliacionId, huella])
  @@index([conciliacionId, fecha])
  @@map("movimientos_extracto_bancario")
}

model ConciliacionBancariaAplicacion {
  id                   String   @id @default(cuid())
  movimientoExtractoId String
  movimientoCajaId     String
  monto                Decimal
  usuarioId            String
  usuarioNombre        String
  creadoEn             DateTime @default(now())

  movimientoExtracto MovimientoExtractoBancario @relation(fields: [movimientoExtractoId], references: [id])
  movimientoCaja     MovimientoCaja             @relation(fields: [movimientoCajaId], references: [id])

  @@unique([movimientoExtractoId, movimientoCajaId])
  @@index([movimientoCajaId])
  @@map("conciliaciones_bancarias_aplicaciones")
}

// ---------------------------------------------------------------------------
// COMERCIAL — HOJAS DE RUTA DE VENDEDORES
// ---------------------------------------------------------------------------

enum EstadoHojaRuta {
  PLANIFICADA
  COMPLETADA
}

model HojaRuta {
  id            String         @id @default(cuid())
  empresaId     String         @default("1")
  empresa       Empresa        @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  numero        String // HR-00001
  vendedorId    String
  fecha         DateTime
  estado        EstadoHojaRuta @default(PLANIFICADA)
  notas         String?
  usuarioId     String
  usuarioNombre String
  creadoEn      DateTime       @default(now())

  vendedor Vendedor         @relation(fields: [vendedorId], references: [id])
  visitas  HojaRutaVisita[]

  @@unique([empresaId, numero])
  @@map("hojas_ruta")
}

model HojaRutaVisita {
  id         String  @id @default(cuid())
  hojaRutaId String
  clienteId  String
  orden      Int
  objetivo   String? // cobrar, ofrecer producto nuevo, etc.
  resultado  String? // se llena al cerrar la ruta

  hojaRuta HojaRuta @relation(fields: [hojaRutaId], references: [id])
  cliente  Cliente  @relation(fields: [clienteId], references: [id])

  @@map("hoja_ruta_visitas")
}

// ---------------------------------------------------------------------------
// SYSTEM SETUP — FASE 2 (equivalente reducido a los programas de
// configuración de sistema de Epicor: Legal Numbers, Warehouse/Warehouse
// Zone, UOM Maintenance, Security Group Maintenance, Fiscal Calendar).
// ---------------------------------------------------------------------------

// --- Numeración legal de documentos (Legal Number / Document Type) ---------

enum TipoDocumentoSerie {
  FACTURA
  BOLETA
  NOTA_CREDITO
  NOTA_DEBITO
  GUIA_REMISION
}

// Catálogo de series SUNAT (F001, T001, FC01...). El correlativo es solo una
// sugerencia editable: el número real lo asigna SUNAT al emitir; aquí se
// transcribe. Avanza cuando se usa la serie al crear el documento.
model SerieDocumento {
  id                String             @id @default(cuid())
  empresaId         String             @default("1")
  empresa           Empresa            @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  tipoDocumento     TipoDocumentoSerie
  serie             String // ej. F001, T001, FC01
  correlativoActual Int                @default(0)
  activo            Boolean            @default(true)
  creadoEn          DateTime           @default(now())

  @@unique([empresaId, tipoDocumento, serie])
  @@map("series_documento")
}

// --- Almacenes y zonas (Warehouse / Warehouse Zone) -------------------------

// Rol organizativo del almacén (equivalente reducido a Plant/Storage Location
// de SAP). Hasta ahora la distinción "planta" vs "almacén de distribución"
// era solo convención: un almacén hacía de planta si tenía
// CalendarioProduccion asociado. Este campo la vuelve explícita.
enum TipoAlmacen {
  PLANTA
  ALMACEN_DISTRIBUCION
  ALMACEN_TRANSITO
}

model Almacen {
  id           String      @id @default(cuid())
  empresaId    String      @default("1")
  tipo         TipoAlmacen @default(ALMACEN_DISTRIBUCION)
  empresa      Empresa     @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  codigo       String
  nombre       String
  direccion    String?
  direccion2   String?
  ciudad       String?
  // Texto libre heredado, igual que en Cliente. Manda ubigeoId.
  distrito     String?
  provincia    String?
  departamento String?
  ubigeoId     String?
  codigoPostal String?
  pais         String      @default("Perú")
  encargado    String?
  activo       Boolean     @default(true)
  creadoEn     DateTime    @default(now())

  ubigeo                  Ubigeo?                 @relation(fields: [ubigeoId], references: [id])
  zonas                   ZonaAlmacen[]
  calendarioProduccion    CalendarioProduccion?
  saldos                  SaldoAlmacen[]
  movimientosKardex       MovimientoKardex[]
  activosFijos            ActivoFijo[]
  equipos                 Equipo[]
  ordenesCompra           OrdenCompra[]
  nivelesAprobacionCompra NivelAprobacionCompra[]
  centrosCosto            CentroCosto[]
  centrosTrabajo          CentroTrabajo[]
  ubicacionesTecnicas     UbicacionTecnica[]
  empleados               Empleado[]
  pedidos                 Pedido[]
  devolucionesCliente     DevolucionCliente[]

  @@unique([empresaId, codigo])
  @@map("almacenes")
}

// Calendario de producción por almacén/planta: horas laborables por día de
// semana + excepciones (feriados, mantenimiento). Reemplaza el número único
// que usaba Proyecciones para el chequeo de capacidad.
model CalendarioProduccion {
  id        String @id @default(cuid())
  almacenId String @unique

  horasLunes     Decimal @default(8)
  horasMartes    Decimal @default(8)
  horasMiercoles Decimal @default(8)
  horasJueves    Decimal @default(8)
  horasViernes   Decimal @default(8)
  horasSabado    Decimal @default(0)
  horasDomingo   Decimal @default(0)

  almacen          Almacen          @relation(fields: [almacenId], references: [id], onDelete: Cascade)
  diasNoLaborables DiaNoLaborable[]

  @@map("calendarios_produccion")
}

model DiaNoLaborable {
  id           String   @id @default(cuid())
  calendarioId String
  fecha        DateTime
  motivo       String? // "Feriado nacional", "Mantenimiento", etc.

  calendario CalendarioProduccion @relation(fields: [calendarioId], references: [id], onDelete: Cascade)

  @@unique([calendarioId, fecha])
  @@map("dias_no_laborables")
}

model ZonaAlmacen {
  id        String  @id @default(cuid())
  almacenId String
  codigo    String // ej. A-01, RACK-2
  nombre    String?
  // Slotting multi-nivel: pasillo → rack → nivel → posición. null = raíz.
  // El padre tiene que ser del MISMO almacén; la acción lo verifica y una
  // prueba lo exige. El código sigue siendo único por almacén sin importar el
  // nivel, para que una etiqueta identifique una sola ubicación.
  //
  // onDelete: Restrict — desarmar un pasillo que todavía tiene racks debajo
  // debe ser un acto deliberado, no un efecto colateral.
  parentId  String?
  activo    Boolean @default(true)

  almacen        Almacen        @relation(fields: [almacenId], references: [id])
  parent         ZonaAlmacen?   @relation("JerarquiaZonaAlmacen", fields: [parentId], references: [id], onDelete: Restrict)
  subzonas       ZonaAlmacen[]  @relation("JerarquiaZonaAlmacen")
  presentaciones Presentacion[]
  insumos        Insumo[]
  saldos         SaldoZona[]

  @@unique([almacenId, codigo])
  @@index([almacenId, parentId])
  @@map("zonas_almacen")
}

// --- Unidades de medida (UOM Class / UOM Maintenance) -----------------------

model ClaseUnidadMedida {
  id        String   @id @default(cuid())
  empresaId String   @default("1")
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  codigo    String // ej. PESO, VOLUMEN, CANTIDAD
  nombre    String
  activo    Boolean  @default(true)
  creadoEn  DateTime @default(now())

  unidades UnidadMedida[]

  @@unique([empresaId, codigo])
  @@map("clases_unidad_medida")
}

model UnidadMedida {
  id      String  @id @default(cuid())
  claseId String
  codigo  String // ej. kg, litro, galon, unidad
  nombre  String // ej. Kilogramo
  activo  Boolean @default(true)

  clase ClaseUnidadMedida @relation(fields: [claseId], references: [id])

  @@unique([claseId, codigo])
  @@map("unidades_medida")
}

// --- Grupos de seguridad (Security Group Maintenance) -----------------------
//
// Aplicado de verdad: puedeRealizar() (src/lib/permisos.ts) consulta estos
// permisos y su resultado SÍ bloquea crear/editar/aprobar en las acciones de
// cada módulo — no es solo referencia. Los 4 roles existentes (RolUsuario) se
// muestran como grupos predefinidos no editables porque el acceso base a cada
// pantalla sigue viniendo de requerirRol(); un grupo personalizado asignado a
// un usuario solo puede RESTRINGIR una acción dentro de lo que su rol ya
// permite, nunca ampliarla.

model GrupoSeguridad {
  id            String   @id @default(cuid())
  empresaId     String   @default("1")
  empresa       Empresa  @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  codigo        String
  nombre        String
  esPredefinido Boolean  @default(false)
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now())

  permisos PermisoGrupo[]
  usuarios Usuario[]

  @@unique([empresaId, codigo])
  @@map("grupos_seguridad")
}

model PermisoGrupo {
  id           String  @id @default(cuid())
  grupoId      String
  modulo       String // ventas | materiales | produccion | finanzas | rrhh | configuracion
  puedeVer     Boolean @default(true)
  puedeCrear   Boolean @default(false)
  puedeEditar  Boolean @default(false)
  // Segregación de funciones: separado de editar porque aprobar/rechazar
  // (órdenes de compra, pagos, vacaciones) es una autoridad distinta a la de
  // quien crea o edita el registro.
  puedeAprobar Boolean @default(true)

  grupo GrupoSeguridad @relation(fields: [grupoId], references: [id])

  @@unique([grupoId, modulo])
  @@map("permisos_grupo")
}

// --- Calendario fiscal (Fiscal Calendar) ------------------------------------

enum EstadoPeriodoFiscal {
  ABIERTO
  CERRADO
}

// Tarea propia del cierre de un período. El sistema no trae una lista de
// tareas predefinida: qué incluye un cierre contable es criterio del contador,
// y este código no lo inventa. Lo que sí aporta es el mecanismo — orden,
// dependencia y constancia de quién la dio por hecha.
//
// La "dependencia" es el orden: una tarea no se puede completar si queda
// alguna anterior pendiente. Es lo que hace falta para un cierre —que es una
// secuencia— sin la complejidad de un grafo arbitrario que nadie pidió.
model TareaCierrePeriodo {
  id                  String    @id @default(cuid())
  periodoFiscalId     String
  orden               Int
  descripcion         String
  completadaEn        DateTime?
  completadaPorId     String?
  completadaPorNombre String?
  nota                String?
  creadoEn            DateTime  @default(now())

  periodo PeriodoFiscal @relation(fields: [periodoFiscalId], references: [id], onDelete: Cascade)

  @@unique([periodoFiscalId, orden])
  @@map("tareas_cierre_periodo")
}

model PeriodoFiscal {
  id                 String              @id @default(cuid())
  empresaId          String              @default("1")
  empresa            Empresa             @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  anio               Int
  mes                Int // 1-12
  estado             EstadoPeriodoFiscal @default(ABIERTO)
  cerradoEn          DateTime?
  cerradoPor         String?
  // Cuántos puntos quedaban sin resolver en el momento de cerrar. Cerrar sigue
  // siendo decisión del contador —bloquearlo podría dejar los libros sin poder
  // cerrarse por un dato menor— pero la decisión queda registrada.
  pendientesAlCerrar Int?

  tareasCierre TareaCierrePeriodo[]

  @@unique([empresaId, anio, mes])
  @@map("periodos_fiscales")
}

// ---------------------------------------------------------------------------
// CONTABILIDAD — FASE 3 (equivalente reducido al General Ledger de Epicor:
// Chart of Accounts, Books, Journal Entry, GL Controls).
//
// Principio: los asientos son inmutables — nunca se editan ni borran; una
// corrección se hace con un asiento de reverso (mismo patrón del kardex).
// ---------------------------------------------------------------------------

enum TipoCuenta {
  ACTIVO
  PASIVO
  PATRIMONIO
  INGRESO
  GASTO
}

model PlanCuentas {
  id        String   @id @default(cuid())
  empresaId String   @default("1")
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  codigo    String // ej. PCGE (Plan Contable General Empresarial)
  nombre    String
  esMaestro Boolean  @default(false)
  creadoEn  DateTime @default(now())

  cuentas CuentaContable[]

  @@unique([empresaId, codigo])
  @@map("planes_cuentas")
}

model CuentaContable {
  id            String     @id @default(cuid())
  planCuentasId String
  codigo        String // ej. 1041, 1212, 7011 (estilo PCGE)
  nombre        String
  tipo          TipoCuenta
  activo        Boolean    @default(true)
  creadoEn      DateTime   @default(now())

  planCuentas PlanCuentas       @relation(fields: [planCuentasId], references: [id])
  detalles    AsientoDetalle[]
  controles   ControlContable[]

  @@unique([planCuentasId, codigo])
  @@map("cuentas_contables")
}

model Libro {
  id        String   @id @default(cuid())
  empresaId String   @default("1")
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  codigo    String // ej. DIARIO
  nombre    String
  moneda    String   @default("PEN")
  creadoEn  DateTime @default(now())

  asientos AsientoContable[]

  @@unique([empresaId, codigo])
  @@map("libros")
}

enum OrigenAsiento {
  MANUAL
  VENTA
  SALIDA_MERCANCIA
  DEVOLUCION_CLIENTE
  COBRO
  NOTA_CREDITO
  // Solo las notas emitidas a mano (aumento de valor, penalidad) postean con
  // este origen. La de mora no: su asiento ya lo hizo el recargo, con origen
  // RECARGO_MORA, cuando se aplicó.
  NOTA_DEBITO
  APLICACION_CREDITO_CLIENTE
  REEMBOLSO_CLIENTE
  ANULACION_VENTA
  RECARGO_MORA
  COMPRA
  PAGO_PROVEEDOR
  DEPRECIACION
  MANTENIMIENTO
  VENTA_ACTIVO_FIJO
  REVERSO
  DEVOLUCION_COMPRA
  APLICACION_CREDITO_PROVEEDOR
  REEMBOLSO_PROVEEDOR
  PLANILLA
  GRATIFICACION
  CTS
  LIQUIDACION
  ORDEN_INTERNA
  RECLASIFICACION_COSTO
  INICIO_PRODUCCION
  MANO_OBRA_PRODUCCION
  ENVASADO_PRODUCCION
  DESECHO_PRODUCCION
}

model AsientoContable {
  id            String        @id @default(cuid())
  empresaId     String        @default("1")
  empresa       Empresa       @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  libroId       String
  numero        String // AS-00001
  fecha         DateTime      @default(now())
  anio          Int // período fiscal al que pertenece
  mes           Int
  origen        OrigenAsiento @default(MANUAL)
  glosa         String // descripción del asiento
  referencia    String? // nro de factura, OC, etc.
  reversadoPor  String? // numero del asiento de reverso, si existe
  reversaA      String? // numero del asiento que este asiento reversa
  usuarioId     String
  usuarioNombre String
  creadoEn      DateTime      @default(now())

  libro    Libro            @relation(fields: [libroId], references: [id])
  detalles AsientoDetalle[]

  @@unique([empresaId, numero])
  @@index([anio, mes])
  @@map("asientos_contables")
}

model AsientoDetalle {
  id            String  @id @default(cuid())
  asientoId     String
  cuentaId      String
  centroCostoId String? // dimensión de centro de costo (opcional; ver CentroCostoControl)
  glosa         String?
  debe          Decimal @default(0)
  haber         Decimal @default(0)

  asiento     AsientoContable @relation(fields: [asientoId], references: [id])
  cuenta      CuentaContable  @relation(fields: [cuentaId], references: [id])
  centroCosto CentroCosto?    @relation(fields: [centroCostoId], references: [id])

  @@index([cuentaId])
  @@index([centroCostoId])
  @@map("asiento_detalles")
}

// Mapa transacción → cuenta contable (GL Controls de Epicor). Cada clave la
// usa la contabilización automática; si falta, la transacción operativa se
// registra igual pero sin asiento (se avisa en la pantalla de controles).
model ControlContable {
  id        String  @id @default(cuid())
  empresaId String  @default("1")
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  clave     String // CUENTAS_POR_COBRAR, VENTAS, IGV_POR_PAGAR, COSTO_VENTAS,
  //                  INVENTARIO_PT, INVENTARIO_INSUMOS, CAJA_BANCOS,
  //                  CUENTAS_POR_PAGAR, DEVOLUCIONES
  cuentaId  String

  cuenta CuentaContable @relation(fields: [cuentaId], references: [id])

  @@unique([empresaId, clave])
  @@map("controles_contables")
}

// ---------------------------------------------------------------------------
// FINANZAS — CENTROS DE COSTO (contabilidad de gestión, estilo SAP CO)
//
// Independiente del plan de cuentas: el plan de cuentas dice QUÉ es el gasto
// (naturaleza — depreciación, mantenimiento, sueldos); el centro de costo
// dice DÓNDE se originó (planta, ventas, administración). Un mismo gasto
// puede repartirse entre varios centros mediante una regla de prorrateo.
// ---------------------------------------------------------------------------

enum TipoCentroCosto {
  PRODUCCION
  VENTAS
  ADMINISTRACION
  LOGISTICA
  OTRO
}

model CentroCosto {
  id        String          @id @default(cuid())
  empresaId String          @default("1")
  empresa   Empresa         @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  codigo    String // CC-PLANTA, CC-VENTAS
  nombre    String
  tipo      TipoCentroCosto
  almacenId String? // opcional: si el centro corresponde a una planta/almacén físico
  parentId  String?
  activo    Boolean         @default(true)
  creadoEn  DateTime        @default(now())

  almacen              Almacen?                      @relation(fields: [almacenId], references: [id])
  parent               CentroCosto?                  @relation("CentroCostoJerarquia", fields: [parentId], references: [id])
  hijos                CentroCosto[]                 @relation("CentroCostoJerarquia")
  presupuestos         PresupuestoCentroCosto[]
  asientos             AsientoDetalle[]
  controles            CentroCostoControl[]
  reglaLineas          ReglaAsignacionCostoDetalle[]
  equipos              Equipo[]
  activosFijos         ActivoFijo[]
  ordenesMantenimiento OrdenMantenimiento[]
  empleados            Empleado[]
  planesMantenimiento  PlanMantenimiento[]
  ordenesInternas      OrdenInterna[]
  posiciones           PosicionOrganizativa[]
  proyectos            Proyecto[]
  centrosTrabajo       CentroTrabajo[]

  @@unique([empresaId, codigo])
  @@index([parentId])
  @@map("centros_costo")
}

// Presupuesto mensual por centro, para el reporte de variación (presupuesto
// vs. real). Cargado a mano por Gerencia/Finanzas al planificar el período.
model PresupuestoCentroCosto {
  id                 String   @id @default(cuid())
  centroCostoId      String
  anio               Int
  mes                Int
  montoPresupuestado Decimal
  usuarioId          String
  usuarioNombre      String
  creadoEn           DateTime @default(now())

  centroCosto CentroCosto @relation(fields: [centroCostoId], references: [id])

  @@unique([centroCostoId, anio, mes])
  @@map("presupuestos_centro_costo")
}

enum EstadoOrdenInterna {
  ABIERTA
  LIQUIDADA
  ANULADA
}

// Objeto de costeo genérico y temporal (equivalente reducido a la Orden
// Interna de SAP CO-OM-OPA): junta costos de fuentes heterogéneas para un
// propósito puntual (una campaña, un evento, un proyecto corto) que no
// justifica un centro de costo permanente. Al liquidar, el total acumulado
// se contabiliza de una vez contra el centro de costo de destino.
model OrdenInterna {
  id               String             @id @default(cuid())
  empresaId        String             @default("1")
  empresa          Empresa            @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  codigo           String // OI-00001
  descripcion      String
  // Destino sugerido al crear; se confirma (o cambia) recién al liquidar.
  centroCostoId    String?
  presupuesto      Decimal? // tope informativo, no bloqueante
  totalAcumulado   Decimal            @default(0)
  estado           EstadoOrdenInterna @default(ABIERTA)
  fechaInicio      DateTime           @default(now())
  fechaLiquidacion DateTime?
  usuarioId        String
  usuarioNombre    String
  creadoEn         DateTime           @default(now())

  centroCosto CentroCosto?        @relation(fields: [centroCostoId], references: [id])
  costos      OrdenInternaCosto[]

  @@unique([empresaId, codigo])
  @@map("ordenes_internas")
}

model OrdenInternaCosto {
  id             String   @id @default(cuid())
  ordenInternaId String
  concepto       String
  monto          Decimal
  fecha          DateTime @default(now())
  usuarioId      String
  usuarioNombre  String

  ordenInterna OrdenInterna @relation(fields: [ordenInternaId], references: [id])

  @@map("orden_interna_costos")
}

// Prorrateo automático: cuando una clave de control (ej. GASTO_DEPRECIACION)
// no corresponde a un solo centro sino que se reparte entre varios (ej. la
// depreciación de una mezcladora que sirve a Planta y a Logística), esta
// regla define el % que le toca a cada uno. Los porcentajes de sus líneas
// deben sumar 100 (se valida al guardar, no en la base).
model ReglaAsignacionCosto {
  id       String   @id @default(cuid())
  nombre   String // "Depreciación prorrateada Planta/Logística"
  activo   Boolean  @default(true)
  creadoEn DateTime @default(now())

  lineas    ReglaAsignacionCostoDetalle[]
  controles CentroCostoControl[]

  @@map("reglas_asignacion_costo")
}

model ReglaAsignacionCostoDetalle {
  id            String  @id @default(cuid())
  reglaId       String
  centroCostoId String
  porcentaje    Decimal // 0-100

  regla       ReglaAsignacionCosto @relation(fields: [reglaId], references: [id], onDelete: Cascade)
  centroCosto CentroCosto          @relation(fields: [centroCostoId], references: [id])

  @@unique([reglaId, centroCostoId])
  @@map("reglas_asignacion_costo_detalles")
}

// Qué centro (o regla de prorrateo) le corresponde a cada clave de control
// contable. Exactamente uno de los dos debe estar definido, nunca ambos —
// se valida en el server action, no en la base. Si una clave no tiene
// entrada acá, el asiento se postea igual pero sin centro de costo
// (best-effort, como el resto del motor contable).
model CentroCostoControl {
  id            String  @id @default(cuid())
  empresaId     String  @default("1")
  empresa       Empresa @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  clave         String // mismo universo que ControlContable.clave
  centroCostoId String?
  reglaId       String?

  centroCosto CentroCosto?          @relation(fields: [centroCostoId], references: [id])
  regla       ReglaAsignacionCosto? @relation(fields: [reglaId], references: [id])

  @@unique([empresaId, clave])
  @@map("centro_costo_controles")
}

// ---------------------------------------------------------------------------
// FINANZAS — ACTIVOS FIJOS Y DEPRECIACIÓN (línea recta, la más simple y la
// que exige la SUNAT como método por defecto salvo pedido expreso de otro).
// ---------------------------------------------------------------------------

enum CategoriaActivoFijo {
  MAQUINARIA
  VEHICULO
  EQUIPO_OFICINA
  INMUEBLE
  OTRO
}

model ActivoFijo {
  id                    String              @id @default(cuid())
  empresaId             String              @default("1")
  empresa               Empresa             @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  codigo                String // AF-00001
  nombre                String
  categoria             CategoriaActivoFijo
  almacenId             String?
  fechaAdquisicion      DateTime
  costoAdquisicion      Decimal
  valorResidual         Decimal             @default(0)
  vidaUtilAnios         Int
  // Se actualiza con cada DepreciacionActivo (nunca se edita a mano — mismo
  // principio que el kardex: la historia se compensa, no se sobrescribe).
  depreciacionAcumulada Decimal             @default(0)
  activo                Boolean             @default(true) // false = dado de baja
  fechaBaja             DateTime?
  motivoBaja            String?
  precioVenta           Decimal? // si se vendió el activo (no un castigo puro): precio de venta pactado
  notas                 String?
  centroCostoId         String?
  usuarioId             String
  usuarioNombre         String
  creadoEn              DateTime            @default(now())

  // Si el activo se generó capitalizando un Proyecto (obra de capital), queda
  // enlazado acá — solo trazabilidad, no participa en el cálculo de depreciación.
  proyectoId String?

  almacen        Almacen?             @relation(fields: [almacenId], references: [id])
  depreciaciones DepreciacionActivo[]
  equipo         Equipo?
  centroCosto    CentroCosto?         @relation(fields: [centroCostoId], references: [id])
  proyecto       Proyecto?            @relation(fields: [proyectoId], references: [id])

  @@unique([empresaId, codigo])
  @@map("activos_fijos")
}

// Ledger inmutable de cargos de depreciación mensual — nunca se edita ni se
// borra; @@unique evita cargar el mismo mes dos veces para el mismo activo.
model DepreciacionActivo {
  id           String   @id @default(cuid())
  activoFijoId String
  anio         Int
  mes          Int
  monto        Decimal
  creadoEn     DateTime @default(now())

  activoFijo ActivoFijo @relation(fields: [activoFijoId], references: [id])

  @@unique([activoFijoId, anio, mes])
  @@map("depreciaciones_activo")
}

// ---------------------------------------------------------------------------
// PROYECTOS DE INVERSIÓN / OBRAS DE CAPITAL (PS reducido, ver
// docs/gobernanza/05-disparadores-fase3-diferida.md). Gestión de WBS +
// red de actividades con ruta crítica para obras de capital propio
// (ampliación de planta, nueva línea) — no para proyectos de cliente.
// Solo precedencia Fin-a-Inicio, sin nivelación de capacidad, sin
// calendario de días hábiles: alcance deliberado para 1-3 proyectos a la vez.
// ---------------------------------------------------------------------------

enum EstadoProyecto {
  PLANIFICADO
  EN_PROGRESO
  CERRADO
  CANCELADO
}

model Proyecto {
  id               String         @id @default(cuid())
  empresaId        String         @default("1")
  empresa          Empresa        @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  codigo           String // PRY-00001
  nombre           String
  descripcion      String?
  // Solo una etiqueta informativa de qué área/sponsor lo pidió — el costo
  // real NO se postea contra este centro (es WIP que capitaliza en un
  // ActivoFijo, no un gasto de período). Ver CostoProyecto.
  centroCostoId    String?
  presupuestoTotal Decimal
  estado           EstadoProyecto @default(PLANIFICADO)
  fechaInicioPlan  DateTime
  fechaFinPlan     DateTime
  fechaInicioReal  DateTime?
  fechaFinReal     DateTime?
  responsableId    String?
  usuarioId        String
  usuarioNombre    String
  creadoEn         DateTime       @default(now())

  centroCosto   CentroCosto?    @relation(fields: [centroCostoId], references: [id])
  responsable   Empleado?       @relation(fields: [responsableId], references: [id])
  edts          EdtProyecto[]
  costos        CostoProyecto[]
  ordenesCompra OrdenCompra[]
  activosFijos  ActivoFijo[]

  @@unique([empresaId, codigo])
  @@map("proyectos")
}

// Nodo de la WBS (fase/subfase). Auto-relación para el árbol multinivel;
// el código jerárquico ("1", "1.1") se calcula en el server action contando
// hermanos, no es un correlativo global.
model EdtProyecto {
  id          String   @id @default(cuid())
  proyectoId  String
  parentId    String?
  codigo      String
  nombre      String
  presupuesto Decimal? // tope informativo, no bloqueante — igual que OrdenInterna.presupuesto
  orden       Int      @default(0)

  proyecto      Proyecto            @relation(fields: [proyectoId], references: [id])
  parent        EdtProyecto?        @relation("EdtJerarquia", fields: [parentId], references: [id])
  hijos         EdtProyecto[]       @relation("EdtJerarquia")
  actividades   ActividadProyecto[]
  costos        CostoProyecto[]
  ordenesCompra OrdenCompra[]

  @@map("edt_proyecto")
}

// Nodo de la red de actividades. Los 4 campos de ruta crítica
// (fechaInicioPlan/fechaFinPlan/esCritica/holguraDias) son calculados por
// recalcularRutaCritica() en src/lib/proyectos.ts — nunca se editan a mano.
model ActividadProyecto {
  id              String         @id @default(cuid())
  edtId           String
  codigo          String
  nombre          String
  duracionDias    Int
  estado          EstadoProyecto @default(PLANIFICADO)
  responsableId   String?
  equipoId        String?
  fechaInicioPlan DateTime?
  fechaFinPlan    DateTime?
  esCritica       Boolean        @default(false)
  holguraDias     Int            @default(0)

  edt          EdtProyecto            @relation(fields: [edtId], references: [id])
  responsable  Empleado?              @relation(fields: [responsableId], references: [id])
  equipo       Equipo?                @relation(fields: [equipoId], references: [id])
  predecesoras PrecedenciaActividad[] @relation("Sucesora")
  sucesoras    PrecedenciaActividad[] @relation("Predecesora")

  @@map("actividades_proyecto")
}

// Arista del grafo (Fin-a-Inicio únicamente). Se valida que no forme ciclo
// en el server action antes de insertar (DFS), no en la base.
model PrecedenciaActividad {
  id                     String @id @default(cuid())
  actividadPredecesoraId String
  actividadSucesoraId    String

  predecesora ActividadProyecto @relation("Predecesora", fields: [actividadPredecesoraId], references: [id])
  sucesora    ActividadProyecto @relation("Sucesora", fields: [actividadSucesoraId], references: [id])

  @@unique([actividadPredecesoraId, actividadSucesoraId])
  @@map("precedencias_actividad")
}

// Ledger de costos reales — mismo patrón que OrdenInternaCosto. El costo
// real del proyecto/fase se calcula sumando estas filas más las OrdenCompra
// etiquetadas (estado != ANULADA); no hay doble registro.
model CostoProyecto {
  id            String   @id @default(cuid())
  proyectoId    String
  edtId         String?
  concepto      String
  monto         Decimal
  fecha         DateTime @default(now())
  usuarioId     String
  usuarioNombre String

  proyecto Proyecto     @relation(fields: [proyectoId], references: [id])
  edt      EdtProyecto? @relation(fields: [edtId], references: [id])

  @@map("costos_proyecto")
}

// --- Mantenimiento de planta -------------------------------------------------

enum TipoCentroTrabajo {
  MEZCLA
  ENVASADO
  CALIDAD
  MANTENIMIENTO
  OTRO
}

model CentroTrabajo {
  id                String            @id @default(cuid())
  empresaId         String            @default("1")
  empresa           Empresa           @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  codigo            String
  nombre            String
  tipo              TipoCentroTrabajo
  almacenId         String
  centroCostoId     String?
  capacidadHorasDia Decimal
  eficienciaPct     Decimal           @default(100)
  activo            Boolean           @default(true)
  creadoEn          DateTime          @default(now())

  almacen            Almacen            @relation(fields: [almacenId], references: [id])
  centroCosto        CentroCosto?       @relation(fields: [centroCostoId], references: [id])
  equipos            Equipo[]
  operacionesFormula FormulaOperacion[]
  operacionesLote    LoteOperacion[]

  @@unique([empresaId, codigo])
  @@map("centros_trabajo")
}

// El equipo es el activo físico que se mantiene; activoFijoId es opcional y lo
// enlaza con su registro contable/depreciación cuando corresponde (no todo
// equipo mantenible está capitalizado, ej. equipos menores ya depreciados).
// Ubicación técnica (equivalente reducido a Functional Location de SAP PM):
// el sitio donde vive un equipo, en jerarquía de niveles arbitrarios
// (planta → línea → estación). El equipo puede cambiarse de sitio sin
// perder el historial del sitio: las órdenes y avisos siguen colgando del
// equipo, y la ubicación dice dónde estaba instalado.
model UbicacionTecnica {
  id        String   @id @default(cuid())
  empresaId String   @default("1")
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  codigo    String
  nombre    String
  parentId  String?
  // Planta a la que pertenece la raíz de la jerarquía. Solo se declara en
  // los nodos raíz; los descendientes la heredan por el árbol.
  almacenId String?
  activo    Boolean  @default(true)
  creadoEn  DateTime @default(now())

  parent  UbicacionTecnica?  @relation("JerarquiaUbicacionTecnica", fields: [parentId], references: [id], onDelete: Restrict)
  hijos   UbicacionTecnica[] @relation("JerarquiaUbicacionTecnica")
  almacen Almacen?           @relation(fields: [almacenId], references: [id])
  equipos Equipo[]

  @@unique([empresaId, codigo])
  @@index([empresaId, parentId])
  @@map("ubicaciones_tecnicas")
}

model Equipo {
  id                 String   @id @default(cuid())
  empresaId          String   @default("1")
  empresa            Empresa  @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  codigo             String // EQ-00001
  nombre             String
  almacenId          String
  activoFijoId       String?  @unique
  centroCostoId      String?
  centroTrabajoId    String?
  ubicacionTecnicaId String?
  activo             Boolean  @default(true)
  notas              String?
  // Contador de uso (horómetro/odómetro) para mantenimiento preventivo por
  // contador (ej. "cada 5,000 km" o "cada 250 horas de motor"). Se actualiza
  // manualmente — no hay telemetría real conectada. unidadContador queda null
  // en equipos que solo usan planes por tiempo.
  contadorActual     Decimal  @default(0)
  unidadContador     String? // "km", "horas", etc.
  creadoEn           DateTime @default(now())

  almacen              Almacen                 @relation(fields: [almacenId], references: [id])
  activoFijo           ActivoFijo?             @relation(fields: [activoFijoId], references: [id])
  centroCosto          CentroCosto?            @relation(fields: [centroCostoId], references: [id])
  centroTrabajo        CentroTrabajo?          @relation(fields: [centroTrabajoId], references: [id])
  ubicacionTecnica     UbicacionTecnica?       @relation(fields: [ubicacionTecnicaId], references: [id])
  ordenesMantenimiento OrdenMantenimiento[]
  guiasRemision        GuiaRemision[]
  planesMantenimiento  PlanMantenimiento[]
  actividadesProyecto  ActividadProyecto[]
  operacionesLote      LoteOperacion[]
  avisosMantenimiento  AvisoMantenimiento[]
  lecturasContador     LecturaContadorEquipo[]

  @@unique([empresaId, codigo])
  @@map("equipos")
}

enum FuenteLecturaContador {
  ALTA_EQUIPO
  MANUAL
  CIERRE_MANTENIMIENTO
}

model LecturaContadorEquipo {
  id            String                @id @default(cuid())
  equipoId      String
  valor         Decimal
  fuente        FuenteLecturaContador
  observacion   String?
  usuarioId     String
  usuarioNombre String
  creadoEn      DateTime              @default(now())

  equipo Equipo @relation(fields: [equipoId], references: [id])

  @@index([equipoId, creadoEn])
  @@map("lecturas_contador_equipo")
}

enum TipoMantenimiento {
  PREVENTIVO
  CORRECTIVO
}

enum EstadoOrdenMantenimiento {
  PROGRAMADA
  EN_PROCESO
  COMPLETADA
  CANCELADA
}

enum CausaFallaMantenimiento {
  MECANICA
  ELECTRICA
  INSTRUMENTACION
  LUBRICACION
  OPERACION
  OTRO
}

// Al programarse (estado PROGRAMADA) bloquea los días de la ventana en el
// CalendarioProduccion del almacén del equipo (DiaNoLaborable), para que
// Proyecciones refleje la parada de capacidad. Al cancelarse, libera esos días.
model OrdenMantenimiento {
  id                   String                   @id @default(cuid())
  // Hasta aquí colgaba solo del equipo. Se le da empresaId propio para que
  // su numeración sea por compañía como la del resto de documentos; la
  // migración lo rellena desde el equipo al que pertenece cada orden.
  empresaId            String                   @default("1")
  empresa              Empresa                  @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  codigo               String // OM-00001
  equipoId             String
  tipo                 TipoMantenimiento
  estado               EstadoOrdenMantenimiento @default(PROGRAMADA)
  descripcion          String
  fechaProgramada      DateTime
  duracionDias         Int                      @default(1)
  fechaInicio          DateTime?
  fechaFin             DateTime?
  costoManoObra        Decimal                  @default(0)
  costoRepuestos       Decimal                  @default(0)
  observaciones        String?
  modoFalla            String?
  causaFalla           CausaFallaMantenimiento?
  tiempoParadaHoras    Decimal?
  tecnicoResponsable   String?
  // Por defecto el del equipo, pero se puede anular al programar la orden
  // (ej. una reparación que en realidad corresponde a otra área).
  centroCostoId        String?
  // Si esta orden nació de un plan preventivo (generación automática), queda
  // enlazada acá — al completarla se actualiza el ciclo del plan.
  planMantenimientoId  String?
  avisoMantenimientoId String?                  @unique
  usuarioId            String
  usuarioNombre        String
  creadoEn             DateTime                 @default(now())

  equipo             Equipo                       @relation(fields: [equipoId], references: [id])
  centroCosto        CentroCosto?                 @relation(fields: [centroCostoId], references: [id])
  planMantenimiento  PlanMantenimiento?           @relation(fields: [planMantenimientoId], references: [id])
  repuestos          RepuestoOrdenMantenimiento[]
  avisoMantenimiento AvisoMantenimiento?          @relation(fields: [avisoMantenimientoId], references: [id])

  @@unique([empresaId, codigo])
  @@map("ordenes_mantenimiento")
}

enum PrioridadAvisoMantenimiento {
  BAJA
  MEDIA
  ALTA
  EMERGENCIA
}

enum EstadoAvisoMantenimiento {
  ABIERTO
  CONVERTIDO
  DESCARTADO
}

model AvisoMantenimiento {
  id             String                      @id @default(cuid())
  empresaId      String                      @default("1")
  empresa        Empresa                     @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  equipoId       String
  prioridad      PrioridadAvisoMantenimiento @default(MEDIA)
  estado         EstadoAvisoMantenimiento    @default(ABIERTO)
  titulo         String
  sintoma        String
  equipoDetenido Boolean                     @default(false)
  fechaDeteccion DateTime                    @default(now())
  usuarioId      String
  usuarioNombre  String
  creadoEn       DateTime                    @default(now())
  descartadoEn   DateTime?
  motivoDescarte String?

  equipo Equipo              @relation(fields: [equipoId], references: [id])
  orden  OrdenMantenimiento?

  @@index([empresaId, estado, prioridad])
  @@map("avisos_mantenimiento")
}

enum TipoPlanMantenimiento {
  POR_TIEMPO
  POR_CONTADOR
}

// Plan de mantenimiento preventivo: genera OrdenMantenimiento automáticamente
// (tarea programada, ver src/lib/tareasProgramadas.ts) cuando se cumple el
// ciclo por calendario o por contador de uso. El ciclo se reinicia recién
// cuando la orden generada se COMPLETA (no cuando se genera), para reflejar
// la fecha/contador real de ejecución, no la de programación.
model PlanMantenimiento {
  id                      String                @id @default(cuid())
  empresaId               String                @default("1")
  empresa                 Empresa               @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  equipoId                String
  nombre                  String // ej. "Cambio de aceite de motor"
  tipo                    TipoPlanMantenimiento
  frecuenciaDias          Int? // solo POR_TIEMPO
  frecuenciaContador      Decimal? // solo POR_CONTADOR (ej. cada 5000 km)
  ultimaEjecucionFecha    DateTime? // null = nunca ejecutado, se usa creadoEn como base
  ultimaEjecucionContador Decimal? // null = nunca ejecutado, se usa 0 como base
  centroCostoId           String? // opcional, si no usa el del equipo
  activo                  Boolean               @default(true)
  usuarioId               String
  usuarioNombre           String
  creadoEn                DateTime              @default(now())

  equipo      Equipo                      @relation(fields: [equipoId], references: [id])
  centroCosto CentroCosto?                @relation(fields: [centroCostoId], references: [id])
  ordenes     OrdenMantenimiento[]
  repuestos   RepuestoPlanMantenimiento[]

  @@map("planes_mantenimiento")
}

// Repuestos consumidos por una orden, con costo unitario "congelado" al
// momento del consumo (igual que EnvasadoInsumo con la fórmula): si el costo
// promedio del insumo cambia después, el histórico de esta orden no se altera.
// Al crearse, descuenta stock real vía registrarMovimiento (origen AJUSTE),
// así el costoRepuestos de la orden queda como la suma de estas líneas.
// Repuestos que un plan preventivo PREVÉ consumir. Es la lista técnica
// planificada: sirve para presupuestar el mantenimiento antes de ejecutarlo.
//
// Deliberadamente separada de RepuestoOrdenMantenimiento, que registra lo que
// se consumió DE VERDAD. Prellenar el consumo real desde el plan haría que el
// sistema diera por gastados repuestos que quizá no se usaron, y ese consumo
// mueve kardex y costo. El plan es referencia; el operario confirma qué usó.
model RepuestoPlanMantenimiento {
  id                  String   @id @default(cuid())
  planMantenimientoId String
  insumoId            String
  cantidad            Decimal
  notas               String?
  creadoEn            DateTime @default(now())

  plan   PlanMantenimiento @relation(fields: [planMantenimientoId], references: [id], onDelete: Cascade)
  insumo Insumo            @relation(fields: [insumoId], references: [id])

  // Un repuesto aparece una sola vez por plan: si hacen falta dos unidades, va
  // en la cantidad, no en dos filas.
  @@unique([planMantenimientoId, insumoId])
  @@map("repuestos_plan_mantenimiento")
}

model RepuestoOrdenMantenimiento {
  id                   String   @id @default(cuid())
  ordenMantenimientoId String
  insumoId             String
  cantidad             Decimal
  costoUnitario        Decimal
  creadoEn             DateTime @default(now())

  orden  OrdenMantenimiento @relation(fields: [ordenMantenimientoId], references: [id])
  insumo Insumo             @relation(fields: [insumoId], references: [id])

  @@map("repuestos_orden_mantenimiento")
}

// ---------------------------------------------------------------------------
// PROYECCIONES — Marketing / Operaciones / Finanzas por trimestre.
// Metodología estilo Business Management Game / S&OP (SAP IBP, Epicor IP&O):
// estacionalidad calculada de la propia historia de ventas + supuestos
// cualitativos que ingresa el usuario (crecimiento esperado, factor de
// competencia) + un factor macro de referencia (BCRP, best-effort).
// ---------------------------------------------------------------------------
model Proyeccion {
  id            String  @id @default(cuid())
  empresaId     String  @default("1")
  empresa       Empresa @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  anio          Int
  trimestre     Int // 1-4
  anioBase      Int // trimestre de referencia (normalmente el anterior)
  trimestreBase Int

  // Supuestos de Marketing (cualitativos, igual que en el modelo BML)
  crecimientoMercadoPct Decimal @default(0) // %
  factorCompetenciaPct  Decimal @default(0) // % (+/-)
  presupuestoPublicidad Decimal @default(0)

  // Supuestos de Finanzas
  cajaMinimaDeseada     Decimal  @default(0)
  metaUtilidadOperativa Decimal? // meta del trimestre, para el simulador de precios

  // Factor macro de referencia (BCRP), tomado al momento de crear/actualizar
  macroPbiManufacturaVar Decimal? // variación % interanual
  macroInflacionVar      Decimal? // variación % interanual
  macroTipoCambio        Decimal? // S/ por US$, promedio del período
  macroActualizadoEn     DateTime?

  usuarioId     String
  usuarioNombre String
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  detalles ProyeccionDetalle[]

  @@unique([empresaId, anio, trimestre])
  @@map("proyecciones")
}

model ProyeccionDetalle {
  id             String @id @default(cuid())
  proyeccionId   String
  presentacionId String

  ventasBase           Decimal @default(0) // unidades vendidas en el trimestre base
  indiceEstacionalidad Decimal @default(1) // trimestre objetivo ÷ trimestre base, de la historia
  ajusteCualitativoPct Decimal @default(0) // % adicional a criterio del usuario
  demandaProyectada    Decimal @default(0) // unidades resultantes

  // Simulador de precios: hipótesis de "a qué precio necesito vender", no el
  // precio real del maestro (Presentacion.precio no se toca desde acá).
  precioSimulado      Decimal? // si es null, el simulador parte del precio actual
  precioCompetidorRef Decimal? // precio de referencia del competidor, ingresado a criterio

  proyeccion   Proyeccion   @relation(fields: [proyeccionId], references: [id], onDelete: Cascade)
  presentacion Presentacion @relation(fields: [presentacionId], references: [id])

  @@unique([proyeccionId, presentacionId])
  @@map("proyeccion_detalles")
}

// ---------------------------------------------------------------------------
// Multi-moneda: solo para operaciones puntuales en USD (compras a proveedores
// que cotizan en dólares). El PEN sigue siendo la moneda funcional — todo lo
// que impacta el libro diario, el costeo de inventario y los reportes se
// convierte a PEN con el tipo de cambio vigente al momento de la operación
// (nunca se revalúa después: mismo principio de "congelar" que el costo
// promedio o el kardex).
// ---------------------------------------------------------------------------

// Caché best-effort del tipo de cambio (BCRP) por día — ver src/lib/tipoCambio.ts.
model TipoCambio {
  id       String   @id @default(cuid())
  fecha    DateTime @unique // solo la fecha (medianoche), un valor por día
  valor    Decimal // soles por 1 dólar (S/ / US$)
  fuente   String   @default("BCRP")
  creadoEn DateTime @default(now())

  @@map("tipos_cambio")
}

// ---------------------------------------------------------------------------
// RRHH básico: ficha de personal + vacaciones. Deliberadamente NO incluye
// cálculo de planilla/nómina (AFP/ONP/EsSalud/gratificaciones/CTS) — eso
// requiere expertise legal-tributaria específica y queda fuera de alcance,
// igual que SuccessFactors/Ariba en el resto del sistema.
// ---------------------------------------------------------------------------

enum TipoContrato {
  PLAZO_FIJO
  PLAZO_INDETERMINADO
  LOCACION_SERVICIOS
}

enum EstadoEmpleado {
  ACTIVO
  CESADO
}

// Regímenes del Impuesto a la Renta empresarial vigentes en Perú. Se listan
// como catálogo para que el dato quede estructurado y no como texto libre; el
// sistema NO deriva de ellos ninguna obligación, tasa ni cálculo.
enum RegimenTributario {
  NRUS // Nuevo Régimen Único Simplificado
  RER // Régimen Especial de Renta
  RMT // Régimen MYPE Tributario
  GENERAL // Régimen General
}

enum TipoDocumentoIdentidad {
  DNI
  PASAPORTE
  CARNET_EXTRANJERIA
  OTRO
}

enum SistemaPension {
  ONP
  AFP
}

enum Afp {
  INTEGRA
  PRIMA
  HABITAT
  PROFUTURO
}

// Posición organizativa (equivalente reducido a Stelle/Position de SAP HCM).
// Existe con independencia de quién la ocupe: por eso se puede responder
// "quién ocupaba esta posición en marzo" y "qué posiciones están vacantes",
// cosa que Empleado.cargo (texto libre) nunca permitió.
//
// La jerarquía es de POSICIONES, no de personas: reportaAId sobrevive a la
// rotación. Empleado.jefeDirectoId se conserva y sigue siendo la relación
// operativa vigente; la posición es la estructura.
model PosicionOrganizativa {
  id            String   @id @default(cuid())
  empresaId     String   @default("1")
  empresa       Empresa  @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  codigo        String
  titulo        String
  area          String
  centroCostoId String?
  reportaAId    String?
  activa        Boolean  @default(true)
  usuarioId     String
  usuarioNombre String
  creadoEn      DateTime @default(now())

  centroCosto  CentroCosto?           @relation(fields: [centroCostoId], references: [id])
  reportaA     PosicionOrganizativa?  @relation("JerarquiaPosicion", fields: [reportaAId], references: [id], onDelete: Restrict)
  subordinadas PosicionOrganizativa[] @relation("JerarquiaPosicion")
  asignaciones AsignacionPosicion[]

  @@unique([empresaId, codigo])
  @@index([empresaId, activa])
  @@map("posiciones_organizativas")
}

// Ocupación de una posición por un empleado durante un período. Es la parte
// versionada: cerrar una asignación (vigenteHasta) y abrir otra conserva el
// histórico en vez de sobrescribirlo, igual que el resto del esquema.
model AsignacionPosicion {
  id            String    @id @default(cuid())
  empresaId     String    @default("1")
  empresa       Empresa   @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  posicionId    String
  empleadoId    String
  vigenteDesde  DateTime
  vigenteHasta  DateTime? // null = ocupación vigente
  motivo        String?
  usuarioId     String
  usuarioNombre String
  creadoEn      DateTime  @default(now())

  posicion PosicionOrganizativa @relation(fields: [posicionId], references: [id], onDelete: Restrict)
  empleado Empleado             @relation(fields: [empleadoId], references: [id], onDelete: Restrict)

  @@index([empresaId, posicionId, vigenteDesde])
  @@index([empresaId, empleadoId, vigenteDesde])
  @@map("asignaciones_posicion")
}

model Empleado {
  id                     String                 @id @default(cuid())
  empresaId              String                 @default("1")
  empresa                Empresa                @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  codigo                 String // EMP-00001
  nombres                String
  apellidos              String
  tipoDocumentoIdentidad TipoDocumentoIdentidad @default(DNI)
  dni                    String?
  nacionalidad           String                 @default("Peruana")
  fechaNacimiento        DateTime?
  fechaIngreso           DateTime
  fechaCese              DateTime?
  motivoCese             String?
  cargo                  String
  area                   String
  tipoContrato           TipoContrato
  sueldoBasico           Decimal                @default(0)
  telefono               String?
  correo                 String?
  // Datos bancarios estructurados — para el pago de haberes cuando exista
  // planilla real, o para transferencias a personal remoto/extranjero.
  banco                  String?
  numeroCuenta           String?
  cci                    String?
  swift                  String?
  iban                   String?
  almacenId              String? // planta/local donde trabaja (opcional)
  centroCostoId          String? // para que su costo pese en el centro correcto
  usuarioId              String?                @unique // cuenta de acceso al ERP, si tiene (opcional, 1 a 1)
  estado                 EstadoEmpleado         @default(ACTIVO)
  // Datos para el cálculo de planilla (item HCM). Sin sistemaPension definido,
  // el empleado queda excluido de la corrida de planilla con una advertencia
  // visible — nunca se asume ONP/AFP por defecto en un cálculo con dinero real.
  sistemaPension         SistemaPension?
  afp                    Afp? // solo si sistemaPension = AFP
  asignacionFamiliar     Boolean                @default(false) // tiene hijo(s) menor(es) o que estudian hasta 24 años
  notas                  String?
  creadoEn               DateTime               @default(now())

  almacen                Almacen?                   @relation(fields: [almacenId], references: [id])
  centroCosto            CentroCosto?               @relation(fields: [centroCostoId], references: [id])
  usuario                Usuario?                   @relation(fields: [usuarioId], references: [id])
  vacaciones             SolicitudVacaciones[]
  asignacionesPosicion   AsignacionPosicion[]
  planillaDetalles       PlanillaDetalle[]
  liquidacion            LiquidacionDesvinculacion?
  proyectosResponsable   Proyecto[]
  actividadesResponsable ActividadProyecto[]
  turnoTrabajo           TurnoTrabajo?              @relation(fields: [turnoTrabajoId], references: [id])
  asistencias            RegistroAsistencia[]
  cambiosSalariales      CambioSalarial[]
  turnoTrabajoId         String?
  jefeDirectoId          String?

  jefeDirecto   Empleado?  @relation("JerarquiaEmpleado", fields: [jefeDirectoId], references: [id], onDelete: SetNull)
  colaboradores Empleado[] @relation("JerarquiaEmpleado")

  @@unique([empresaId, codigo])
  @@unique([empresaId, dni])
  @@index([jefeDirectoId])
  @@map("empleados")
}

enum EstadoCambioSalarial {
  PENDIENTE
  APROBADO
  RECHAZADO
}

model CambioSalarial {
  id                String               @id @default(cuid())
  empleadoId        String
  sueldoAnterior    Decimal
  sueldoNuevo       Decimal
  vigenteDesde      DateTime
  motivo            String
  estado            EstadoCambioSalarial @default(PENDIENTE)
  usuarioId         String
  usuarioNombre     String
  resueltoEn        DateTime?
  resueltoPorId     String?
  resueltoPorNombre String?
  motivoRechazo     String?
  creadoEn          DateTime             @default(now())

  empleado Empleado @relation(fields: [empleadoId], references: [id])

  @@index([empleadoId, vigenteDesde])
  @@map("cambios_salariales")
}

model TurnoTrabajo {
  id               String   @id @default(cuid())
  empresaId        String   @default("1")
  empresa          Empresa  @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  codigo           String
  nombre           String
  inicioMinuto     Int
  finMinuto        Int
  refrigerioMinuto Int      @default(60)
  toleranciaMinuto Int      @default(0)
  activo           Boolean  @default(true)
  creadoEn         DateTime @default(now())

  empleados Empleado[]

  @@unique([empresaId, codigo])
  @@map("turnos_trabajo")
}

enum EstadoRegistroAsistencia {
  BORRADOR
  APROBADO
}

model RegistroAsistencia {
  id                  String                   @id @default(cuid())
  empresaId           String                   @default("1")
  empresa             Empresa                  @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  empleadoId          String
  fecha               DateTime
  entrada             DateTime?
  salida              DateTime?
  minutosTrabajados   Int                      @default(0)
  minutosTardanza     Int                      @default(0)
  minutosSobretiempo  Int                      @default(0)
  ausenciaJustificada Boolean                  @default(false)
  observacion         String?
  estado              EstadoRegistroAsistencia @default(BORRADOR)
  usuarioId           String
  usuarioNombre       String
  aprobadoEn          DateTime?
  aprobadoPorId       String?
  aprobadoPorNombre   String?
  creadoEn            DateTime                 @default(now())

  empleado Empleado @relation(fields: [empleadoId], references: [id])

  @@unique([empleadoId, fecha])
  @@index([empresaId, fecha, estado])
  @@map("registros_asistencia")
}

enum EstadoSolicitudVacaciones {
  PENDIENTE
  APROBADA
  RECHAZADA
}

// Ledger inmutable de solicitudes — el saldo disponible se calcula al vuelo
// (30 días/año según ley peruana, proporcional al tiempo trabajado, menos lo
// ya APROBADA) en vez de guardarse, mismo principio que el resto del sistema.
model SolicitudVacaciones {
  id              String                    @id @default(cuid())
  empleadoId      String
  fechaInicio     DateTime
  fechaFin        DateTime
  diasSolicitados Int
  estado          EstadoSolicitudVacaciones @default(PENDIENTE)
  motivoRechazo   String?
  aprobadaPor     String?
  aprobadaEn      DateTime?
  usuarioId       String
  usuarioNombre   String
  creadoEn        DateTime                  @default(now())

  empleado Empleado @relation(fields: [empleadoId], references: [id])

  @@map("solicitudes_vacaciones")
}

// ---------------------------------------------------------------------------
// PLANILLA (HCM — Fase 1: cálculo mensual). Parámetros legales versionados
// por fecha de vigencia (mismo principio que TipoCambio/tasaIgv-al-emitir):
// un cambio de norma no debe alterar el cálculo de un período ya cerrado.
// Gratificación/CTS/liquidación de desvinculación quedan para una iteración
// siguiente sobre esta misma base — ver docs/gobernanza/04-hcm-*.md.
// ---------------------------------------------------------------------------

model ParametroPlanilla {
  id            String   @id @default(cuid())
  empresaId     String   @default("1")
  empresa       Empresa  @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  rmv           Decimal // remuneración mínima vital vigente
  uit           Decimal // unidad impositiva tributaria vigente
  tasaEsSalud   Decimal  @default(9) // % aporte patronal
  tasaOnp       Decimal  @default(13) // % descuento al trabajador afiliado a ONP
  vigenteDesde  DateTime
  usuarioId     String
  usuarioNombre String
  creadoEn      DateTime @default(now())

  @@map("parametros_planilla")
}

enum EstadoPoliticaTiempo {
  BORRADOR
  APROBADA
  RETIRADA
}

model PoliticaTiempoTrabajo {
  id                     String               @id @default(cuid())
  empresaId              String               @default("1")
  empresa                Empresa              @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  vigenteDesde           DateTime
  horasJornadaDiaria     Decimal              @default(8)
  primerasHorasRecargo   Decimal              @default(2)
  recargoPrimerTramo     Decimal              @default(25)
  recargoSegundoTramo    Decimal              @default(35)
  aplicarPagoSobretiempo Boolean              @default(false)
  estado                 EstadoPoliticaTiempo @default(BORRADOR)
  usuarioId              String
  usuarioNombre          String
  aprobadoEn             DateTime?
  aprobadoPorId          String?
  aprobadoPorNombre      String?
  creadoEn               DateTime             @default(now())

  @@unique([empresaId, vigenteDesde])
  @@index([empresaId, estado, vigenteDesde])
  @@map("politicas_tiempo_trabajo")
}

enum TipoComisionAfp {
  FLUJO
  MIXTA
}

model TasaAfp {
  id                    String          @id @default(cuid())
  afp                   Afp
  tipoComision          TipoComisionAfp @default(FLUJO)
  tasaAporteObligatorio Decimal         @default(10) // % al fondo propio del trabajador
  tasaComision          Decimal // % de la AFP
  primaSeguro           Decimal // % prima de seguro
  vigenteDesde          DateTime
  creadoEn              DateTime        @default(now())

  @@unique([afp, tipoComision, vigenteDesde])
  @@map("tasas_afp")
}

enum TipoPeriodoPlanilla {
  MENSUAL
  GRATIFICACION_JULIO
  GRATIFICACION_DICIEMBRE
  CTS_MAYO
  CTS_NOVIEMBRE
}

enum EstadoPeriodoPlanilla {
  ABIERTO
  CERRADO
}

model PlanillaPeriodo {
  id            String                @id @default(cuid())
  empresaId     String                @default("1")
  empresa       Empresa               @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  anio          Int
  mes           Int
  tipo          TipoPeriodoPlanilla   @default(MENSUAL)
  estado        EstadoPeriodoPlanilla @default(ABIERTO)
  usuarioId     String
  usuarioNombre String
  creadoEn      DateTime              @default(now())
  cerradoEn     DateTime?

  detalles PlanillaDetalle[]

  @@unique([empresaId, anio, mes, tipo])
  @@map("planilla_periodos")
}

model PlanillaDetalle {
  id                         String   @id @default(cuid())
  planillaPeriodoId          String
  empleadoId                 String
  sueldoBasico               Decimal
  asignacionFamiliar         Decimal  @default(0)
  remuneracionComputable     Decimal // sueldoBasico + asignacionFamiliar
  // Desglose del descuento de pensión (ONP o AFP: aporte + comisión + prima).
  descuentoPension           Decimal  @default(0)
  detallePension             String? // texto legible del desglose, para la boleta
  essaludPatronal            Decimal  @default(0) // gasto del empleador, no se descuenta al trabajador
  retencion5ta               Decimal  @default(0) // método simplificado — ver docs/gobernanza/04-hcm-*.md
  diasAsistenciaAprobada     Int      @default(0)
  diasAusenciaJustificada    Int      @default(0)
  minutosTardanza            Int      @default(0)
  minutosSobretiempo         Int      @default(0)
  importeSobretiempo         Decimal  @default(0)
  politicaTiempoTrabajoId    String?
  // Solo gratificación/CTS: meses computados en el período y bono Ley 30334
  // (gratificación). Gratificación y CTS están inafectas a ONP/AFP/EsSalud/5ta
  // categoría (hasta 2 UIT en el caso de renta) — no usan descuentoPension ni
  // essaludPatronal.
  mesesComputados            Decimal?
  bonificacionExtraordinaria Decimal  @default(0)
  neto                       Decimal
  asientoNumero              String?
  creadoEn                   DateTime @default(now())

  planillaPeriodo PlanillaPeriodo @relation(fields: [planillaPeriodoId], references: [id])
  empleado        Empleado        @relation(fields: [empleadoId], references: [id])

  @@unique([planillaPeriodoId, empleadoId])
  @@map("planilla_detalles")
}

// Finiquito al cesar un empleado: CTS truncada (desde el último depósito) +
// gratificación truncada (desde el inicio del semestre en curso) + bono Ley
// 30334 + vacaciones truncadas y no gozadas (saldoVacaciones ya es un cálculo
// continuo, cubre ambos). Un registro por cese — se genera junto con
// darDeBajaEmpleado.
model LiquidacionDesvinculacion {
  id                         String   @id @default(cuid())
  empleadoId                 String   @unique
  fechaCese                  DateTime
  ctsTruncada                Decimal
  gratificacionTruncada      Decimal
  bonificacionExtraordinaria Decimal
  diasVacacionesPendientes   Decimal
  montoVacaciones            Decimal
  total                      Decimal
  asientoNumero              String?
  usuarioId                  String
  usuarioNombre              String
  creadoEn                   DateTime @default(now())

  empleado Empleado @relation(fields: [empleadoId], references: [id])

  @@map("liquidaciones_desvinculacion")
}

// ---------------------------------------------------------------------------
// Adjuntos de archivos (DMS reducido): asociación genérica por
// entidadTipo/entidadId en vez de una tabla de unión por cada modelo — así un
// mismo componente (PanelAdjuntos) sirve para Empleado, ActivoFijo, Equipo,
// OrdenCompra, etc. sin migraciones nuevas cada vez que se agrega a un módulo
// más. El archivo físico vive en disco (ver src/lib/adjuntos.ts), no en la BD.
// ---------------------------------------------------------------------------
model Adjunto {
  id             String   @id @default(cuid())
  empresaId      String   @default("1")
  empresa        Empresa  @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  entidadTipo    String // "Empleado", "ActivoFijo", "Equipo", "OrdenCompra", etc.
  entidadId      String
  nombreArchivo  String // nombre físico en disco (con prefijo único)
  nombreOriginal String // nombre tal como lo subió el usuario
  mimeType       String
  tamanioBytes   Int
  usuarioId      String
  usuarioNombre  String
  creadoEn       DateTime @default(now())

  @@index([entidadTipo, entidadId])
  @@map("adjuntos")
}

// ---------------------------------------------------------------------------
// Tareas programadas (equivalente reducido a System Agent): trabajos que
// corren solos dentro del proceso del servidor (ver server.ts +
// src/lib/tareasProgramadas.ts), no disparados por un usuario. Cada tarea
// revisa internamente si ya hizo lo que tenía que hacer antes de actuar
// (depreciación por el período, recargo por la fecha del último aplicado,
// tipo de cambio por el caché diario) — correrla de más no duplica nada; esta
// tabla es solo la bitácora de ejecuciones, no una cola ni un candado.
// ---------------------------------------------------------------------------
enum ClaveTareaProgramada {
  DEPRECIACION_MENSUAL
  RECARGO_MORA
  TIPO_CAMBIO_DIARIO
  MANTENIMIENTO_PREVENTIVO
  RESPALDO_BASE
}

model TareaProgramada {
  id          String               @id @default(cuid())
  clave       ClaveTareaProgramada
  ejecutadoEn DateTime             @default(now())
  exitoso     Boolean
  resumen     String

  @@index([clave, ejecutadoEn])
  @@map("tareas_programadas")
}

// ---------------------------------------------------------------------------
// Datos maestros para operación internacional: Cliente/Proveedor pueden ser
// de cualquier país (no solo Perú), con su propio formato de identificación
// fiscal, más de una dirección (facturación ≠ envío) y más de un contacto —
// Direccion/Contacto son genéricos (entidadTipo/entidadId, mismo patrón que
// Adjunto) para no repetir el modelo por cada entidad que los necesite.
// ---------------------------------------------------------------------------

enum TipoDocumentoFiscal {
  RUC // Perú
  RUT // Chile
  NIT // Colombia
  RFC // México
  EIN // Estados Unidos
  VAT // Unión Europea / genérico
  CI // Cédula de identidad (persona natural, algunos países)
  OTRO
}

enum TipoDireccion {
  FACTURACION
  ENVIO
  OTRA
}

model Direccion {
  id           String        @id @default(cuid())
  entidadTipo  String // "Cliente", "Proveedor", "Empleado"
  entidadId    String
  tipo         TipoDireccion @default(OTRA)
  pais         String
  departamento String?
  provincia    String?
  distrito     String?
  direccion    String
  codigoPostal String?
  esPrincipal  Boolean       @default(false)
  creadoEn     DateTime      @default(now())

  @@index([entidadTipo, entidadId])
  @@map("direcciones")
}

model Contacto {
  id          String   @id @default(cuid())
  entidadTipo String // "Cliente", "Proveedor"
  entidadId   String
  nombre      String
  cargo       String?
  telefono    String?
  email       String?
  esPrincipal Boolean  @default(false)
  creadoEn    DateTime @default(now())

  @@index([entidadTipo, entidadId])
  @@map("contactos")
}

// ---------------------------------------------------------------------------
// Multi-empresa (fundación): permite registrar más de una compañía real (ej.
// una subsidiaria en otro país), con una "compañía activa" por sesión (ver
// src/lib/empresas.ts).
//
// Estado al 2026-09-11 (ítem 0.2 del roadmap): los 76 modelos que llevan
// empresaId tienen ya relación física hacia Empresa, agregadas en diez
// migraciones aditivas documentadas en docs/integridad-fk-empresa-*.md. La
// base rechaza por FK cualquier fila que apunte a una compañía inexistente y
// ninguna compañía con datos puede borrarse (onDelete: Restrict). La suite
// audita el esquema para que un modelo nuevo con empresaId no pueda quedarse
// sin la relación.
//
// El filtro de aplicación también está cerrado: los 68 actions.ts resuelven
// la compañía activa antes de leer o escribir. La única excepción
// deliberada es configuracion/tareas-programadas, que dispara a mano las
// mismas tareas de mantenimiento que el servidor corre por temporizador y
// que operan sobre toda la base, no sobre una compañía.
// ---------------------------------------------------------------------------
model Empresa {
  id              String   @id @default(cuid())
  razonSocial     String
  ruc             String?
  pais            String   @default("Peru")
  monedaFuncional String   @default("PEN")
  // La compañía "1" (creada por asegurarEmpresaPrincipal()) es la que ya
  // tenían todos los registros existentes antes de este cambio — no se puede
  // desactivar porque toda la data histórica cuelga de ella.
  esPrincipal     Boolean  @default(false)
  activa          Boolean  @default(true)
  creadoEn        DateTime @default(now())

  cuentasBancarias           CuentaBancariaEmpresa[]
  usuarios                   Usuario[]
  auditoriasMaestro          AuditoriaMaestro[]
  categorias                 Categoria[]
  productos                  Producto[]
  presentaciones             Presentacion[]
  proveedores                Proveedor[]
  insumos                    Insumo[]
  movimientosCasco           MovimientoCasco[]
  movimientosKardex          MovimientoKardex[]
  conteosInventario          ConteoInventario[]
  formulas                   Formula[]
  lotesGranel                LoteGranel[]
  noConformidades            NoConformidadCalidad[]
  planesCalidad              PlanInspeccionCalidad[]
  causasCalidad              CausaCalidad[]
  reclamosCliente            ReclamoCliente[]
  envasados                  Envasado[]
  zonasComerciales           Zona[]
  vendedores                 Vendedor[]
  descuentosCanal            DescuentoCanal[]
  clientes                   Cliente[]
  cotizaciones               Cotizacion[]
  pedidos                    Pedido[]
  facturas                   Factura[]
  avisosCobranza             AvisoCobranza[]
  politicaCobranza           PoliticaCobranza?
  comprobantes               ComprobanteElectronico[]
  cobros                     Cobro[]
  notasCredito               NotaCredito[]
  notasDebito                NotaDebito[]
  solicitudesCambioCredito   SolicitudCambioCredito[]
  creditosCliente            CreditoCliente[]
  aplicacionesCreditoCliente AplicacionCreditoCliente[]
  reembolsosCliente          ReembolsoCliente[]
  devolucionesCliente        DevolucionCliente[]
  comisiones                 Comision[]
  acuerdosSuministro         AcuerdoSuministro[]
  rfqsCompra                 RfqCompra[]
  ordenesCompra              OrdenCompra[]
  nivelesAprobacionCompra    NivelAprobacionCompra[]
  recepcionesCompra          RecepcionCompra[]
  devolucionesCompra         DevolucionCompra[]
  creditosProveedor          CreditoProveedor[]
  aplicacionesCreditoProv    AplicacionCreditoProveedor[]
  reembolsosProveedor        ReembolsoProveedor[]
  planesInspeccionInsumo     PlanInspeccionInsumo[]
  guiasRemision              GuiaRemision[]
  cuentasPorPagar            CuentaPorPagar[]
  pagosProveedor             PagoProveedor[]
  movimientosCaja            MovimientoCaja[]
  conciliacionesBancarias    ConciliacionBancaria[]
  hojasRuta                  HojaRuta[]
  seriesDocumento            SerieDocumento[]
  almacenes                  Almacen[]
  clasesUnidadMedida         ClaseUnidadMedida[]
  gruposSeguridad            GrupoSeguridad[]
  periodosFiscales           PeriodoFiscal[]
  planesCuentas              PlanCuentas[]
  libros                     Libro[]
  asientosContables          AsientoContable[]
  controlesContables         ControlContable[]
  centrosCosto               CentroCosto[]
  ordenesInternas            OrdenInterna[]
  centrosCostoControl        CentroCostoControl[]
  activosFijos               ActivoFijo[]
  proyectos                  Proyecto[]
  centrosTrabajo             CentroTrabajo[]
  equipos                    Equipo[]
  ubicacionesTecnicas        UbicacionTecnica[]
  avisosMantenimiento        AvisoMantenimiento[]
  planesMantenimiento        PlanMantenimiento[]
  proyecciones               Proyeccion[]
  empleados                  Empleado[]
  posicionesOrganizativas    PosicionOrganizativa[]
  asignacionesPosicion       AsignacionPosicion[]
  turnosTrabajo              TurnoTrabajo[]
  registrosAsistencia        RegistroAsistencia[]
  parametrosPlanilla         ParametroPlanilla[]
  politicasTiempoTrabajo     PoliticaTiempoTrabajo[]
  planillaPeriodos           PlanillaPeriodo[]
  adjuntos                   Adjunto[]
  configuracion              ConfiguracionEmpresa?
  incidenciasContables       IncidenciaContable[]
  ordenesMantenimiento       OrdenMantenimiento[]

  @@map("empresas")
}
