// Prisma schema — ERP Grasas y Lubricantes
// Módulos: Catálogo, Inventario (kardex), Producción (2 etapas), Comercial, Usuarios
//
// Principios:
// - La historia nunca se edita ni se borra: kardex, facturas, cobros y comisiones
//   solo se compensan con movimientos/documentos nuevos (ajustes, notas de crédito).
// - Toda regularización guarda quién/cuándo/por qué (usuarioId, usuarioNombre, motivo).
// - Campos semilla para el futuro: empresaId, moneda, pais.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ---------------------------------------------------------------------------
// USUARIOS Y SESIONES
// ---------------------------------------------------------------------------

enum RolUsuario {
  ADMIN
  ALMACEN
  PRODUCCION
  VENTAS
}

model Usuario {
  id           String     @id @default(cuid())
  empresaId    String     @default("1")
  nombre       String
  usuario      String // nombre de acceso
  passwordHash String
  rol          RolUsuario
  activo       Boolean    @default(true)
  creadoEn     DateTime   @default(now())

  sesiones Sesion[]

  @@unique([empresaId, usuario])
  @@map("usuarios")
}

model Sesion {
  id        String   @id @default(cuid())
  token     String   @unique
  usuarioId String
  expiraEn  DateTime
  creadoEn  DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@map("sesiones")
}

// ---------------------------------------------------------------------------
// CATALOGO
// ---------------------------------------------------------------------------

model Categoria {
  id          String   @id @default(cuid())
  empresaId   String   @default("1")
  nombre      String
  descripcion String?
  activo      Boolean  @default(true)
  creadoEn    DateTime @default(now())

  productos Producto[]

  @@unique([empresaId, nombre])
  @@map("categorias")
}

model Producto {
  id               String   @id @default(cuid())
  empresaId        String   @default("1")
  categoriaId      String
  codigo           String
  nombre           String
  descripcion      String?
  unidadMedidaBase String   @default("kg") // UM en que se produce y controla el granel
  marca            String?
  gradoNlgi        String? // grasas: NLGI 000..6
  viscosidad       String? // aceites: ISO VG / SAE
  notasTecnicas    String?
  activo           Boolean  @default(true)
  creadoEn         DateTime @default(now())
  actualizadoEn    DateTime @updatedAt

  categoria      Categoria      @relation(fields: [categoriaId], references: [id])
  presentaciones Presentacion[]
  formulas       Formula[]

  @@unique([empresaId, codigo])
  @@map("productos")
}

model Presentacion {
  id            String   @id @default(cuid())
  empresaId     String   @default("1")
  productoId    String
  sku           String
  nombre        String
  contenidoKg     Decimal
  precio          Decimal
  moneda          String   @default("PEN")
  stock           Decimal  @default(0)
  stockMinimo     Decimal  @default(0)
  costoPromedio   Decimal  @default(0) // costo unitario promedio ponderado (se actualiza al envasar)
  codigoBarras    String? // EAN-13
  pesoBrutoKg     Decimal? // contenido + envase
  unidadesPorCaja Int?
  ubicacion       String? // ubicación en almacén (zona-rack-nivel)
  activo          Boolean  @default(true)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  producto       Producto           @relation(fields: [productoId], references: [id])
  movimientos    MovimientoKardex[]
  envasados      Envasado[]
  pedidoDetalles PedidoDetalle[]
  guiaDetalles   GuiaRemisionDetalle[]

  @@unique([empresaId, sku])
  @@map("presentaciones")
}

model Proveedor {
  id                String   @id @default(cuid())
  empresaId         String   @default("1")
  razonSocial       String
  ruc               String?
  pais              String   @default("Peru")
  telefono          String?
  email             String?
  direccion         String?
  contactoNombre    String?
  contactoTelefono  String?
  cuentaBancaria    String? // banco y n° de cuenta / CCI para pagos
  condicionPagoDias Int      @default(0) // 0 = contado
  notas             String?
  activo            Boolean  @default(true)
  creadoEn          DateTime @default(now())

  insumos        Insumo[]
  ordenesCompra  OrdenCompra[]
  cuentasPorPagar CuentaPorPagar[]

  @@unique([empresaId, ruc])
  @@map("proveedores")
}

enum TipoInsumo {
  MATERIA_PRIMA
  ENVASE
  ETIQUETA
}

model Insumo {
  id            String     @id @default(cuid())
  empresaId     String     @default("1")
  proveedorId   String?
  codigo        String
  nombre        String
  tipo            TipoInsumo
  unidadMedida    String
  stock           Decimal    @default(0)
  stockMinimo     Decimal    @default(0)
  costoUnitario   Decimal    @default(0)
  moneda          String     @default("PEN")
  codigoProveedor String? // código del artículo en el catálogo del proveedor
  ubicacion       String?
  notas           String?
  activo          Boolean    @default(true)
  creadoEn      DateTime   @default(now())
  actualizadoEn DateTime   @updatedAt

  proveedor       Proveedor?         @relation(fields: [proveedorId], references: [id])
  movimientos     MovimientoKardex[]
  formulaDetalles FormulaDetalle[]
  envasadoInsumos EnvasadoInsumo[]
  ordenCompraDetalles OrdenCompraDetalle[]
  recepcionDetalles   RecepcionCompraDetalle[]

  @@unique([empresaId, codigo])
  @@map("insumos")
}

// ---------------------------------------------------------------------------
// INVENTARIO — KARDEX (inmutable: nunca se edita ni borra, solo se compensa)
// ---------------------------------------------------------------------------

enum TipoItemKardex {
  PRESENTACION
  INSUMO
}

enum TipoMovimiento {
  ENTRADA
  SALIDA
}

enum OrigenMovimiento {
  STOCK_INICIAL
  COMPRA
  PRODUCCION // consumo de insumos por lote granel
  ENVASADO // consumo de envases/etiquetas y entrada de presentaciones
  VENTA
  ANULACION_VENTA
  AJUSTE // regularización manual: motivo obligatorio
}

model MovimientoKardex {
  id             String           @id @default(cuid())
  empresaId      String           @default("1")
  fecha          DateTime         @default(now())
  tipoItem       TipoItemKardex
  presentacionId String?
  insumoId       String?
  tipoMovimiento TipoMovimiento
  origen         OrigenMovimiento
  cantidad       Decimal // siempre positiva; el signo lo da tipoMovimiento
  saldoAnterior  Decimal
  saldoNuevo     Decimal
  motivo         String? // obligatorio cuando origen = AJUSTE
  referencia     String? // código de lote, envasado, factura, etc.
  usuarioId      String
  usuarioNombre  String
  creadoEn       DateTime         @default(now())

  presentacion Presentacion? @relation(fields: [presentacionId], references: [id])
  insumo       Insumo?       @relation(fields: [insumoId], references: [id])

  @@index([tipoItem, presentacionId, insumoId])
  @@map("movimientos_kardex")
}

// ---------------------------------------------------------------------------
// PRODUCCION — ETAPA 1: FORMULAS (versionadas) Y LOTES GRANEL
// ---------------------------------------------------------------------------

model Formula {
  id            String   @id @default(cuid())
  empresaId     String   @default("1")
  productoId    String
  version       Int
  rendimientoKg Decimal // kg de granel que produce un batch con las cantidades del detalle
  notas         String?
  activo        Boolean  @default(true)
  usuarioId     String
  usuarioNombre String
  creadoEn      DateTime @default(now())

  producto Producto         @relation(fields: [productoId], references: [id])
  detalles FormulaDetalle[]
  lotes    LoteGranel[]

  @@unique([productoId, version])
  @@map("formulas")
}

model FormulaDetalle {
  id        String  @id @default(cuid())
  formulaId String
  insumoId  String
  cantidad  Decimal // cantidad del insumo (en su unidad) para producir rendimientoKg

  formula Formula @relation(fields: [formulaId], references: [id])
  insumo  Insumo  @relation(fields: [insumoId], references: [id])

  @@map("formula_detalles")
}

enum EstadoLote {
  EN_PROCESO
  PENDIENTE_CALIDAD
  APROBADO
  RECHAZADO
}

model LoteGranel {
  id            String     @id @default(cuid())
  empresaId     String     @default("1")
  codigo        String     @unique // LG-00001
  formulaId     String
  kgObjetivo    Decimal
  kgProducidos  Decimal    @default(0)
  mermaKg       Decimal    @default(0)
  kgDisponibles Decimal    @default(0) // granel aprobado aún no envasado
  costoInsumos  Decimal    @default(0) // costo total de insumos consumidos al crear el lote
  costoKg       Decimal    @default(0) // costoInsumos / kgProducidos (al finalizar)
  estado        EstadoLote @default(EN_PROCESO)
  observaciones String?
  fechaInicio   DateTime   @default(now())
  fechaFin      DateTime?
  usuarioId     String
  usuarioNombre String

  formula        Formula         @relation(fields: [formulaId], references: [id])
  controlCalidad ControlCalidad?
  envasados      Envasado[]

  @@map("lotes_granel")
}

enum ResultadoCalidad {
  APROBADO
  RECHAZADO
}

model ControlCalidad {
  id            String           @id @default(cuid())
  loteGranelId  String           @unique
  resultado     ResultadoCalidad
  observaciones String?
  fecha         DateTime         @default(now())
  usuarioId     String
  usuarioNombre String

  loteGranel LoteGranel @relation(fields: [loteGranelId], references: [id])

  @@map("controles_calidad")
}

// ---------------------------------------------------------------------------
// PRODUCCION — ETAPA 2: ENVASADO (granel + envases/etiquetas -> presentaciones)
// ---------------------------------------------------------------------------

model Envasado {
  id             String   @id @default(cuid())
  empresaId      String   @default("1")
  codigo         String   @unique // ENV-00001
  loteGranelId   String
  presentacionId String
  unidades       Int
  kgConsumidos   Decimal // unidades * contenidoKg de la presentación
  costoTotal     Decimal  @default(0) // granel consumido + envases/etiquetas
  costoUnitario  Decimal  @default(0) // costoTotal / unidades
  fecha          DateTime @default(now())
  usuarioId      String
  usuarioNombre  String

  loteGranel   LoteGranel       @relation(fields: [loteGranelId], references: [id])
  presentacion Presentacion     @relation(fields: [presentacionId], references: [id])
  insumos      EnvasadoInsumo[]

  @@map("envasados")
}

model EnvasadoInsumo {
  id         String  @id @default(cuid())
  envasadoId String
  insumoId   String
  cantidad   Decimal

  envasado Envasado @relation(fields: [envasadoId], references: [id])
  insumo   Insumo   @relation(fields: [insumoId], references: [id])

  @@map("envasado_insumos")
}

// ---------------------------------------------------------------------------
// COMERCIAL
// ---------------------------------------------------------------------------

model Zona {
  id        String   @id @default(cuid())
  empresaId String   @default("1")
  nombre    String
  activo    Boolean  @default(true)
  creadoEn  DateTime @default(now())

  vendedores Vendedor[]
  clientes   Cliente[]

  @@unique([empresaId, nombre])
  @@map("zonas")
}

enum TipoVendedor {
  CON_BASICO
  SOLO_COMISION
}

model Vendedor {
  id           String       @id @default(cuid())
  empresaId    String       @default("1")
  nombre       String
  documento    String?
  telefono     String?
  email        String?
  tipo         TipoVendedor
  tasaComision Decimal // porcentaje individual, ej. 3.5
  zonaId       String?
  activo       Boolean      @default(true)
  creadoEn     DateTime     @default(now())

  zona              Zona?      @relation(fields: [zonaId], references: [id])
  pedidos           Pedido[]
  facturas          Factura[]
  comisiones        Comision[]
  hojasRuta         HojaRuta[]
  clientesAsignados Cliente[]  @relation("ClienteVendedor")

  @@map("vendedores")
}

model Cliente {
  id                   String        @id @default(cuid())
  empresaId            String        @default("1")
  razonSocial          String
  nombreComercial      String?
  ruc                  String?
  pais                 String        @default("Peru")
  departamento         String?
  provincia            String?
  distrito             String?
  direccion            String?
  telefono             String?
  email                String?
  contactoNombre       String?
  contactoTelefono     String?
  zonaId               String?
  vendedorId           String? // vendedor asignado (se preselecciona en pedidos)
  limiteCredito        Decimal       @default(0) // 0 = sin límite; se valida al facturar
  condicionPagoDefecto CondicionPago @default(CONTADO)
  notas                String?
  activo               Boolean       @default(true)
  creadoEn             DateTime      @default(now())

  zona             Zona?            @relation(fields: [zonaId], references: [id])
  vendedorAsignado Vendedor?        @relation("ClienteVendedor", fields: [vendedorId], references: [id])
  pedidos          Pedido[]
  facturas         Factura[]
  guias            GuiaRemision[]
  visitas          HojaRutaVisita[]

  @@unique([empresaId, ruc])
  @@map("clientes")
}

enum EstadoPedido {
  PENDIENTE
  FACTURADO
  ANULADO
}

model Pedido {
  id            String       @id @default(cuid())
  empresaId     String       @default("1")
  numero        String       @unique // PED-00001
  clienteId     String
  vendedorId    String
  fecha         DateTime     @default(now())
  estado        EstadoPedido @default(PENDIENTE)
  total         Decimal
  notas         String?
  usuarioId     String
  usuarioNombre String

  cliente  Cliente         @relation(fields: [clienteId], references: [id])
  vendedor Vendedor        @relation(fields: [vendedorId], references: [id])
  detalles PedidoDetalle[]
  factura  Factura?

  @@map("pedidos")
}

model PedidoDetalle {
  id             String  @id @default(cuid())
  pedidoId       String
  presentacionId String
  cantidad       Int
  precioUnitario Decimal
  subtotal       Decimal
  costoUnitario  Decimal @default(0) // snapshot del costo promedio al facturar (para costo de ventas)

  pedido       Pedido       @relation(fields: [pedidoId], references: [id])
  presentacion Presentacion @relation(fields: [presentacionId], references: [id])

  @@map("pedido_detalles")
}

enum CondicionPago {
  CONTADO
  DIAS_15
  DIAS_30
}

enum EstadoFactura {
  PENDIENTE
  PAGADA
  ANULADA
}

// La factura se emite en el portal SUNAT; aquí solo se registra su número.
model Factura {
  id               String        @id @default(cuid())
  empresaId        String        @default("1")
  numero           String        @unique // número SUNAT, ej. F001-00000123
  pedidoId         String        @unique
  clienteId        String
  vendedorId       String
  moneda           String        @default("PEN")
  condicionPago    CondicionPago
  fechaEmision     DateTime      @default(now())
  fechaVencimiento DateTime
  total            Decimal
  saldo            Decimal
  estado           EstadoFactura @default(PENDIENTE)
  motivoAnulacion  String?
  anuladaEn        DateTime?
  anuladaPor       String?
  usuarioId        String
  usuarioNombre    String

  pedido       Pedido        @relation(fields: [pedidoId], references: [id])
  cliente      Cliente       @relation(fields: [clienteId], references: [id])
  vendedor     Vendedor      @relation(fields: [vendedorId], references: [id])
  cobros       Cobro[]
  notasCredito NotaCredito[]
  comisiones   Comision[]
  guias        GuiaRemision[]

  @@map("facturas")
}

enum MedioPago {
  EFECTIVO
  TRANSFERENCIA
  DEPOSITO
  YAPE
  PLIN
  OTRO
}

model Cobro {
  id            String    @id @default(cuid())
  empresaId     String    @default("1")
  facturaId     String
  fecha         DateTime  @default(now())
  monto         Decimal
  medioPago     MedioPago
  referencia    String?
  usuarioId     String
  usuarioNombre String

  factura Factura @relation(fields: [facturaId], references: [id])

  @@map("cobros")
}

model NotaCredito {
  id            String   @id @default(cuid())
  empresaId     String   @default("1")
  numero        String   @unique // número SUNAT de la NC
  facturaId     String
  fecha         DateTime @default(now())
  monto         Decimal
  motivo        String
  usuarioId     String
  usuarioNombre String

  factura Factura @relation(fields: [facturaId], references: [id])

  @@map("notas_credito")
}

enum TipoComision {
  GENERADA // nace con la factura
  REVERSION // compensación por anulación o nota de crédito (monto negativo)
}

enum EstadoComision {
  PENDIENTE
  PAGADA
}

model Comision {
  id         String         @id @default(cuid())
  empresaId  String         @default("1")
  vendedorId String
  facturaId  String
  tipo       TipoComision
  tasa       Decimal
  monto      Decimal // negativo cuando tipo = REVERSION
  estado     EstadoComision @default(PENDIENTE)
  motivo     String?
  creadoEn   DateTime       @default(now())

  vendedor Vendedor @relation(fields: [vendedorId], references: [id])
  factura  Factura  @relation(fields: [facturaId], references: [id])

  @@map("comisiones")
}

// ---------------------------------------------------------------------------
// LOGISTICA — COMPRAS (órdenes de compra y recepciones)
// ---------------------------------------------------------------------------

enum EstadoOrdenCompra {
  PENDIENTE
  PARCIAL
  RECIBIDA
  ANULADA
}

model OrdenCompra {
  id            String            @id @default(cuid())
  empresaId     String            @default("1")
  numero        String            @unique // OC-00001
  proveedorId   String
  fecha         DateTime          @default(now())
  estado        EstadoOrdenCompra @default(PENDIENTE)
  moneda        String            @default("PEN")
  total         Decimal
  notas         String?
  motivoAnulacion String?
  usuarioId     String
  usuarioNombre String

  proveedor   Proveedor            @relation(fields: [proveedorId], references: [id])
  detalles    OrdenCompraDetalle[]
  recepciones RecepcionCompra[]
  cuentasPorPagar CuentaPorPagar[]

  @@map("ordenes_compra")
}

model OrdenCompraDetalle {
  id               String  @id @default(cuid())
  ordenCompraId    String
  insumoId         String
  cantidad         Decimal
  costoUnitario    Decimal
  subtotal         Decimal
  cantidadRecibida Decimal @default(0)

  ordenCompra OrdenCompra @relation(fields: [ordenCompraId], references: [id])
  insumo      Insumo      @relation(fields: [insumoId], references: [id])

  @@map("orden_compra_detalles")
}

model RecepcionCompra {
  id            String   @id @default(cuid())
  empresaId     String   @default("1")
  numero        String   @unique // RC-00001
  ordenCompraId String
  fecha         DateTime @default(now())
  notas         String?
  usuarioId     String
  usuarioNombre String

  ordenCompra OrdenCompra              @relation(fields: [ordenCompraId], references: [id])
  detalles    RecepcionCompraDetalle[]

  @@map("recepciones_compra")
}

model RecepcionCompraDetalle {
  id            String  @id @default(cuid())
  recepcionId   String
  insumoId      String
  cantidad      Decimal
  costoUnitario Decimal // costo real de esta recepción (actualiza el promedio ponderado)

  recepcion RecepcionCompra @relation(fields: [recepcionId], references: [id])
  insumo    Insumo          @relation(fields: [insumoId], references: [id])

  @@map("recepcion_compra_detalles")
}

// ---------------------------------------------------------------------------
// LOGISTICA — GUIAS DE REMISION (traslado de mercadería, formato SUNAT)
// ---------------------------------------------------------------------------

model GuiaRemision {
  id             String   @id @default(cuid())
  empresaId      String   @default("1")
  numero         String   @unique // ej. T001-00000001
  facturaId      String?
  clienteId      String
  fechaTraslado  DateTime
  puntoPartida   String
  puntoLlegada   String
  motivoTraslado String   @default("Venta")
  transportista  String?
  placaVehiculo  String?
  dniConductor   String?
  observaciones  String?
  usuarioId      String
  usuarioNombre  String
  creadoEn       DateTime @default(now())

  factura  Factura?              @relation(fields: [facturaId], references: [id])
  cliente  Cliente               @relation(fields: [clienteId], references: [id])
  detalles GuiaRemisionDetalle[]

  @@map("guias_remision")
}

model GuiaRemisionDetalle {
  id             String  @id @default(cuid())
  guiaId         String
  presentacionId String
  cantidad       Int

  guia         GuiaRemision @relation(fields: [guiaId], references: [id])
  presentacion Presentacion @relation(fields: [presentacionId], references: [id])

  @@map("guia_remision_detalles")
}

// ---------------------------------------------------------------------------
// FINANZAS — CUENTAS POR PAGAR Y CAJA
// ---------------------------------------------------------------------------

enum EstadoCuentaPorPagar {
  PENDIENTE
  PAGADA
}

model CuentaPorPagar {
  id              String               @id @default(cuid())
  empresaId       String               @default("1")
  proveedorId     String
  ordenCompraId   String?
  numeroDocumento String // factura del proveedor
  fechaEmision    DateTime             @default(now())
  fechaVencimiento DateTime?
  moneda          String               @default("PEN")
  total           Decimal
  saldo           Decimal
  estado          EstadoCuentaPorPagar @default(PENDIENTE)
  usuarioId       String
  usuarioNombre   String

  proveedor   Proveedor       @relation(fields: [proveedorId], references: [id])
  ordenCompra OrdenCompra?    @relation(fields: [ordenCompraId], references: [id])
  pagos       PagoProveedor[]

  @@map("cuentas_por_pagar")
}

model PagoProveedor {
  id               String    @id @default(cuid())
  empresaId        String    @default("1")
  cuentaPorPagarId String
  fecha            DateTime  @default(now())
  monto            Decimal
  medioPago        MedioPago
  referencia       String?
  usuarioId        String
  usuarioNombre    String

  cuentaPorPagar CuentaPorPagar @relation(fields: [cuentaPorPagarId], references: [id])

  @@map("pagos_proveedor")
}

enum TipoMovimientoCaja {
  INGRESO
  EGRESO
}

// Libro de caja: los cobros de facturas y pagos a proveedores generan
// movimientos automáticos; también admite movimientos manuales con concepto.
model MovimientoCaja {
  id            String             @id @default(cuid())
  empresaId     String             @default("1")
  fecha         DateTime           @default(now())
  tipo          TipoMovimientoCaja
  concepto      String
  monto         Decimal
  medioPago     MedioPago
  referencia    String? // nro de factura, OC, comisión, etc.
  usuarioId     String
  usuarioNombre String

  @@map("movimientos_caja")
}

// ---------------------------------------------------------------------------
// COMERCIAL — HOJAS DE RUTA DE VENDEDORES
// ---------------------------------------------------------------------------

enum EstadoHojaRuta {
  PLANIFICADA
  COMPLETADA
}

model HojaRuta {
  id            String         @id @default(cuid())
  empresaId     String         @default("1")
  numero        String         @unique // HR-00001
  vendedorId    String
  fecha         DateTime
  estado        EstadoHojaRuta @default(PLANIFICADA)
  notas         String?
  usuarioId     String
  usuarioNombre String
  creadoEn      DateTime       @default(now())

  vendedor Vendedor         @relation(fields: [vendedorId], references: [id])
  visitas  HojaRutaVisita[]

  @@map("hojas_ruta")
}

model HojaRutaVisita {
  id         String  @id @default(cuid())
  hojaRutaId String
  clienteId  String
  orden      Int
  objetivo   String? // cobrar, ofrecer producto nuevo, etc.
  resultado  String? // se llena al cerrar la ruta

  hojaRuta HojaRuta @relation(fields: [hojaRutaId], references: [id])
  cliente  Cliente  @relation(fields: [clienteId], references: [id])

  @@map("hoja_ruta_visitas")
}
